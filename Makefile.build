# Makefile.build - Single stage build
# Usage: make -f Makefile.build GENERATOR=<path> BUILD_DIR=<path> GEN_FLAGS=<flags> TARGET=<target>
# A test runner is the same build with --test in GEN_FLAGS.

SRC_DIR := $(BUILD_DIR)/src
OBJ_DIR := $(BUILD_DIR)/obj
SRCS_LST := $(BUILD_DIR)/sources.lst
OBJS_LST := $(BUILD_DIR)/objects.lst

ifeq ($(OS),Windows_NT)
	EXE := .exe
	CC := clang
	CXX := clang++
else ifeq ($(shell uname -s),Darwin)
	EXE :=
	CC := clang
	CXX := clang++
else
	EXE :=
	CC := clang-20
	CXX := clang++-20
endif

# OBJS_OF: the objects for a list of generated sources.
OBJS_OF = $(sort $(patsubst $(SRC_DIR)/%.c,$(OBJ_DIR)/%.o,$(filter %.c,$(1))) \
          $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(filter %.cpp,$(1))))

ifneq ($(wildcard $(SRCS_LST)),)
    OBJS := $(call OBJS_OF,$(shell cat $(SRCS_LST)))
endif

FLAGS_STAMP := $(BUILD_DIR)/build-flags.txt

.PHONY: all build-objs generate check-flags
.DEFAULT_GOAL := all

check-flags:
	@mkdir -p $(BUILD_DIR)
	@if [ ! -f "$(FLAGS_STAMP)" ] || [ "`cat "$(FLAGS_STAMP)"`" != "$(CFLAGS) | $(LDFLAGS)" ]; then \
		if [ -d "$(OBJ_DIR)" ]; then echo "Build flags changed, rebuilding objects..."; fi; \
		rm -rf "$(OBJ_DIR)"; \
		printf '%s' "$(CFLAGS) | $(LDFLAGS)" > "$(FLAGS_STAMP)"; \
	fi

all: check-flags generate
	@echo "Compiling generated files..."
	$(eval CURRENT_OBJS := $(call OBJS_OF,$(shell cat $(SRCS_LST))))

	@$(MAKE) -f Makefile.build build-objs

	@echo "Linking..."
	$(file >$(OBJS_LST))
	$(foreach obj,$(CURRENT_OBJS),$(file >>$(OBJS_LST),$(obj)))
	$(CC) @$(OBJS_LST) $(LDFLAGS) -o $(TARGET)
	@echo "Build complete: $(TARGET)"

generate:
	@echo "Generating C files..."
	@mkdir -p $(SRC_DIR)
	$(GENERATOR) -o $(SRC_DIR) $(GEN_FLAGS) > $(SRCS_LST)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(SRC_DIR) -MMD -MP -c $< -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -MMD -MP -c $< -o $@

build-objs: $(OBJS)

-include $(shell find $(OBJ_DIR) -name '*.d' 2>/dev/null)
