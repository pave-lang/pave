#include "stdlib.h"

use std
use analyzer
use types
use c

struct Expression {
    token: &Token,
    data: ExpressionData,
    return_type: Type,
}

impl Expression {
    fn make(allocator: &ArenaAllocator, token: &Token, data: ExpressionData, return_type: &Type) -> &Expression {
        return allocator.store(&Expression {
            token,
            data,
            return_type: *return_type
        });
    }

    fn get_token_bounds(&self) -> TokenBounds {
        match self.data {
            ExpressionData::BinaryExpression(lhs, _, rhs) => {
                let lhs_bounds = lhs.get_token_bounds();
                let rhs_bounds = rhs.get_token_bounds();
                return TokenBounds::new(lhs_bounds.first, rhs_bounds.last);
            },
            ExpressionData::UnaryExpression(_, inner) => {
                let inner_bounds = inner.get_token_bounds();
                return TokenBounds::new(self.token, inner_bounds.last);
            },
            ExpressionData::IfExpression(_, _, otherwise) => {
                let otherwise_bounds = otherwise.get_token_bounds();
                return TokenBounds::new(self.token, otherwise_bounds.last);
            },
            ExpressionData::OptionalExpression(inner, value) => {
                let inner_bounds = inner.get_token_bounds();
                let value_bounds = value.get_token_bounds();
                return TokenBounds::new(inner_bounds.first, value_bounds.last);
            },
            ExpressionData::MemberStaticExpression(inner, _) => {
                let inner_bounds = inner.get_token_bounds();
                return TokenBounds::new(inner_bounds.first, self.token);
            },
            ExpressionData::MemberInstanceExpression(inner, _) => {
                let inner_bounds = inner.get_token_bounds();
                return TokenBounds::new(inner_bounds.first, self.token);
            },
            ExpressionData::IndexExpression(inner, index) => {
                let inner_bounds = inner.get_token_bounds();
                let index_bounds = index.get_token_bounds();
                return TokenBounds::new(inner_bounds.first, index_bounds.last);
            },
            ExpressionData::ParenthesizedExpression(inner) => {
                let inner_bounds = inner.get_token_bounds();
                return TokenBounds::new(self.token, inner_bounds.last);
            },
            ExpressionData::CppExpression(cpp) => {
                match cpp {
                    CppExpression::New { placement, expression: new_expression } => {
                        let expression_bounds = new_expression.get_token_bounds();
                        let last = expression_bounds.last;
                        if placement != null {
                            last = expression_bounds.last;
                        }
                        return TokenBounds::new(self.token, last);
                    },
                    CppExpression::Delete(delete_expression) => {
                        let expression_bounds = delete_expression.get_token_bounds();
                        return TokenBounds::new(self.token, expression_bounds.last);
                    },
                }
            },
            ExpressionData::ImplicitCast(inner) => {
                return inner.get_token_bounds();
            },
            ExpressionData::Invoke(target, arguments) => {
                let bounds = target.get_token_bounds();
                for argument in arguments {
                    let argument_bounds = argument.value.get_token_bounds();
                    bounds.include(argument_bounds);
                }
                return bounds;
            },
            _ => {},
        }

        return TokenBounds::new(self.token, self.token);
    }

    fn make_next(context: &Context, node: Expression) -> *Expression {
        let result = context.allocator.store(&node);

        context.next_token();

        return result;
    }

    fn number_primitive(value: str) -> str {
        if value.ends_with("f") || value.ends_with("F") {
            return "f32";
        } else if value.ends_with("u") || value.ends_with("U") {
            return "u32";
        } else if value.contains(".") {
            return "f64";
        }
        return "i32";
    }

    fn parse_primary(context: &Context, generics: &Generics) -> *Expression {
        let token = context.current();
        if token == null {
            context.error("Unexpected end of input");
            return null;
        }

        let token_type = token.type;
        let result: *Expression = null;

        match token_type {
            TokenType::Identifier => {
                let return_type = context.get_value(token.value);

                if context.module.mode_cpp && (token.value.eq("new") || token.value.eq("delete")) {
                    return Expression::parse_cpp(context, generics);
                } else if return_type == null {
                    let type = context.parse_type2(generics);
                    if type != null {
                        // Record type reference for go-to-definition
                        if context.should_record_symbols() {
                            let type_def_token: *Token = null;
                            let type_def_path = context.path;
                            match type.resolve_typedef() {
                                Type::Struct(struct_info, _) => { type_def_token = struct_info.name; type_def_path = struct_info.module.path; },
                                Type::Enum(enum_info, _) => { type_def_token = enum_info.name; type_def_path = enum_info.context.path; },
                                Type::Trait(trait_info, _) => { type_def_token = trait_info.name; type_def_path = trait_info.module.path; },
                                _ => {},
                            }
                            if type_def_token != null {
                                let type_label_str = context.root.naming_decl.get_type_decl(type, context.type_self, null);
                                context.record_symbol(token, type_label_str.as_str(), type_def_path, type_def_token);
                            }
                        }

                        match type.resolve_typedef() {
                            Type::Enum(_, _) => { result = Expression::parse_enum(context, token, type, generics); },
                            Type::EnumC(_) => { result = Expression::parse_enum(context, token, type, generics); },
                            Type::Self => { result = Expression::parse_struct(context, token, type, generics); },
                            Type::Struct(_, _) => { result = Expression::parse_struct(context, token, type, generics); },
                            Type::StructC(_) => { result = Expression::parse_struct(context, token, type, generics); },
                            Type::UnionC(_) => { result = Expression::parse_struct(context, token, type, generics); },
                            Type::ClassCpp(_) => { result = Expression::parse_class(context, token, Expression::make(context.allocator, token, ExpressionData::Type(type), type), generics); },
                            Type::NamespaceCpp(_) => { result = Expression::make(context.allocator, token, ExpressionData::Type(type), type); },
                            _ => { result = Expression::make(context.allocator, token, ExpressionData::Type(type), type); },
                        }
                    } else if generics.has(token.value) {
                        let generic = generics.find(token.value);
                        result = Expression::make_next(context, Expression {
                            token,
                            return_type: Type::Generic(generic),
                            data: ExpressionData::Variable(str { ptr: null, length: 0 }),
                        });

                        if result == null { return null; }
                        result.data = ExpressionData::Type(&result.return_type);
                    } else {
                        context.error_token(token, "Unable to find variable or type with this name");
                        return null;
                    }
                } else {
                    // Record symbol info for go-to-definition and hover
                    if context.should_record_symbols() {
                        let type_label = context.root.naming_decl.get_type_decl(return_type, context.type_self, null);
                        let def_token = context.get_definition_token(token.value);
                        let def_path = context.path;
                        if def_token == null {
                            // Check if it's a function — use func_info.name
                            match return_type {
                                Type::Function(func_info, _) => {
                                    def_token = func_info.name;
                                    if func_info.context != null { def_path = func_info.context.path; }
                                },
                                Type::Global(global_info) => {
                                    def_token = global_info.name;
                                    def_path = global_info.module.path;
                                },
                                _ => {},
                            }
                        }
                        context.record_symbol(token, type_label.as_str(), def_path, def_token);
                    }

                    match return_type {
                        Type::Function(func_info, _) => {
                            context.next_token();
                            let func_type = return_type;
                            let parsed_generics = Array<Type> { allocator: context.allocator, data: null, length: 0, capacity: 0 };

                            if context.check_value(TokenType::Symbol, "<") {
                                parsed_generics = context.parse_generics(generics);
                            }

                            let parsed = Expression::parse_call_arguments(context, generics);
                            if parsed == null { return null; }
                            let arguments = parsed.arguments;

                            if func_info.generics.array.length > 0 {
                                let func_generics = Expression::resolve_function_generics(context, func_info, &parsed_generics, &arguments);
                                func_type = context.root.make_type_usage(func_type, &func_generics.array);
                            }

                            if parsed.open_paren != null && parsed.close_paren != null {
                                Expression::record_function_signature(context, func_type, parsed.open_paren, parsed.close_paren, parsed.comma_positions, false);
                            }

                            if !Expression::validate_arguments(context, token, func_type, &arguments, null, false) { return null; }

                            let func_return_type: *Type = null;
                            match func_type {
                                Type::Function(_, func_generic_map) => {
                                    match func_info.type {
                                        FunctionType::Coroutine => {
                                            func_return_type = context.allocator.store(&Type::CoroutineInstance(func_info, func_generic_map));
                                        },
                                        _ => {
                                            func_return_type = Context::resolve_type(context.allocator, &func_info.return_type, func_generic_map, null);
                                        },
                                    }
                                },
                                _ => {},
                            }

                            let func_expr = Expression::make(context.allocator, token, ExpressionData::Type(func_type), func_type);
                            result = Expression::make(context.allocator, token, ExpressionData::Invoke(func_expr, arguments), func_return_type);
                        },
                        Type::CoroutineInstance(_, _) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Indirect(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Sequence(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Tuple(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Primitive(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Enum(_, _) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Struct(_, _) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Generic(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::UnknownC(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Self => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::TypedefC(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::StructC(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::UnionC(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::ClassCpp(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::Global(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::EnumC(_) => {
                            context.next_token();
                            result = Expression::make(context.allocator, token, ExpressionData::Variable(token.value), return_type);
                        },
                        Type::FunctionC(func_info) => {
                            context.next_token();
                            let parsed = Expression::parse_call_arguments(context, generics);
                            if parsed == null { return null; }

                            let func_expr = Expression::make(context.allocator, token, ExpressionData::Type(return_type), return_type);

                            result = Expression::make(context.allocator, token, ExpressionData::Invoke(func_expr, parsed.arguments), &func_info.return_type);
                        },
                        _ => {
                            context.error("Expression::parse issue");
                        },
                    }
                }
            },
            TokenType::String => {
                let return_type = if token.value.starts_with("'") { context.type_char } else { Type::Indirect(&context.pointer_const_char) };

                result = Expression::make_next(context, Expression {
                    token,
                    data: ExpressionData::Literal(token.value),
                    return_type,
                });
            },
            TokenType::Number => {
                let primitive = Expression::number_primitive(token.value);
                result = Expression::make_next(context, Expression {
                    token,
                    data: ExpressionData::Literal(token.value),
                    return_type: Type::Primitive(context.module.find_primitive(primitive)),
                });
            },
            TokenType::Symbol => {
                if token.eq(TokenType::Symbol, "-") || token.eq(TokenType::Symbol, "+") || token.eq(TokenType::Symbol, "!") || token.eq(TokenType::Symbol, "&") || token.eq(TokenType::Symbol, "*") || token.eq(TokenType::Symbol, "/") || token.eq(TokenType::Symbol, "%") || token.eq(TokenType::Symbol, "~") {
                    let operator = context.expect(TokenType::Symbol);
                    if operator == null { return null; }

                    if operator.value.eq("*") && context.check_value(TokenType::Keyword, "const") {
                        context.pos -= 1;
                        let new_type = context.parse_type2(generics);
                        result = Expression::make(context.allocator, token, ExpressionData::Type(new_type), new_type);
                    } else {
                        let child = Expression::parse_primary(context, generics);
                        if child == null { return null; }

                        if operator.value.eq("&") {
                            match child.data {
                                ExpressionData::Type(type) => {
                                    let new_type = context.allocator.store(&Type::Indirect(Indirect::new_reference(context.allocator, *type)));
                                    result = Expression::make(context.allocator, token, ExpressionData::Type(new_type), new_type);
                                },
                                _ => {
                                    let return_type = Type::Indirect(Indirect::new_reference(context.allocator, child.return_type));
                                    result = Expression::make(context.allocator, token, ExpressionData::UnaryExpression(operator.value, child), &return_type);
                                },
                            }
                        } else if operator.value.eq("*") {
                            match child.data {
                                ExpressionData::Type(type) => {
                                    let new_indirect = Indirect::new_pointer(context.allocator, *type);
                                    let new_type = context.allocator.store(&Type::Indirect(new_indirect));
                                    result = Expression::make(context.allocator, token, ExpressionData::Type(new_type), new_type);
                                },
                                _ => {
                                    let deref_target = child.return_type.resolve_typedef();
                                    if !deref_target.is_indirect() && !deref_target.is_unknown() {
                                        context.error_token(token, "Cannot dereference a non-reference or non-pointer type");
                                        return null;
                                    }
                                    result = Expression::make(context.allocator, token, ExpressionData::UnaryExpression(operator.value, child), child.return_type.deref());
                                },
                            }
                        } else {
                            if operator.value.eq("-") {
                                let trait_result = Expression::find_unary_trait_call(context, operator, child);
                                if trait_result != null {
                                    result = trait_result;
                                } else {
                                    result = Expression::make(context.allocator, token, ExpressionData::UnaryExpression(operator.value, child), &child.return_type);
                                }
                            } else {
                                result = Expression::make(context.allocator, token, ExpressionData::UnaryExpression(operator.value, child), &child.return_type);
                            }
                        }
                    }
                } else if token.eq(TokenType::Symbol, "(") {
                    if !context.expect_value(TokenType::Symbol, "(") { return null; }

                    let expr = Expression::parse(context, generics);
                    if expr == null { return null; }

                    if context.check_next(TokenType::Symbol, ",") {
                        let arguments = Array<InvokeArgument>::new(context.allocator);

                        let name = context.allocator.store(expr.token);
                        if name == null {
                            context.error("Failed to allocate token for tuple argument name");
                            return null;
                        }

                        name.value = "_0";

                        arguments.append(InvokeArgument { name, value: expr });

                        while !context.check_next(TokenType::Symbol, ")") {
                            let name_string = String::new(context.allocator);
                            name_string.append("_");
                            name_string.append_usize(arguments.length);

                            let name = context.allocator.store(context.current());
                            if name == null {
                                context.error("Failed to allocate token for tuple argument name");
                                return null;
                            }
                            name.value = name_string.as_str();

                            let value = Expression::parse(context, generics);
                            if value == null { return null; }

                            arguments.append(InvokeArgument { name, value });

                            if !context.check_next(TokenType::Symbol, ",") && !context.check_value(TokenType::Symbol, ")") {
                                context.error("Expected , or )");
                                return null;
                            }
                        }

                        let tuple = context.allocator.store(&Tuple { elements: Array<Type>::new(context.allocator) });
                        if tuple == null {
                            context.error("Failed to allocate tuple type");
                            return null;
                        }
                        tuple.elements = Array<Type>::new_with_length(context.allocator, arguments.length);
                        for (i, *expr) in arguments.iter().enumerate() {
                            tuple.elements.data[i] = expr.value.return_type;
                        }

                        result = Expression::make_type_function_call(context, token, context.allocator.store(&Type::Tuple(tuple)), arguments, null);
                    } else {
                        if !context.expect_value(TokenType::Symbol, ")") { return null; }

                        result = Expression::make(context.allocator, token, ExpressionData::ParenthesizedExpression(expr), &expr.return_type);
                    }
                } else if token.eq(TokenType::Symbol, "[") {
                    if !context.expect_value(TokenType::Symbol, "[") { return null; }

                    let element_type: *Type = null;
                    let elements = Array<InvokeArgument>::new(context.allocator);

                    while !context.check_value(TokenType::Symbol, "]") {
                        let element = Expression::parse(context, generics);
                        if element == null { return null; }

                        elements.append(InvokeArgument { name: null, value: element });

                        if element_type == null {
                            element_type = &element.return_type;
                        }

                        if context.check_next(TokenType::Symbol, ";") {
                            let count_token = context.expect(TokenType::Number);
                            if count_token == null { return null; }
                            let count: usize = strtoul(count_token.value.ptr, 0, 10);
                            let i: usize = 1;
                            while i < count {
                                elements.append(InvokeArgument { name: null, value: element });
                                i += 1;
                            }
                            break;
                        }

                        if !context.check_next(TokenType::Symbol, ",") && !context.check_value(TokenType::Symbol, "]") {
                            context.expect_value(TokenType::Symbol, "]");
                            return null;
                        }
                    }

                    context.expect_value(TokenType::Symbol, "]");

                    if element_type == null { element_type = &context.root.type_void; }
                    let length_str = String::new(context.allocator);
                    length_str.append_usize(elements.length);
                    let length_token_val = Token { type: TokenType::Number, value: length_str.as_str(), start_line: token.start_line, start_column: token.start_column, end_line: token.end_line, end_column: token.end_column };
                    let length_token = context.allocator.store(&length_token_val);
                    let length_primitive = Type::Primitive(context.module.find_primitive("usize"));
                    let length_expression = Expression::make(context.allocator, length_token, ExpressionData::Literal(length_str.as_str()), &length_primitive);
                    let parent_sequence = context.allocator.store(&Sequence { type: SequenceType::FixedArray(length_expression), element: *element_type, element_pointer: Type::Primitive(null) });
                    let parent_type = context.allocator.store(&Type::Sequence(parent_sequence));
                    let parent_expression = Expression::make(context.allocator, token, ExpressionData::Type(parent_type), parent_type);

                    result = Expression::make(context.allocator, token, ExpressionData::Invoke(parent_expression, elements), parent_type);
                } else {
                    context.error("Unhandled symbol");
                }
            },
            TokenType::Keyword => {
                if token.value.eq("true") || token.value.eq("false") {
                    result = Expression::make_next(context, Expression {
                        token,
                        data: ExpressionData::Literal(token.value),
                        return_type: Type::Primitive(context.module.find_primitive("bool")),
                    });
                } else if token.value.eq("null") {
                    result = Expression::make_next(context, Expression {
                        token,
                        data: ExpressionData::NullLiteral,
                        return_type: Type::Primitive(context.module.find_primitive("i32")),
                    });
                } else if token.value.eq("if") {
                    result = Expression::parse_if_expression(context, generics);
                } else {
                    context.error("Only true + false keywords are valid in expressions");
                }
            },
            TokenType::Comment => {
                context.error("Comment should be skipped");
            },
        }

        if result == null { return null; }

        return Expression::parse_postfix_chain(context, result, generics);
    }

    fn parse(context: &Context, generics: *Generics) -> *Expression {
        let result = Expression::parse_primary(context, generics);
        if result == null { return null; }

        result = Expression::parse_binary(context, result, 1, generics);
        if result == null { return null; }

        if context.check_value(TokenType::Symbol, "..") {
            let token = context.expect(TokenType::Symbol);

            let range_start = result;
            let range_end = Expression::parse(context, generics);
            if range_end == null { return null; }

            let enum_type: *Type = context.module.find_make_type("Range", &Array<Type> { data: &range_end.return_type, length: 1, allocator: context.allocator, capacity: 0 });
            if enum_type == null {
                context.error_token(token, "Could not find Range type, include std library");
                return null;
            }

            let variant_name = *token;
            variant_name.type = TokenType::Identifier;
            variant_name.value = "StartEnd";

            let variant_result = Expression::get_enum_variant(context, enum_type, &variant_name);
            let variant: *EnumVariant = null;
            match variant_result {
                EnumVariantResult::EnumVariant(enum_variant) => { variant = enum_variant; },
                _ => {},
            }
            if variant == null {
                context.error_token(token, "Could not find Range StartEnd enum variant");
                return null;
            }

            let arguments = Array<InvokeArgument>::new(context.allocator);
            arguments.append(InvokeArgument { name: null, value: range_start });
            arguments.append(InvokeArgument { name: null, value: range_end });

            let enum_variant = Expression::make(context.allocator, token, ExpressionData::EnumVariant(variant), enum_type);

            result = Expression::make(context.allocator, token, ExpressionData::Invoke(enum_variant, arguments), enum_type);
        }

        return result;
    }

    fn is_zero(&self) -> bool {
        match self.data {
            ExpressionData::Literal(value) => { return value.eq("0"); },
            _ => { return false; },
        }
    }

    fn is_const_expression(&self, context: &Context) -> bool {
        match self.data {
            ExpressionData::Literal(_) => { return true; },
            ExpressionData::ParenthesizedExpression(inner) => {
                return inner.is_const_expression(context);
            },
            ExpressionData::UnaryExpression(op, inner) => {
                if !op.eq("-") && !op.eq("+") { return false; }
                return inner.is_const_expression(context);
            },
            ExpressionData::BinaryExpression(lhs, op, rhs) => {
                if !op.eq("+") && !op.eq("-") && !op.eq("*") && !op.eq("/") && !op.eq("%") { return false; }
                return lhs.is_const_expression(context) && rhs.is_const_expression(context);
            },
            ExpressionData::EnumVariant(_) => { return true; },
            ExpressionData::Invoke(target, arguments) => {
                if arguments.length != 0 { return false; }
                return target.is_const_expression(context);
            },
            ExpressionData::MemberStaticExpression(_, _) => {
                match self.return_type {
                    Type::EnumC(_) => { return true; },
                    _ => { return false; },
                }
            },
            ExpressionData::Variable(name) => {
                match self.return_type {
                    Type::EnumC(_) => { return true; },
                    Type::UnknownC(_) => {
                        return context.module.find_macro_value(name) != null;
                    },
                    _ => { return false; },
                }
            },
            _ => { return false; },
        }
    }

    fn append_ident_name(&self, result: &String) {
        match self.data {
            ExpressionData::Literal(value) => {
                let i: usize = 0;
                while i < value.length {
                    let c = value.ptr[i];
                    if (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
                        result.append_char(c);
                    } else {
                        result.append_char('_');
                    }
                    i += 1;
                }
            },
            ExpressionData::ParenthesizedExpression(inner) => {
                inner.append_ident_name(result);
            },
            ExpressionData::UnaryExpression(op, inner) => {
                if op.eq("-") { result.append("neg_"); }
                inner.append_ident_name(result);
            },
            ExpressionData::BinaryExpression(lhs, op, rhs) => {
                lhs.append_ident_name(result);
                if op.eq("+") { result.append("_add_"); }
                else if op.eq("-") { result.append("_sub_"); }
                else if op.eq("*") { result.append("_mul_"); }
                else if op.eq("/") { result.append("_div_"); }
                else if op.eq("%") { result.append("_mod_"); }
                else { result.append("_op_"); }
                rhs.append_ident_name(result);
            },
            ExpressionData::EnumVariant(variant) => {
                let name = variant.parent.name;
                if name != null {
                    result.append(name.value);
                } else {
                    result.append("unknown_enum");
                }

                result.append("_");
                result.append(variant.name.value);
            },
            ExpressionData::Invoke(target, _) => {
                target.append_ident_name(result);
            },
            ExpressionData::MemberStaticExpression(_, member_name) => {
                result.append(member_name);
            },
            ExpressionData::Variable(name) => {
                result.append(name);
            },
            _ => {
                result.append("expr");
            },
        }
    }

    fn append_display_name(&self, result: &String) {
        match self.data {
            ExpressionData::Literal(value) => {
                result.append(value);
            },
            ExpressionData::ParenthesizedExpression(inner) => {
                result.append("(");
                inner.append_display_name(result);
                result.append(")");
            },
            ExpressionData::UnaryExpression(op, inner) => {
                result.append(op);
                inner.append_display_name(result);
            },
            ExpressionData::BinaryExpression(lhs, op, rhs) => {
                lhs.append_display_name(result);
                result.append(" ");
                result.append(op);
                result.append(" ");
                rhs.append_display_name(result);
            },
            ExpressionData::EnumVariant(variant) => {
                let name = variant.parent.name;
                if name != null {
                    result.append(name.value);
                } else {
                    result.append("unknown_enum");
                }

                result.append("::");
                result.append(variant.name.value);
            },
            ExpressionData::Invoke(target, _) => {
                target.append_display_name(result);
            },
            ExpressionData::MemberStaticExpression(_, member_name) => {
                result.append(member_name);
            },
            ExpressionData::Variable(name) => {
                result.append(name);
            },
            _ => {
                result.append("expr");
            },
        }
    }

    fn validate_type(&self, context: &Context, expected_type: &Type, apply_implicit_cast: bool) -> bool {
        let success = true;

        match self.data {
            ExpressionData::NullLiteral => {
                match expected_type.resolve_typedef() {
                    Type::Indirect(indirect) => {
                        match indirect.type {
                            IndirectType::Reference => {
                                context.error_token(self.token, "null can only be used with * types, not & types");
                                return false;
                            },
                            IndirectType::DynamicDispatch => {
                                context.error_token(self.token, "null can only be used with * types, not & types");
                                return false;
                            },
                            _ => { return true; },
                        }
                    },
                    _ => {},
                }
            },
            ExpressionData::Literal(value) => {
                if value.eq("0") {
                    match expected_type {
                        Type::Indirect(indirect) => {
                            match indirect.type {
                                IndirectType::Pointer => {
                                    context.error_token(self.token, "use null instead of 0 for pointer types");
                                    return false;
                                },
                                IndirectType::ConstPointer => {
                                    context.error_token(self.token, "use null instead of 0 for pointer types");
                                    return false;
                                },
                                IndirectType::DynamicDispatchPointer => {
                                    context.error_token(self.token, "use null instead of 0 for pointer types");
                                    return false;
                                },
                                _ => {},
                            }
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }

        match self.data {
            ExpressionData::UnaryExpression(operator, child) => {
            if operator.eq("&") {
                match expected_type {
                    Type::Indirect(indirect) => {
                        match indirect.to {
                            Type::Sequence(_) => {
                                match child.data {
                                    ExpressionData::Invoke(_, _) => {
                                        if child.return_type.is_sequence_fixed_array() {
                                            child.validate_type(context, &indirect.to, apply_implicit_cast);
                                        }
                                    },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            }
        },
        ExpressionData::Invoke(invoke, &arguments) => {
                match expected_type {
                    Type::Tuple(tuple) => {
                        for (i, argument) in arguments.iter().enumerate() {
                            success = argument.value.validate_type(context, &tuple.elements.data[i], apply_implicit_cast) && success;
                        }

                        invoke.data = ExpressionData::Type(expected_type);
                        invoke.return_type = *expected_type;
                        self.return_type = *expected_type;

                        return success;
                    },
                    Type::Sequence(sequence) => {
                        if self.return_type.is_sequence_fixed_array() {
                            for (_, argument) in arguments.iter().enumerate() {
                                success = argument.value.validate_type(context, &sequence.element, apply_implicit_cast) && success;
                            }

                            match self.return_type {
                                Type::Sequence(self_seq) => {
                                    let new_seq = context.allocator.store(&Sequence { type: self_seq.type, element: sequence.element, element_pointer: self_seq.element_pointer });
                                    let new_type = context.allocator.store(&Type::Sequence(new_seq));
                                    invoke.data = ExpressionData::Type(new_type);
                                    invoke.return_type = *new_type;
                                    self.return_type = *new_type;
                                },
                                _ => {},
                            }

                            return success;
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }

        if apply_implicit_cast && expected_type.needs_implicit_cast(&self.return_type) {
            let expression = context.allocator.store(self);
            self.data = ExpressionData::ImplicitCast(expression);
            self.return_type = *expected_type;
            return true;
        }

        if !expected_type.eq(&self.return_type) {
            let message = String::new(context.allocator);
            message.append("Expected expression of type ");
            let expected_type_name = context.root.naming_decl.get_type_decl(expected_type, context.type_self, null);
            message.append(expected_type_name.as_str());
            message.append(", but found ");
            let actual_type_name = context.root.naming_decl.get_type_decl(&self.return_type, context.type_self, null);
            message.append(actual_type_name.as_str());
            context.error_expression(self, message.c_str());
            return false;
        }

        // self.return_type = *type;
        return true;
    }

    fn parse_if_expression(context: &Context, generics: &Generics) -> *Expression {
        let token = context.current();
        if !context.expect_value(TokenType::Keyword, "if") { return null; }

        let condition = Expression::parse(context, generics);
        if condition == null { return null; }

        match condition.return_type {
            Type::Primitive(prim) => {
                if prim == null {
                    context.error_expression(condition, "If condition return type is blank");
                    return null;
                }

                if !prim.name.eq("bool") {
                    context.error_expression(condition, "If condition must be a bool expression");
                    return null;
                }
            },
            _ => {
                context.error_expression(condition, "If condition must be a bool expression");
                return null;
            },
        }

        if !context.expect_value(TokenType::Symbol, "{") { return null; }

        let narrowings_true = Array<NullNarrowing>::new(context.allocator);
        Expression::collect_null_narrowings(context, condition, true, &narrowings_true);
        let pushed_true_scope = false;
        if narrowings_true.length > 0 {
            context.push_scope(null);
            for narrow in narrowings_true { context.set_narrowed(narrow.path, narrow.type); }
            pushed_true_scope = true;
        }

        let a = Expression::parse(context, generics);
        if pushed_true_scope { context.pop_scope(); }
        if a == null { return null; }

        if !context.expect_value(TokenType::Symbol, "}") { return null; }
        if !context.expect_value(TokenType::Keyword, "else") { return null; }

        let is_else_if = context.check_value(TokenType::Keyword, "if");

        if !is_else_if && !context.check_next(TokenType::Symbol, "{") {
            context.error("Expected { or else if");
            return null;
        }

        let narrowings_false = Array<NullNarrowing>::new(context.allocator);
        Expression::collect_null_narrowings(context, condition, false, &narrowings_false);
        let pushed_false_scope = false;
        if narrowings_false.length > 0 {
            context.push_scope(null);
            for narrow in narrowings_false { context.set_narrowed(narrow.path, narrow.type); }
            pushed_false_scope = true;
        }

        let b = Expression::parse(context, generics);
        if pushed_false_scope { context.pop_scope(); }
        if b == null { return null; }

        if !is_else_if && !context.expect_value(TokenType::Symbol, "}") { return null; }

        if !a.validate_type(context, &b.return_type, false) { return null; }

        return Expression::make(context.allocator, token, ExpressionData::IfExpression(condition, a, b), &a.return_type);
    }

    fn record_function_signature(context: &Context, function_type: &Type, open_paren: &Token, close_paren: &Token, comma_positions: Array<Position>, skip_self: bool) {
        if !context.should_record_symbols() { return; }

        let func_info: *Function = null;
        let function_type_self = context.type_self;
        let function_generics: *GenericMap = null;

        match function_type {
            Type::Function(info, generics) => {
                func_info = info;
                function_generics = generics;
                if generics != null && generics.self_type != null {
                    function_type_self = generics.self_type;
                }
            },
            _ => { return; },
        }
        if func_info == null { return; }

        let label = String::new(context.allocator);
        label.append("fn ");
        let name = func_info.name;
        if name != null { label.append(name.value); }
        label.append("(");

        let params = Array<str>::new(context.allocator);
        let first = true;
        let i: usize = 0;
        for param in func_info.parameters {
            if skip_self && i == 0 {
                i += 1;
                continue;
            }
            if !first { label.append(", "); }
            first = false;

            let param_str = String::new(context.allocator);
            let pname = param.name;
            if pname != null {
                param_str.append(pname.value);
                param_str.append(": ");
            }
            let type_decl = context.root.naming_decl.get_type_decl(&param.type, function_type_self, function_generics);
            param_str.append(type_decl.as_str());
            label.append(param_str.as_str());
            params.append(param_str.as_str());
            i += 1;
        }

        label.append(")");
        let ret_type_decl = context.root.naming_decl.get_type_decl(&func_info.return_type, function_type_self, function_generics);
        if !func_info.return_type.is_void() {
            label.append(" -> ");
            label.append(ret_type_decl.as_str());
        }

        context.record_signature(open_paren, close_paren, comma_positions, label.as_str(), params);
    }
}
