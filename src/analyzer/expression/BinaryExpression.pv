use std
use analyzer
use types

struct NullNarrowing {
    path: str,
    type: &Type,
}

impl Expression {
    // Build the dotted access path of an expression (e.g. "self.parent.next") into `out`.
    // Returns true if the expression is a Variable or a chain of MemberInstanceExpression
    // rooted in a Variable; false otherwise. Parens are transparently unwrapped.
    fn build_narrow_path(&self, out: &String) -> bool {
        let inner = self;
        match inner.data {
            ExpressionData::ParenthesizedExpression(child) => { return child.build_narrow_path(out); },
            ExpressionData::Variable(name) => {
                out.append(name);
                return true;
            },
            ExpressionData::MemberInstanceExpression(parent, member) => {
                if !parent.build_narrow_path(out) { return false; }
                out.append(".");
                out.append(member);
                return true;
            },
            _ => { return false; },
        }
    }

    // Walks `expr` collecting every `var == null` (when narrow_on_true=false) or
    // `var != null` (when narrow_on_true=true) site reachable via `||` (false branch)
    // and `&&` (true branch) chains, where `var` has pointer type. Each match is
    // appended to `out` as a NullNarrowing { path, &T }. Parens are transparent.
    fn collect_null_narrowings(context: &Context, expr: &Expression, narrow_on_true: bool, out: &Array<NullNarrowing>) {
        let inner = expr;
        match inner.data {
            ExpressionData::ParenthesizedExpression(child) => { inner = child; },
            _ => {},
        }

        match inner.data {
            ExpressionData::BinaryExpression(lhs, op, rhs) => {
                if op.eq("||") && !narrow_on_true {
                    Expression::collect_null_narrowings(context, lhs, false, out);
                    Expression::collect_null_narrowings(context, rhs, false, out);
                    return;
                }
                if op.eq("&&") && narrow_on_true {
                    Expression::collect_null_narrowings(context, lhs, true, out);
                    Expression::collect_null_narrowings(context, rhs, true, out);
                    return;
                }

                let want_op: str = if narrow_on_true { "!=" } else { "==" };
                if !op.eq(want_op) { return; }

                let path = String::new(context.allocator);
                let var_expr: *Expression = null;
                let other: *Expression = null;

                if lhs.build_narrow_path(&path) { var_expr = lhs; other = rhs; }
                else {
                    let path2 = String::new(context.allocator);
                    if rhs.build_narrow_path(&path2) { var_expr = rhs; other = lhs; path = path2; }
                    else { return; }
                }

                if other == null { return; }
                let other_inner = other;
                match other_inner.data {
                    ExpressionData::ParenthesizedExpression(c) => { other_inner = c; },
                    _ => {},
                }
                if other_inner == null { return; }
                match other_inner.data {
                    ExpressionData::NullLiteral => {},
                    _ => { return; },
                }

                if var_expr == null { return; }
                match var_expr.return_type {
                    Type::Indirect(indirect) => {
                        if indirect.type != IndirectType::Pointer && indirect.type != IndirectType::ConstPointer {
                            return;
                        }
                        let ref_indirect = Indirect::new_reference(context.allocator, indirect.to);
                        let type_val = Type::Indirect(ref_indirect);
                        let stored = context.allocator.store(&type_val);
                        if stored == null { return; }
                        out.append(NullNarrowing { path: path.as_str(), type: stored });
                    },
                    _ => {},
                }
            },
            _ => {},
        }
    }

    fn parse_binary(context: &Context, lhs: &Expression, min_prec: usize, generics: &Generics) -> *Expression {
        let result = lhs;

        while true {
            let token = context.current();
            let prec = Expression::get_precedence(token);
            if prec < min_prec { break; }

            let operator = context.expect(TokenType::Symbol);
            if operator == null { return null; }

            // Short-circuit narrowing: when parsing the RHS of `||` we know the LHS was false,
            // and for `&&` we know the LHS was true. If the LHS contains a null-check on a
            // variable, narrow that variable to `&T` while parsing the RHS.
            let pushed_narrow_scope = false;
            if operator.value.eq("||") || operator.value.eq("&&") {
                let narrow_on_true_for_rhs = operator.value.eq("&&");
                let narrowings = Array<NullNarrowing>::new(context.allocator);
                Expression::collect_null_narrowings(context, result, narrow_on_true_for_rhs, &narrowings);
                if narrowings.length > 0 {
                    context.push_scope(null);
                    for narrow in narrowings {
                        context.set_narrowed(narrow.path, narrow.type);
                    }
                    pushed_narrow_scope = true;
                }
            }

            let rhs = Expression::parse_primary(context, generics);
            if rhs == null { if pushed_narrow_scope { context.pop_scope(); } return null; }

            let rhs_final = Expression::parse_binary(context, rhs, prec + 1, generics);
            if rhs_final == null { if pushed_narrow_scope { context.pop_scope(); } return null; }

            if pushed_narrow_scope { context.pop_scope(); }

            let is_arithmetic =
                operator.value.eq("*") || operator.value.eq("+") ||
                operator.value.eq("-") || operator.value.eq("/");

            let is_trait_op = is_arithmetic || operator.value.eq("==") ||
                operator.value.eq("<") || operator.value.eq(">") ||
                operator.value.eq("<=") || operator.value.eq(">=");

            if is_trait_op {
                let trait_result = Expression::find_operator_trait_call(context, token, result, &result.return_type, operator.value, rhs_final);
                if trait_result != null {
                    result = trait_result;
                    continue;
                }
            }

            let is_comparison =
                operator.value.eq("==") || operator.value.eq("!=") ||
                operator.value.eq("<=") || operator.value.eq(">=") ||
                operator.value.eq("<")  || operator.value.eq(">")  ||
                operator.value.eq("||") || operator.value.eq("&&");

            let return_type: *Type = null;
            if is_comparison {
                if !operator.value.eq("||") && !operator.value.eq("&&") {
                    if !result.validate_type(context, &rhs_final.return_type, false) { return null; }

                    // Also validate RHS null/0 literal against LHS type (catches `ptr == 0` / `ptr == null`)
                    match rhs_final.data {
                        ExpressionData::NullLiteral => {
                            rhs_final.validate_type(context, &result.return_type, false);
                        },
                        ExpressionData::Literal(value) => {
                            if value.eq("0") {
                                rhs_final.validate_type(context, &result.return_type, false);
                            }
                        },
                        _ => {},
                    }
                }

                return_type = &context.root.type_bool;
            } else {
                return_type = &result.return_type;
            }

            result = Expression::make(context.allocator, token, ExpressionData::BinaryExpression(result, operator.value, rhs_final), return_type);
        }

        return result;
    }

    fn find_operator_trait_call(context: &Context, token: &Token, lhs: &Expression, lhs_type: &Type, operator: str, rhs: &Expression) -> *Expression {
        let trait_name: str = "";
        let func_name: str = "";

        if operator.eq("*") { trait_name = "Mul"; func_name = "mul"; }
        else if operator.eq("+") { trait_name = "Add"; func_name = "add"; }
        else if operator.eq("-") { trait_name = "Sub"; func_name = "sub"; }
        else if operator.eq("/") { trait_name = "Div"; func_name = "div"; }
        else if operator.eq("==") { trait_name = "Eq"; func_name = "eq"; }
        else if operator.eq("<")  { trait_name = "Ord"; func_name = "lt"; }
        else if operator.eq(">")  { trait_name = "Ord"; func_name = "gt"; }
        else if operator.eq("<=") { trait_name = "Ord"; func_name = "le"; }
        else if operator.eq(">=") { trait_name = "Ord"; func_name = "ge"; }
        else { return null; }

        if lhs_type.is_unknown() || rhs.return_type.is_unknown() { return null; }

        match lhs_type {
            Type::Self => {
                if context.type_self != null {
                    return Expression::find_operator_trait_call(context, token, lhs, context.type_self, operator, rhs);
                }
            },
            // Type::Indirect(indirect) => {
            //     return Expression::find_operator_trait_call(context, token, lhs, &indirect.to, operator, rhs);
            // },
            Type::Struct(struct_info, generic_map) => {
                for *impl_info in struct_info.impls {
                    let impl_trait = impl_info.trait_;
                    if !impl_info.has_trait || impl_trait == null { continue; }
                    let impl_trait_name = impl_trait.name;
                    if impl_trait_name == null { continue; }
                    if !impl_trait_name.value.eq(trait_name) { continue; }

                    let func = impl_info.functions.find(&func_name);
                    if func == null { continue; }
                    if func.parameters.length < 2 { continue; }

                    let other_param = func.parameters.get(1);
                    if other_param == null { continue; }
                    if !other_param.type.eq(&rhs.return_type) { continue; }

                    let func_map: *GenericMap = generic_map;
                    if impl_info.typedefs.length > 0 {
                        if generic_map == null { return null; }
                        let aug_map_val = generic_map.clone(context.allocator);
                        let aug_map = context.allocator.store(&aug_map_val);
                        if aug_map == null { return null; }
                        for (name, &typedef_type) in impl_info.typedefs {
                            aug_map.insert(name, *typedef_type);
                        }
                        func_map = aug_map;
                    }

                    let func_type = context.allocator.store(&Type::Function(func, func_map));
                    if func_type == null { return null; }

                    let arguments = Array<InvokeArgument>::new(context.allocator);
                    arguments.append(InvokeArgument { name: null, value: lhs });
                    arguments.append(InvokeArgument { name: null, value: rhs });

                    return Expression::make_type_function_call(context, token, func_type, arguments, null);
                }
            },
            Type::Primitive(primitive_info) => {
                if primitive_info == null { return null; }
                for *impl_info in primitive_info.impls {
                    let impl_trait = impl_info.trait_;
                    if !impl_info.has_trait || impl_trait == null { continue; }
                    let impl_trait_name = impl_trait.name;
                    if impl_trait_name == null { continue; }
                    if !impl_trait_name.value.eq(trait_name) { continue; }

                    let func = impl_info.functions.find(&func_name);
                    if func == null { continue; }
                    if func.parameters.length < 2 { continue; }

                    let other_param = func.parameters.get(1);
                    if other_param == null { continue; }
                    if rhs.return_type.is_self() { continue; }
                    if !other_param.type.eq(&rhs.return_type) { continue; }

                    let func_map: *GenericMap = impl_info.trait_type.get_generic_map(context);

                    let func_type = context.allocator.store(&Type::Function(func, func_map));

                    let arguments = Array<InvokeArgument>::new(context.allocator);
                    arguments.append(InvokeArgument { name: null, value: lhs });
                    arguments.append(InvokeArgument { name: null, value: rhs });

                    return Expression::make_type_function_call(context, token, func_type, arguments, null);
                }
            },
            _ => {},
        }

        return null;
    }

    fn find_unary_trait_call(context: &Context, token: &Token, operand: &Expression) -> *Expression {
        if operand.return_type.is_unknown() { return null; }

        match operand.return_type {
            Type::Self => {
                if context.type_self != null {
                    let concrete_operand = Expression { data: operand.data, return_type: *context.type_self, token: operand.token };
                    return Expression::find_unary_trait_call(context, token, &concrete_operand);
                }
            },
            Type::Struct(struct_info, generic_map) => {
                for *impl_info in struct_info.impls {
                    let impl_trait = impl_info.trait_;
                    if !impl_info.has_trait || impl_trait == null { continue; }
                    let impl_trait_name = impl_trait.name;
                    if impl_trait_name == null { continue; }
                    if !impl_trait_name.value.eq("Neg") { continue; }

                    let func = impl_info.functions.find("neg");
                    if func == null { continue; }
                    if func.parameters.length < 1 { continue; }

                    let func_map: *GenericMap = generic_map;
                    if impl_info.typedefs.length > 0 {
                        if generic_map == null { return null; }
                        let aug_map_val = generic_map.clone(context.allocator);
                        let aug_map = context.allocator.store(&aug_map_val);
                        if aug_map == null { return null; }
                        for (name, &typedef_type) in impl_info.typedefs {
                            let resolved = Context::resolve_type(context.allocator, typedef_type, generic_map, null);
                            if resolved == null { return null; }
                            aug_map.insert(name, *resolved);
                        }
                        func_map = aug_map;
                    }

                    let func_type = context.allocator.store(&Type::Function(func, func_map));
                    let arguments = Array<InvokeArgument>::new(context.allocator);
                    arguments.append(InvokeArgument { name: null, value: operand });

                    return Expression::make_type_function_call(context, token, func_type, arguments, null);
                }
            },
            _ => {},
        }

        return null;
    }

    fn find_index_trait_call(context: &Context, token: &Token, inner: &Expression, index_expr: &Expression) -> *Expression {
        if inner.return_type.is_unknown() { return null; }

        match inner.return_type.deref_reference() {
            Type::Struct(struct_info, generic_map) => {
                for *impl_info in struct_info.impls {
                    let impl_trait = impl_info.trait_;
                    if !impl_info.has_trait || impl_trait == null { continue; }
                    let impl_trait_name = impl_trait.name;
                    if impl_trait_name == null { continue; }
                    if !impl_trait_name.value.eq("Index") { continue; }

                    let func = impl_info.functions.find("index");
                    if func == null { continue; }
                    if func.parameters.length < 1 { continue; }

                    let func_map: *GenericMap = generic_map;
                    if impl_info.typedefs.length > 0 {
                        if generic_map == null { return null; }
                        let aug_map_val = generic_map.clone(context.allocator);
                        let aug_map = context.allocator.store(&aug_map_val);
                        if aug_map == null { return null; }
                        for (name, &typedef_type) in impl_info.typedefs {
                            let resolved = Context::resolve_type(context.allocator, typedef_type, generic_map, null);
                            if resolved == null { return null; }
                            aug_map.insert(name, *resolved);
                        }
                        func_map = aug_map;
                    }

                    let func_type = context.allocator.store(&Type::Function(func, func_map));
                    let arguments = Array<InvokeArgument>::new(context.allocator);
                    arguments.append(InvokeArgument { name: null, value: inner });

                    let ptr_expr = Expression::make_type_function_call(context, token, func_type, arguments, null);
                    if ptr_expr == null { return null; }

                    let element_type = ptr_expr.return_type.deref();
                    return Expression::make(context.allocator, token, ExpressionData::IndexExpression(ptr_expr, index_expr), element_type);
                }
            },
            _ => {},
        }

        return null;
    }

    fn get_precedence(token: &Token) -> usize {
        if token.type != TokenType::Symbol { return 0; }

        if token.value.eq("||") { return 1; }
        if token.value.eq("&&") { return 2; }
        if token.value.eq("|") { return 3; }
        if token.value.eq("^") { return 4; }
        if token.value.eq("&") { return 5; }
        if token.value.eq("==") || token.value.eq("!=") { return 6; }
        if token.value.eq("<")  || token.value.eq(">") || token.value.eq("<=") || token.value.eq(">=")                  { return 7; }
        if token.value.eq("<<") || token.value.eq(">>") { return 8; }
        if token.value.eq("+")  || token.value.eq("-") { return 9; }
        if token.value.eq("*")  || token.value.eq("/") || token.value.eq("%") { return 10; }

        return 0;
    }
}
