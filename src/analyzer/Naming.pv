#include "stdio.h"

use std
use types
use c
use expression

enum NamingType {
    Ident,
    Decl,
    C99,
}

struct Naming {
    allocator: &ArenaAllocator,
    type: NamingType,
    generic_start: str,
    generic_seperator: str,
    generic_end: str,
    pointer_prefix: str,
    pointer_suffix: str,
    pointer_const_prefix: str,
    pointer_const_suffix: str,
    reference_prefix: str,
    reference_suffix: str,
    sequence_slice_prefix: str,
    sequence_open: str,
    sequence_fixed_delimiter: str,
    sequence_close: str,
    tuple_prefix: str,
    tuple_open: str,
    tuple_close: str,
    enum_generic_type_suffix: str,
    enum_prefix: str,
    struct_prefix: str,
    trait_prefix: str,
    union_prefix: str,
    coroutine_instance_prefix: str,
    primitives: HashMap<str, str>,
    naming_ident: *Naming,
}

impl Naming {
    fn new_decl(allocator: &ArenaAllocator) -> Self {
        return Self {
            allocator,
            type: NamingType::Decl,
            generic_start: "<",
            generic_seperator: ", ",
            generic_end: ">",
            pointer_prefix: "*",
            pointer_const_prefix: "*const ",
            reference_prefix: "&",
            sequence_open: "[",
            sequence_fixed_delimiter: "; ",
            sequence_close: "]",
            tuple_open: "(",
            tuple_close: ")",
            pointer_suffix: "",
            pointer_const_suffix: "",
            reference_suffix: "",
            sequence_slice_prefix: "",
            tuple_prefix: "",
            enum_generic_type_suffix: "",
            enum_prefix: "",
            struct_prefix: "",
            trait_prefix: "",
            union_prefix: "",
            coroutine_instance_prefix: "",
            primitives: HashMap<str, str> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
            naming_ident: null,
        };
    }

    fn new_ident(allocator: &ArenaAllocator) -> Self {
        return Self {
            allocator,
            type: NamingType::Ident,
            generic_start: "_",
            generic_seperator: "_",
            pointer_prefix: "ptr_",
            pointer_const_prefix: "ptrc_",
            reference_prefix: "ref_",
            sequence_slice_prefix: "slice_",
            enum_generic_type_suffix: "__Type",
            trait_prefix: "trait_",
            tuple_prefix: "tuple_",
            generic_end: "",
            pointer_suffix: "",
            pointer_const_suffix: "",
            reference_suffix: "",
            sequence_open: "",
            sequence_fixed_delimiter: "",
            sequence_close: "",
            tuple_open: "",
            tuple_close: "",
            enum_prefix: "",
            struct_prefix: "",
            union_prefix: "",
            coroutine_instance_prefix: "",
            primitives: HashMap<str, str> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
            naming_ident: null,
        };
    }

    fn new_c99(allocator: &ArenaAllocator, naming_ident: &Naming) -> Self {
        let primitives = HashMap<str, str>::new(allocator);
        primitives.insert("bool", "bool");
        primitives.insert("i8", "int8_t");
        primitives.insert("i16", "int16_t");
        primitives.insert("i32", "int32_t");
        primitives.insert("i64", "int64_t");
        primitives.insert("isize", "intptr_t");
        primitives.insert("u8", "uint8_t");
        primitives.insert("u16", "uint16_t");
        primitives.insert("u32", "uint32_t");
        primitives.insert("u64", "uint64_t");
        primitives.insert("usize", "uintptr_t");
        primitives.insert("f32", "float");
        primitives.insert("f64", "double");
        primitives.insert("char", "char");
        primitives.insert("void", "void");

        return Self {
            allocator,
            type: NamingType::C99,
            generic_start: "_",
            generic_seperator: "_",
            pointer_suffix: "*",
            pointer_const_suffix: " const*",
            reference_suffix: "*",
            sequence_slice_prefix: "struct slice_",
            sequence_open: "[",
            sequence_close: "]",
            tuple_prefix: "struct tuple_",
            enum_prefix: "enum ",
            struct_prefix: "struct ",
            trait_prefix: "struct trait_",
            union_prefix: "union ",
            coroutine_instance_prefix: "struct ",
            primitives,
            naming_ident,
            generic_end: "",
            pointer_prefix: "",
            pointer_const_prefix: "",
            reference_prefix: "",
            sequence_fixed_delimiter: "",
            tuple_open: "",
            tuple_close: "",
            enum_generic_type_suffix: "",
        };
    }

    fn get_type_name(&self, type: &Type, type_self: &Type, generics_map: *GenericMap) -> String {
        let result = String::new(self.allocator);
        let generics = Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 };
        let generic_start = self.generic_start;
        let generic_end = self.generic_end;

        match type {
            Type::Indirect(indirect) => {
                match indirect.type {
                    IndirectType::Pointer => { result.append(self.pointer_prefix); },
                    IndirectType::ConstPointer => { result.append(self.pointer_const_prefix); },
                    IndirectType::Reference => { result.append(self.reference_prefix); },
                    IndirectType::DynamicDispatch => { result.append(self.reference_prefix); },
                    IndirectType::DynamicDispatchPointer => { result.append(self.pointer_prefix); },
                }

                let child_name = self.get_type_name(&indirect.to, type_self, generics_map);
                result.append(child_name.as_str());

                match indirect.to {
                    Type::Trait(_, _) => {},
                    Type::Sequence(sequence) => {
                        if !sequence.is_slice() { result.append(self.reference_suffix); }
                    },
                    _ => {
                        match indirect.type {
                            IndirectType::Pointer => { result.append(self.pointer_suffix); },
                            IndirectType::ConstPointer => { result.append(self.pointer_const_suffix); },
                            IndirectType::Reference => { result.append(self.reference_suffix); },
                            IndirectType::DynamicDispatch => { result.append(self.reference_suffix); },
                            IndirectType::DynamicDispatchPointer => { result.append(self.pointer_suffix); },
                        }
                    },
                }
            },
            Type::Sequence(sequence) => {
                let element_name = self.get_type_name(&sequence.element, type_self, generics_map);

                match sequence.type {
                    SequenceType::Slice => {
                        if self.naming_ident != null {
                            element_name.release();
                            element_name = self.naming_ident.get_type_name(&sequence.element, type_self, generics_map);
                        }

                        result.append(self.sequence_slice_prefix);
                    },
                    _ => {},
                }

                if self.type == NamingType::C99 {
                    result.append(element_name.as_str());
                } else {
                    match sequence.type {
                        SequenceType::FixedArray(length) => {
                            result.append(self.sequence_open);
                            result.append(element_name.as_str());
                            result.append(self.sequence_fixed_delimiter);
                            if self.type == NamingType::Ident {
                                length.append_ident_name(&result);
                            } else {
                                length.append_display_name(&result);
                            }
                            result.append(self.sequence_close);
                        },
                        SequenceType::Slice => {
                            result.append(self.sequence_open);
                            result.append(element_name.as_str());
                            result.append(self.sequence_close);
                        }
                    }
                }
            },
            Type::Tuple(tuple) => {
                result.append(self.tuple_prefix);
                generic_start = self.tuple_open;
                generic_end = self.tuple_close;
                generics = tuple.elements;
            },
            Type::Primitive(primitive_info) => {
                if primitive_info == null {
                    result.append("void");
                } else {
                    let translation = self.primitives.find(&primitive_info.name);

                    if translation != null {
                        result.append(*translation);
                    } else {
                        result.append(primitive_info.name);
                    }
                }
            },
            Type::Enum(enum_info, generics2) => {
                match enum_info.type {
                    EnumType::Standard => { result.append(self.enum_prefix); },
                    EnumType::DiscriminatedUnion => { result.append(self.struct_prefix); },
                }

                let enum_name = enum_info.name;
                if enum_name == null { return result; }
                result.append(enum_name.value);

                for gen in enum_info.generics.array {
                    let gen_name = gen.name;
                    if gen_name == null { continue; }
                    if generics2 == null { continue; }
                    let value = generics2.get(gen_name.value);
                    if value != null { generics.append(*value); }
                }
            },
            Type::Struct(struct_info, generics2) => {
                if !struct_info.is_newtype() {
                    result.append(self.struct_prefix);
                }

                let struct_name = struct_info.name;
                if struct_name == null { return result; }
                result.append(struct_name.value);

                for gen in struct_info.generics.array {
                    let gen_name = gen.name;
                    if gen_name == null { continue; }
                    if generics2 == null { continue; }
                    let value = generics2.get(gen_name.value);
                    if value != null { generics.append(*value); }
                }
            },
            Type::Trait(trait_info, generics2) => {
                result.append(self.trait_prefix);
                let trait_name = trait_info.name;
                if trait_name == null { return result; }
                result.append(trait_name.value);
                if generics2 == null { return result; }
                generics = generics2.array;
            },
            Type::Generic(generic) => {
                let generic_name = generic.name;
                if generic_name == null { return result; }
                let name = generic_name.value;

                if generics_map == null {
                    result.append(name);
                    return result;
                }

                let generic_type = generics_map.get(name);
                if generic_type == null {
                    result.append(name);
                    return result;
                }

                match generic_type {
                    Type::Generic(mapped_generic) => {
                        let mapped_name = mapped_generic.name;
                        if mapped_name != null && mapped_name.value.eq(name) {
                            result.append(name);
                            return result;
                        }
                    },
                    _ => {},
                }

                if generic_type.contains_generic_name(name) {
                    let display_generics = generics_map.clone(self.allocator);
                    display_generics.map.remove(&name);
                    return self.get_type_name(generic_type, type_self, &display_generics);
                }

                return self.get_type_name(generic_type, type_self, generics_map);
            },
            Type::GenericTypedef(gt) => {
                if generics_map != null {
                    let direct_type = generics_map.get(gt.typedef_name);
                    if direct_type != null {
                        return self.get_type_name(direct_type, type_self, generics_map);
                    }

                    let generic_name = gt.generic.name;
                    if generic_name == null { return result; }
                    let concrete_type = generics_map.get(generic_name.value);
                    if concrete_type != null {
                        match concrete_type {
                            Type::Struct(struct_info, _) => {
                                for *impl_info in struct_info.impls {
                                    let trait_info = impl_info.trait_;
                                    if trait_info == null { continue; }
                                    if trait_info.typedefs.find(&gt.typedef_name) == null { continue; }
                                    let typedef_type = impl_info.typedefs.find(&gt.typedef_name);
                                    if typedef_type != null {
                                        return self.get_type_name(typedef_type, type_self, generics_map);
                                    }
                                }
                            },
                            _ => {},
                        }
                    }
                }

                result.append(gt.typedef_name);
                return result;
            },
            Type::UnknownC(info) => {
                result.append(info.name);
                generics = info.generics;
            },
            Type::Function(func_info, generics2) => {
                let has_parent = false;
                let parent_type: Type;
                let trait_info: *Trait = null;
                let trait_impl_info: *Impl = null;

                match func_info.parent {
                    FunctionParent::None => {},
                    FunctionParent::Primitive(primitive, impl_index, trait_info2) => {
                        parent_type = Type::Primitive(primitive);
                        trait_info = trait_info2;
                        has_parent = true;
                        if primitive.impls.length > impl_index {
                            trait_impl_info = primitive.impls.data[impl_index];
                        }
                    },
                    FunctionParent::Enum(enum_info, impl_index, trait_info2) => {
                        parent_type = Type::Enum(enum_info, generics2);
                        trait_info = trait_info2;
                        has_parent = true;
                        if enum_info.impls.length > impl_index {
                            trait_impl_info = enum_info.impls.data[impl_index];
                        }
                    },
                    FunctionParent::Struct(struct_info, impl_index, trait_info2) => {
                        parent_type = Type::Struct(struct_info, generics2);
                        trait_info = trait_info2;
                        has_parent = true;
                        if struct_info.impls.length > impl_index {
                            trait_impl_info = struct_info.impls.data[impl_index];
                        }
                    },
                    FunctionParent::Trait(_) => {},
                    FunctionParent::Type(type, impl_index, trait_info2) => {
                        if type.is_fat_pointer() {
                            parent_type = *type.deref_1();
                        } else {
                            parent_type = *type;
                        }

                        trait_info = trait_info2;
                        let context = func_info.context;
                        if context != null {
                            let type_impl = context.root.get_type_impl(type, impl_index);
                            if type_impl != null {
                                trait_impl_info = type_impl.impl_info;
                            }
                        }

                        has_parent = true;
                    },
                }

                if has_parent {
                    if self.naming_ident != null {
                        let parent_type_name = self.naming_ident.get_type_name(&parent_type, type_self, generics_map);
                        result.append_string(&parent_type_name);
                        result.append("__");
                    } else {
                        let parent_type_name = self.get_type_name(&parent_type, type_self, generics_map);
                        result.append_string(&parent_type_name);
                        result.append("__");
                    }
                }

                if trait_info != null {
                    let trait_name = trait_info.name;
                    if trait_name == null { return result; }
                    result.append(trait_name.value);
                    if trait_impl_info != null {
                        match trait_impl_info.trait_type {
                            Type::Trait(ti, tmap) => {
                                if tmap == null { return result; }
                                for (gname, _) in ti.generics.map {
                                    if ti.typedefs.find(&gname) == null {
                                        let gtype = tmap.get(gname);
                                        if gtype != null {
                                            result.append("_");
                                            let gtype_name = self.get_type_name(gtype, type_self, generics_map);
                                            result.append_string(&gtype_name);
                                        }
                                    }
                                }
                            },
                            _ => {},
                        }
                    }
                    result.append("__");
                }

                let func_name = func_info.name;
                if func_name == null { return result; }
                result.append(func_name.value);
                if func_info.generics.array.length > 0 && generics2 != null {
                    let own_generics = Array<Type>::new(self.allocator);
                    for *generic in func_info.generics.array {
                        let generic_name = generic.name;
                        if generic_name == null { continue; }
                        let gtype = generics2.get(generic_name.value);
                        if gtype != null {
                            own_generics.append(*gtype);
                        }
                    }
                    generics = own_generics;
                }
            },
            Type::CoroutineInstance(func_info, generics2) => {
                result.append(self.coroutine_instance_prefix);

                let has_parent = false;
                let parent_type: Type;

                match func_info.parent {
                    FunctionParent::Primitive(primitive, _, _) => {
                        parent_type = Type::Primitive(primitive);
                        has_parent = true;
                    },
                    FunctionParent::Enum(enum_info, _, _) => {
                        parent_type = Type::Enum(enum_info, generics2);
                        has_parent = true;
                    },
                    FunctionParent::Struct(struct_info, _, _) => {
                        parent_type = Type::Struct(struct_info, generics2);
                        has_parent = true;
                    },
                    FunctionParent::Type(type, _, _) => {
                        if type.is_fat_pointer() {
                            parent_type = *type.deref_1();
                        } else {
                            parent_type = *type;
                        }
                        has_parent = true;
                    },
                    _ => {},
                }

                if has_parent {
                    if self.naming_ident != null {
                        let parent_type_name = self.naming_ident.get_type_name(&parent_type, type_self, generics_map);
                        result.append_string(&parent_type_name);
                        result.append("__");
                    } else {
                        let parent_type_name = self.get_type_name(&parent_type, type_self, generics_map);
                        result.append_string(&parent_type_name);
                        result.append("__");
                    }
                }

                let func_name = func_info.name;
                if func_name == null { return result; }
                result.append(func_name.value);
            },
            Type::Self => {
                if type_self.is_self() {
                    result.append("Self");
                    return result;
                }
                match type_self {
                    Type::Function(_, _) => {
                        result.append("Self");
                        return result;
                    },
                    Type::CoroutineInstance(_, _) => {
                        result.append("Self");
                        return result;
                    },
                    _ => {},
                }
                return self.get_type_name(type_self, type_self, generics_map);
            },
            Type::TypedefC(info) => {
                result.append(info.name);
            },
            Type::EnumC(enum_info) => {
                if self.type == NamingType::C99 { result.append("enum "); }
                self.append_cpp_path(&result, enum_info.parent);
                result.append(enum_info.name);
            },
            Type::StructC(struct_info) => {
                if self.type == NamingType::C99 { result.append("struct "); }
                result.append(struct_info.name);
            },
            Type::UnionC(union_info) => {
                if self.type == NamingType::C99 { result.append("union "); }
                result.append(union_info.name);
            },
            Type::ClassCpp(class_info) => {
                self.append_cpp_path(&result, class_info.parent);
                result.append(class_info.name);
            },
            Type::FunctionC(func_info) => {
                result.append(func_info.name);
            },
            Type::NamespaceCpp(namespace_info) => {
                result.append(namespace_info.name);
            },
            Type::Global(g) => {
                result.release();
                return self.get_type_name(&g.type, type_self, generics_map);
            },
            Type::Const(expression) => {
                if self.type == NamingType::Ident {
                    expression.append_ident_name(&result);
                } else {
                    expression.append_display_name(&result);
                }
            },
        }

        if generics.length > 0 {
            result.append(generic_start);

            let first = true;
            for generic in generics {
                if first { first = false; } else { result.append(self.generic_seperator); }

                if self.naming_ident != null {
                    let generic_name = self.naming_ident.get_type_name(generic, type_self, generics_map);            
                    result.append(generic_name.as_str());
                } else {
                    let generic_name = self.get_type_name(generic, type_self, generics_map);            
                    result.append(generic_name.as_str());
                }
            }

            result.append(generic_end);
        }

        return result;
    }
    
    fn get_type_decl(&self, type: &Type, type_self: &Type, generics_map: *GenericMap) -> String {
        match type {
            Type::Function(func_info, func_generics) => {
                let result = String::new(self.allocator);
                result.append("fn(");

                let function_type_self = type_self;
                let function_generics = generics_map;
                let display_generics: GenericMap;
                if func_generics != null {
                    display_generics = func_generics.clone(self.allocator);
                    for generic in func_info.generics.array {
                        let generic_name = generic.name;
                        if generic_name == null { continue; }
                        if !display_generics.has(generic_name.value) {
                            display_generics.insert(generic_name.value, Type::Generic(generic));
                        }
                    }
                    function_generics = &display_generics;
                    if func_generics.self_type != null {
                        function_type_self = func_generics.self_type;
                    }
                }

                let first = true;
                for param in func_info.parameters {
                    if first { first = false; } else { result.append(", "); }
                    let param_name = self.get_type_decl(&param.type, function_type_self, function_generics);
                    result.append_string(&param_name);
                }
                result.append(")");

                let return_name = self.get_type_decl(&func_info.return_type, function_type_self, function_generics);
                if !return_name.as_str().eq("void") {
                    result.append(" -> ");
                    result.append_string(&return_name);
                }

                return result;
            },
            Type::TypedefC(typedef_info) => {
                let result = self.get_variable_decl(typedef_info.name, typedef_info.type, type_self, generics_map);
                result.prepend("typedef ");
                return result;
            },
            _ => {},
        }

        return self.get_type_name(type, type_self, generics_map);
    }

    fn get_variable_decl(&self, variable_name: str, type: &Type, type_self: &Type, generics_map: &GenericMap) -> String {
        match type {
            Type::Function(func_info, _) => {
                let result = self.get_type_name(&func_info.return_type, type_self, generics_map);
                result.append(" (*");
                result.append(variable_name);
                result.append(")(");

                for (i, param) in func_info.parameters.iter().enumerate() {
                    if i > 0 { result.append(", "); }

                    let param_type_name = self.get_type_name(&param.type, type_self, generics_map);
                    result.append_string(&param_type_name);
                    param_type_name.release();
                }

                result.append(")");

                return result;
            },
            _ => {},
        }

        let result = self.get_type_name(type, type_self, generics_map);
        result.append(" ");
        result.append(variable_name);

        return result;
    }

    fn append_decl_suffix(&self, result: &String, type: &Type) {
        match type {
            Type::Sequence(sequence) => {
                match sequence.type {
                    SequenceType::FixedArray(length) => {
                        result.append(self.sequence_open);
                        if self.type == NamingType::Ident {
                            length.append_ident_name(result);
                        } else {
                            length.append_display_name(result);
                        }
                        result.append(self.sequence_close);

                        self.append_decl_suffix(result, &sequence.element);
                    },
                    _ => {},
                }
            },
            _ => {},
        }
    }

    fn append_cpp_path(&self, result: &String, parent: ParentCpp) {
        match parent {
            ParentCpp::None => { return; },
            ParentCpp::Namespace(ns_info) => {
                self.append_cpp_path(result, ns_info.parent);
                result.append(ns_info.name);
                result.append("::");
            },
            ParentCpp::Class(class_info) => {
                self.append_cpp_path(result, class_info.parent);
                result.append(class_info.name);
                result.append("::");
            },
        }
    }
}
