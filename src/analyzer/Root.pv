#include "stdio.h"
#include "string.h"

use std
use types
use c

struct Root {
    allocator: &ArenaAllocator,
    children: HashMap<str, &Namespace>,
    types: HashMap<str, Array<Type>>,
    primitives: HashMap<str, Primitive>,
    ctypes: HashMap<str, TypedefC>,
    traits: HashMap<str, Array<&Trait>>,
    functions: HashMap<str, Type>,
    clang_args: Array<*const char>,
    analysis: &Analysis,
    primitive_bool: *Primitive,
    primitive_usize: *Primitive,
    primitive_void: *Primitive,
    type_void: Type,
    type_bool: Type,
    type_unknown: Type,
    type_self: Type,
    type_ref_self: Type,
    type_usize: Type,
    func_next: Function,
    func_value: Function,
    naming_decl: Naming,
    type_impls: Array<TypeImpl>,
    hack_type_impl: *TypeImpl,
    includes_c: HashMap<str, &Include>,
    includes_cpp: HashMap<str, &Include>,
    mode_cpp: bool,
}

impl Root {
    fn new(allocator: &ArenaAllocator, args: &Array<*const char>, clang_args: &Array<*const char>, analysis: &Analysis) -> &Self {
        let self: &Self = allocator.alloc(sizeof(Self));

        *self = Self {
            allocator,
            children: HashMap<str, &Namespace>::new(allocator),
            types: HashMap<str, Array<Type>>::new(allocator),
            primitives: HashMap<str, Primitive>::new(allocator),
            ctypes: HashMap<str, TypedefC>::new(allocator),
            traits: HashMap<str, Array<&Trait>>::new(allocator),
            functions: HashMap<str, Type>::new(allocator),
            clang_args: Array<*const char>::new(allocator),
            analysis,
            naming_decl: Naming::new_decl(allocator),
            includes_c: HashMap<str, &Include>::new(allocator),
            includes_cpp: HashMap<str, &Include>::new(allocator),
            primitive_bool: null,
            primitive_usize: null,
            primitive_void: null,
            type_void: Type::Primitive(null),
            type_bool: Type::Primitive(null),
            type_unknown: Type::Primitive(null),
            type_self: Type::Primitive(null),
            type_ref_self: Type::Primitive(null),
            type_usize: Type::Primitive(null),
            func_next: Function { name: null, context: null, declaration_start: 0, declaration_end: 0, token_start: 0, token_end: 0, parent: FunctionParent::None, type: FunctionType::Standard, variadic: false, typed_variadic: false, generics: Generics { parent: null, array: Array<Generic> { allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator, buckets: null, data: null, capacity: 0, length: 0 } }, parameters: Array<Parameter> { allocator, data: null, length: 0, capacity: 0 }, return_type: Type::Primitive(null), body: null },
            func_value: Function { name: null, context: null, declaration_start: 0, declaration_end: 0, token_start: 0, token_end: 0, parent: FunctionParent::None, type: FunctionType::Standard, variadic: false, typed_variadic: false, generics: Generics { parent: null, array: Array<Generic> { allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator, buckets: null, data: null, capacity: 0, length: 0 } }, parameters: Array<Parameter> { allocator, data: null, length: 0, capacity: 0 }, return_type: Type::Primitive(null), body: null },
            type_impls: Array<TypeImpl>::new(allocator),
            hack_type_impl: null,
            mode_cpp: false,
        };

        self.primitive_bool = self.add_primitive("bool");
        self.add_primitive("i8");
        self.add_primitive("i16");
        self.add_primitive("i32");
        self.add_primitive("i64");
        self.add_primitive("isize");
        self.add_primitive("u8");
        self.add_primitive("u16");
        self.add_primitive("u32");
        self.add_primitive("u64");
        self.primitive_usize = self.add_primitive("usize");
        self.add_primitive("f32");
        self.add_primitive("f64");
        self.add_primitive("char");
        self.primitive_void = self.add_primitive("void");
        self.type_void = Type::Primitive(self.primitive_void);
        self.type_bool = Type::Primitive(self.primitive_bool);
        let unknown_c = allocator.store(&UnknownC { include: null, name: "unknown", generics: Array<Type> { allocator, data: null, length: 0, capacity: 0 } });
        self.type_unknown = Type::UnknownC(unknown_c);
        self.type_self = Type::Self;
        self.type_ref_self = Type::Indirect(Indirect::new_reference(self.allocator, self.type_self));
        self.type_usize = Type::Primitive(self.primitive_usize);
        self.func_next = Function {
            type: FunctionType::Standard,
            variadic: false,
            typed_variadic: false,
            name: allocator.store(&Token { type: TokenType::Identifier, value: "next", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }),
            parameters: Array<Parameter>::new(allocator),
            return_type: Type::Primitive(self.primitive_bool),
            context: null,
            declaration_start: 0,
            declaration_end: 0,
            token_start: 0,
            token_end: 0,
            parent: FunctionParent::None,
            generics: Generics { parent: null, array: Array<Generic> { allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator, buckets: null, data: null, capacity: 0, length: 0 } },
            body: null,
        };
        self.func_next.parameters.append(Parameter { name: allocator.store(&Token { type: TokenType::Identifier, value: "self", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }), type: self.type_ref_self });

        self.func_value = Function {
            type: FunctionType::Standard,
            variadic: false,
            typed_variadic: false,
            name: allocator.store(&Token { type: TokenType::Identifier, value: "value", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }),
            parameters: Array<Parameter>::new(allocator),
            return_type: Type::Generic(allocator.store(&Generic { name: allocator.store(&Token { type: TokenType::Identifier, value: "T", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }), traits: Array<&Trait> { allocator, data: null, length: 0, capacity: 0 } })),
            context: null,
            declaration_start: 0,
            declaration_end: 0,
            token_start: 0,
            token_end: 0,
            parent: FunctionParent::None,
            generics: Generics { parent: null, array: Array<Generic> { allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator, buckets: null, data: null, capacity: 0, length: 0 } },
            body: null,
        };
        self.func_value.parameters.append(Parameter { name: allocator.store(&Token { type: TokenType::Identifier, value: "self", start_line: 0, start_column: 0, end_line: 0, end_column: 0 }), type: self.type_ref_self });

        for (key, &value) in self.primitives {
            let arr = Array<Type>::new(allocator);
            arr.append(Type::Primitive(value));
            self.types.insert(key, arr);
        }

        for *arg in args {
            let pos: *const char = strchr(arg, '=');

            if pos == null {
                fprintf(stderr, "Unknown arg \"%s\"\n", arg);
            } else {
                let arg_str: str = arg;
                let name = arg_str.slice(0, pos - arg);
                let path: *const char = pos + 1;

                self.add_namespace(name, path);
            }
        }

        for *arg in clang_args {
            self.clang_args.append(arg);
        }

        for (_, child) in self.children {
            child.parse();
        }

        return self;
    }

    fn add_primitive(&self, name: *const char) -> &Primitive {
        return self.primitives.insert(name, Primitive::new(self.allocator, name));
    }

    fn add_ctype(&self, name: *const char) -> &Primitive {
        let existing = self.primitives.find(name);
        if existing != null { return existing; }

        return self.primitives.insert(name, Primitive::new(self.allocator, name));
    }

    fn add_type_impl(&self, type: Type, impl_info: &Impl) -> usize {
        let index = self.type_impls.length;
        self.type_impls.append(TypeImpl::new(self.allocator, type, impl_info, index));
        return index;
    }

    fn get_type_impl(&self, type: &Type, impl_index: usize) -> *TypeImpl {
        let type_impl = self.type_impls.get(impl_index);
        if type_impl == null { return null; }
        if self.type_impl_target_eq(&type_impl.type, type) { return type_impl; }

        return null;
    }

    fn find_type_impl_function(&self, type: &Type, name: str, generic_map: *GenericMap) -> *Function {
        for (impl_index, *type_impl) in self.type_impls.iter().enumerate() {
            if type_impl.impl_info.generics.array.length != 0 { continue; }
            if !self.type_impl_target_eq(&type_impl.type, type) { continue; }

            let function = type_impl.impl_info.find_function(name);
            if function == null { continue; }

            let stored_func_info = self.allocator.store(function);
            if stored_func_info == null { return function; }
            stored_func_info.parent = FunctionParent::Type(&type_impl.type, impl_index, type_impl.impl_info.trait_);
            return stored_func_info;
        }

        return null;
    }

    fn type_impl_target_eq(&self, left: &Type, right: &Type) -> bool {
        match left {
            Type::Primitive(left_primitive) => {
                if left_primitive == null { return false; }
                match right {
                    Type::Primitive(right_primitive) => {
                        if right_primitive == null { return false; }
                        return left_primitive.name.eq(right_primitive.name);
                    },
                    _ => {},
                }
            },
            Type::Indirect(left_indirect) => {
                match right {
                    Type::Indirect(right_indirect) => {
                        if left_indirect.type != right_indirect.type { return false; }
                        return self.type_impl_target_eq(&left_indirect.to, &right_indirect.to);
                    },
                    _ => {},
                }
            },
            Type::Sequence(left_sequence) => {
                match right {
                    Type::Sequence(right_sequence) => {
                        match left_sequence.type {
                            SequenceType::Slice => {
                                match right_sequence.type {
                                    SequenceType::Slice => {},
                                    _ => { return false; },
                                }
                            },
                            SequenceType::FixedArray(_) => {
                                match right_sequence.type {
                                    SequenceType::FixedArray(_) => {},
                                    _ => { return false; },
                                }
                            },
                        }
                        return self.type_impl_target_eq(&left_sequence.element, &right_sequence.element);
                    },
                    _ => {},
                }
            },
            Type::Struct(left_struct, left_generics) => {
                match right {
                    Type::Struct(right_struct, right_generics) => {
                        if left_struct != right_struct { return false; }
                        return self.type_impl_generics_eq(left_generics, right_generics);
                    },
                    _ => {},
                }
            },
            Type::Enum(left_enum, left_generics) => {
                match right {
                    Type::Enum(right_enum, right_generics) => {
                        if left_enum != right_enum { return false; }
                        return self.type_impl_generics_eq(left_generics, right_generics);
                    },
                    _ => {},
                }
            },
            Type::Trait(left_trait, left_generics) => {
                match right {
                    Type::Trait(right_trait, right_generics) => {
                        if left_trait != right_trait { return false; }
                        return self.type_impl_generics_eq(left_generics, right_generics);
                    },
                    _ => {},
                }
            },
            Type::Tuple(left_tuple) => {
                match right {
                    Type::Tuple(right_tuple) => {
                        if left_tuple.elements.length != right_tuple.elements.length { return false; }
                        let i: usize = 0;
                        while i < left_tuple.elements.length {
                            if !self.type_impl_target_eq(&left_tuple.elements.data[i], &right_tuple.elements.data[i]) { return false; }
                            i += 1;
                        }
                        return true;
                    },
                    _ => {},
                }
            },
            Type::TypedefC(left_typedef) => {
                match right {
                    Type::TypedefC(right_typedef) => { return left_typedef.name.eq(right_typedef.name); },
                    _ => { return self.type_impl_target_eq(left_typedef.type, right); },
                }
            },
            Type::EnumC(left_enum) => {
                match right {
                    Type::EnumC(right_enum) => { return left_enum.name.eq(right_enum.name); },
                    _ => {},
                }
            },
            Type::StructC(left_struct) => {
                match right {
                    Type::StructC(right_struct) => { return left_struct.name.eq(right_struct.name); },
                    _ => {},
                }
            },
            Type::UnionC(left_union) => {
                match right {
                    Type::UnionC(right_union) => { return left_union.name.eq(right_union.name); },
                    _ => {},
                }
            },
            _ => {},
        }

        return false;
    }

    fn type_impl_generics_eq(&self, left: *GenericMap, right: *GenericMap) -> bool {
        if left == null || right == null { return left == right; }
        if left.array.length != right.array.length { return false; }
        let i: usize = 0;
        while i < left.array.length {
            if !self.type_impl_target_eq(&left.array.data[i], &right.array.data[i]) { return false; }
            i += 1;
        }
        return true;
    }

    fn add_namespace(&self, name: str, path: str) -> bool {
        let child = Namespace::new(self, null, name, path);
    
        if self.children.find(&name) != null {
            let name_length: u32 = name.length;
            fprintf(stderr, "Duplicate namespace %.*s\n", name_length, name.ptr);

            return false;
        }

        self.children.insert(name, child);
        return true;
    }

    fn find_namespace(&self, name: str) -> *Namespace {
        let result = self.children.find(&name);
        if result == null { return null; }

        return *result;
    }

    fn add_use_namespaces(&self) -> bool {
        for (_, child) in self.children {
            child.add_use_namespaces();
        }

        return true;
    }

    fn fill_namespace(&self) -> bool {
        for (_, child) in self.children {
            child.fill_namespace();
        }

        return true;
    }

    fn prefill_types(&self) -> bool {
        for (_, child) in self.children {
            child.prefill_types();
        }

        return true;
    }

    fn prefill_types_impl(&self) -> bool {
        for (_, child) in self.children {
            child.prefill_types_impl();
        }

        return true;
    }

    fn parse_declarations(&self) -> bool {
        for (_, &primitive_info) in self.primitives {
            for (impl_index, *impl_info) in primitive_info.impls.iter().enumerate() {
                let parent = FunctionParent::Primitive(primitive_info, impl_index, impl_info.trait_);
                impl_info.fill_types(parent);

                for (_, &func_info) in impl_info.functions {
                    func_info.fill_types(&impl_info.generics);
                }
            }
        }

        for (_, child) in self.children {
            child.parse_declarations();
        }

        return true;
    }

    fn parse_globals(&self) -> bool {
        for (_, child) in self.children {
            child.parse_globals();
        }

        return true;
    }

    fn parse_functions(&self) -> bool {
        for (_, child) in self.children {
            child.parse_functions();
        }

        for (_, &primitive_info) in self.primitives {
            for *impl_info in primitive_info.impls {
                impl_info.parse_functions();
            }
        }

        return true;
    }

    fn parse_functions_if_path(&self, path: str) -> bool {
        for (_, child) in self.children {
            child.parse_functions_if_path(path);
        }

        for (_, &primitive_info) in self.primitives {
            for *impl_info in primitive_info.impls {
                if impl_info.context.path.eq(path) {
                    impl_info.parse_functions();
                }
            }
        }

        return true;
    }

    fn find_module_by_path(&self, path: str) -> *Module {
        for (_, child) in self.children {
            let result = child.find_module_by_path(path);
            if result != null { return result; }
        }
        return null;
    }

    fn find_type(&self, name: str, arity: usize) -> *Type {
        let arr = self.types.find(&name);
        if arr == null { return null; }
        let i: usize = 0;
        while i < arr.length {
            if arr.data[i].get_arity() == arity { return &arr.data[i]; }
            i += 1;
        }
        return null;
    }

    fn find_trait(&self, name: str, arity: usize) -> *Trait {
        let arr = self.traits.find(&name);
        if arr == null { return null; }
        let i: usize = 0;
        while i < arr.length {
            let trait_info = arr.data[i];
            if trait_info.generic_arity == arity { return trait_info; }
            i += 1;
        }
        return null;
    }

    fn find_function(&self, name: str) -> *Type {
        return self.functions.find(&name);
    }

    fn find_primitive(&self, name: str) -> *Primitive {
        return self.primitives.find(&name);
    }

    fn error(&self, path: str, start_line: usize, start_column: usize, end_line: usize, end_column: usize, message: *const char) {
        let diagnostics = &self.analysis.diagnostics;
        let file_diagnostics = diagnostics.find(&path);

        let diagnostic = Diagnostic {
            message: message,
            code: str { ptr: null, length: 0 },
            range: Range {
                start: Position {
                    line: start_line,
                    character: start_column,
                },
                end: Position {
                    line: end_line,
                    character: end_column,
                },
            }
        };

        if file_diagnostics == null {
            diagnostics.insert(path, Array<Diagnostic>::new(self.allocator)).append(diagnostic);
            return;
        }

        file_diagnostics.append(diagnostic);
    }

    fn make_type_usage(&self, type: *Type, usage_types: &Array<Type>) -> *Type {
        if type == null { return null; }
        let allocator = self.allocator;

        match type {
            Type::Enum(enum_info, _) => {
                let generics = GenericMap::new(allocator, &enum_info.generics, usage_types);
                let self_type: &Type = allocator.alloc(sizeof(Type));
                generics.self_type = self_type;
                *self_type = Type::Enum(enum_info, allocator.store(&generics));
                return self_type;
            },
            Type::Struct(struct_info, _) => {
                let generics = GenericMap::new(allocator, &struct_info.generics, usage_types);
                let self_type: &Type = allocator.alloc(sizeof(Type));
                generics.self_type = self_type;
                *self_type = Type::Struct(struct_info, allocator.store(&generics));
                return self_type;
            },
            Type::Trait(trait_info, _) => {
                let generics = GenericMap::new(allocator, &trait_info.generics, usage_types);
                let self_type: &Type = allocator.alloc(sizeof(Type));
                generics.self_type = self_type;
                *self_type = Type::Trait(trait_info, allocator.store(&generics));
                return self_type;
            },
            Type::Function(function_info, _) => {
                let generics = GenericMap::new(allocator, &function_info.generics, usage_types);
                let self_type: &Type = allocator.alloc(sizeof(Type));
                generics.self_type = self_type;
                *self_type = Type::Function(function_info, allocator.store(&generics));
                return self_type;
            },
            _ => { return type; }
        }
    }
}
