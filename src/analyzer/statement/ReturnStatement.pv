use std
use analyzer
use expression
use types

struct ReturnStatement {
    expression: *Expression,
}

impl ReturnStatement {
    fn parse(context: &Context, generics: &Generics) -> *ReturnStatement {
        let first_token = context.current();
        if !context.expect_value(TokenType::Keyword, "return") { return null; }

        let function = context.function;
        if function == null { return null; }

        if context.check_next(TokenType::Symbol, ";") {
            if !function.return_type.is_void() {
                context.error_token(first_token, "Return statement is blank but function has a return type");
            }

            return context.allocator.store(&ReturnStatement {
                expression: null,
            });
        }

        let expression = Expression::parse(context, generics);
        if expression == null { return null; }
        if !context.expect_value(TokenType::Symbol, ";") { return null; }

        expression.validate_type(context, &function.return_type, true);

        if function.return_type.is_void() {
            context.error_token(first_token, "Function does not have a return type");
        }

        return context.allocator.store(&ReturnStatement {
            expression,
        });
    }
}
