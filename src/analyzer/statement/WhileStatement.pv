use std
use analyzer
use expression
use types

struct WhileStatement {
    expression: &Expression,
    block: &Block,
}

impl WhileStatement {
    fn parse(context: &Context, generics: &Generics) -> *WhileStatement {
        if !context.expect_value(TokenType::Keyword, "while") { return null; }

        let expression = Expression::parse(context, generics);
        if expression == null { return null; }

        let block = Block::new_ptr(context);
        block.is_loop = true;

        // Apply null-narrowing inside the while body, same rules as `if cond { ... }`.
        let narrowings_true = Array<NullNarrowing>::new(context.allocator);
        Expression::collect_null_narrowings(context, expression, true, &narrowings_true);
        if narrowings_true.length > 0 {
            context.push_scope(block);
            for narrow in narrowings_true { context.set_narrowed(narrow.path, narrow.type); }
            if !block.parse(context, generics, false) { context.pop_scope(); return null; }
            context.pop_scope();
        } else {
            if !block.parse(context, generics, true) { return null; }
        }

        return context.allocator.store(&WhileStatement {
            expression,
            block,
        });
    }
}
