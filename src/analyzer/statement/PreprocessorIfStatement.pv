use std
use analyzer
use types

struct PreprocessorElseIf {
    condition: Array<&Token>,
    block: &Block,
}

struct PreprocessorIfStatement {
    directive: &Token,
    condition: Array<&Token>,
    block: &Block,
    else_ifs: Array<PreprocessorElseIf>,
    else_block: *Block,
}

impl PreprocessorIfStatement {
    fn parse_condition(context: &Context, directive: &Token) -> Array<&Token> {
        let condition = Array<&Token>::new(context.allocator);
        while context.pos < context.length {
            let token = context.current();
            if token == null { return condition; }
            if token.start_line != directive.start_line { break; }
            condition.append(token);
            context.next_token();
        }
        return condition;
    }

    fn validate_condition(context: &Context, directive: &Token, condition: &Array<&Token>) -> bool {
        if condition.length == 0 {
            context.error_token(directive, "Expected preprocessor condition");
            return false;
        }
        if (directive.value.eq("#ifdef") || directive.value.eq("#ifndef")) && (condition.length != 1 || condition.data[0].type != TokenType::Identifier) {
            context.error_token(directive, "Expected one macro identifier");
            return false;
        }
        return true;
    }

    fn parse(context: &Context, generics: &Generics) -> *Self {
        let directive = context.current();
        if directive == null { return null; }
        if !directive.eq(TokenType::Keyword, "#if") && !directive.eq(TokenType::Keyword, "#ifdef") && !directive.eq(TokenType::Keyword, "#ifndef") {
            context.error_token(directive, "Expected #if, #ifdef, or #ifndef");
            return null;
        }
        context.next_token();

        let condition = Self::parse_condition(context, directive);
        if !Self::validate_condition(context, directive, &condition) { return null; }

        let parent_index = context.scopes.length - 1;
        let parent_scope = &context.scopes.data[parent_index];
        let original_values = parent_scope.values.clone(context.allocator);
        let original_narrow_originals = parent_scope.narrow_originals.clone(context.allocator);
        let original_definition_tokens = parent_scope.definition_tokens.clone(context.allocator);

        let block = Block::new_ptr(context);
        let block_scope = block.parse_preprocessor_branch(context, generics);
        if block_scope == null { return null; }
        let branch_scopes = Array<&Scope>::new(context.allocator);
        branch_scopes.append(block_scope);

        // Analysis inside a branch may broaden or otherwise update an outer binding.
        // Restore the exact incoming state before analyzing the next possible branch.
        parent_scope = &context.scopes.data[parent_index];
        parent_scope.values = original_values.clone(context.allocator);
        parent_scope.narrow_originals = original_narrow_originals.clone(context.allocator);
        parent_scope.definition_tokens = original_definition_tokens.clone(context.allocator);

        let else_ifs = Array<PreprocessorElseIf>::new(context.allocator);
        while context.check_value(TokenType::Keyword, "#elif") {
            let elif_token = context.current();
            if elif_token == null { return null; }
            context.next_token();
            let elif_condition = Self::parse_condition(context, elif_token);
            if !Self::validate_condition(context, elif_token, &elif_condition) { return null; }

            let elif_block = Block::new_ptr(context);
            let elif_scope = elif_block.parse_preprocessor_branch(context, generics);
            if elif_scope == null { return null; }
            branch_scopes.append(elif_scope);
            else_ifs.append(PreprocessorElseIf { condition: elif_condition, block: elif_block });

            parent_scope = &context.scopes.data[parent_index];
            parent_scope.values = original_values.clone(context.allocator);
            parent_scope.narrow_originals = original_narrow_originals.clone(context.allocator);
            parent_scope.definition_tokens = original_definition_tokens.clone(context.allocator);
        }

        let else_block: *Block = null;
        let else_scope: *Scope = null;
        if context.check_next(TokenType::Keyword, "#else") {
            let parsed_else_block = Block::new_ptr(context);
            else_scope = parsed_else_block.parse_preprocessor_branch(context, generics);
            if else_scope == null { return null; }
            branch_scopes.append(else_scope);
            else_block = parsed_else_block;
        }

        if !context.expect_value(TokenType::Keyword, "#endif") { return null; }

        parent_scope = &context.scopes.data[parent_index];
        parent_scope.values = original_values.clone(context.allocator);
        parent_scope.narrow_originals = original_narrow_originals.clone(context.allocator);
        parent_scope.definition_tokens = original_definition_tokens.clone(context.allocator);

        // The generated branches deliberately share the surrounding C scope.
        // A branch-local declaration therefore cannot shadow an existing binding.
        for *branch_scope in branch_scopes {
            for (name, _) in branch_scope.values {
                if original_values.find(&name) != null {
                    let token = branch_scope.definition_tokens.find(&name);
                    if token != null { context.error_token(*token, "Conditional declaration cannot shadow an existing variable"); }
                }
            }
        }

        // A missing #else is an implicit empty branch, so it cannot contribute
        // declarations. With an else, promote only the intersection of equal types.
        if else_scope != null {
            for (name, block_type) in block_scope.values {
                let block_type_name = context.root.naming_decl.get_type_decl(&block_type, context.type_self, null);
                let compatible = true;

                for *branch_scope in branch_scopes {
                    let other_type = branch_scope.values.find(&name);
                    if other_type == null {
                        compatible = false;
                        continue;
                    }

                    // Type.eq also answers assignment compatibility. Scope merging
                    // requires the same rendered type on every possible path.
                    let other_type_name = context.root.naming_decl.get_type_decl(other_type, context.type_self, null);
                    if !block_type_name.as_str().eq(other_type_name.as_str()) {
                        let message = String::new(context.allocator);
                        message.append("Conditional declarations disagree for '");
                        message.append(name);
                        message.append("': ");
                        message.append(block_type_name.as_str());
                        message.append(" versus ");
                        message.append(other_type_name.as_str());
                        let token = branch_scope.definition_tokens.find(&name);
                        if token != null { context.error_token(*token, message.c_str()); }
                        else { context.error(message.c_str()); }
                        compatible = false;
                    }
                }

                // Only names newly introduced on every path are structurally promoted.
                if compatible && parent_scope.values.find(&name) == null {
                    let token = block_scope.definition_tokens.find(&name);
                    if token != null { context.set_value(*token, &block_type); }
                }
            }
        }

        let result = Self { directive, condition, block, else_ifs, else_block };
        return context.allocator.store(&result);
    }
}
