use analyzer
use expression
use types

struct YieldStatement {
    expression: *Expression,
}

impl YieldStatement {
    fn parse(context: &Context, generics: &Generics) -> *YieldStatement {
        let keyword = context.current();
        if !context.expect_value(TokenType::Keyword, "yield") { return null; }

        let yielding = context.function;
        if yielding == null || yielding.type != FunctionType::Coroutine {
            context.error_token(keyword, "yield is only for a co function");
            return null;
        }

        if context.check_next(TokenType::Symbol, ";") {
            return context.allocator.store(&YieldStatement { expression: null });
        }

        let expression = Expression::parse(context, generics);
        if expression == null { return null; }
        if !context.expect_value(TokenType::Symbol, ";") { return null; }

        let function = context.function;
        if function == null { return null; }
        expression.validate_type(context, &function.return_type, true);

        return context.allocator.store(&YieldStatement { expression });
    }
}
