use std
use analyzer
use expression
use types

struct DestructureBinding {
    name: &Token,
    type: &Type,
}

struct LetStatement {
    is_static: bool,
    token: &Token,
    name: *Token,
    type: &Type,
    value: *Expression,
    destructure: Array<DestructureBinding>,
}

impl LetStatement {
    fn parse(context: &Context, generics: &Generics) -> *LetStatement {
        let first_token = context.current();
        if !context.expect_value(TokenType::Keyword, "let") { return null; }

        let is_static = context.check_next(TokenType::Keyword, "static");

        if context.check_value(TokenType::Symbol, "(") {
            return Self::parse_destructure(context, generics, first_token, is_static);
        }

        let name = context.expect(TokenType::Identifier);
        if name == null { return null; }

        let type: *Type = null;

        if context.check_next(TokenType::Symbol, ":") {
            type = context.parse_type2(generics);
            if type == null { return null; }
        }

        let expression: *Expression = null;

        if context.check_next(TokenType::Symbol, "=") {
            expression = Expression::parse(context, generics);
            if expression == null { return null; }

            if type == null {
                type = &expression.return_type;

                let type_name = context.root.naming_decl.get_type_decl(type, context.type_self, null);
                type_name.prepend(": ");
                context.inlay_hint(name, type_name.c_str(), InlayHintKind::Type, false, false);
            } else {
                expression.validate_type(context, type, true);
            }
        }

        if !context.set_value(name, type) { context.error("set_value"); return null; }

        // If the initializer is a null-narrowed variable, propagate the broadened original
        // so the new binding can be reassigned to a value of the broader type later.
        if expression != null {
            match expression.data {
                ExpressionData::Variable(src_name) => {
                    let src_original = context.get_broadened_type(src_name);
                    if src_original != null {
                        let scope = context.scopes.back();
                        if scope == null { return null; }
                        scope.narrow_originals.insert(name.value, *src_original);
                    }
                },
                _ => {},
            }
        }

        if !context.expect_value(TokenType::Symbol, ";") { return null; }

        if type == null { return null; }

        if type.is_unknown() {
            context.error_token(first_token, "Let statement is unable to determine it's type, manually specify it");
        }

        if type.is_void() {
            context.error_token(first_token, "Let statement cannot have void type");
        }

        return context.allocator.store(&LetStatement {
            is_static,
            token: first_token,
            name,
            type,
            value: expression,
            destructure: Array<DestructureBinding>::new(context.allocator),
        });
    }

    fn parse_destructure(context: &Context, generics: &Generics, first_token: &Token, is_static: bool) -> *LetStatement {
        if !context.expect_value(TokenType::Symbol, "(") { return null; }

        let names = Array<&Token>::new(context.allocator);
        while !context.check_value(TokenType::Symbol, ")") {
            let name = context.expect(TokenType::Identifier);
            if name == null { return null; }
            names.append(name);

            if !context.check_next(TokenType::Symbol, ",") && !context.check_value(TokenType::Symbol, ")") {
                context.error("Expected , or )");
                return null;
            }
        }
        if !context.expect_value(TokenType::Symbol, ")") { return null; }

        if names.length == 0 {
            context.error_token(first_token, "Destructuring let requires at least one binding");
            return null;
        }

        if !context.expect_value(TokenType::Symbol, "=") { return null; }

        let expression = Expression::parse(context, generics);
        if expression == null { return null; }

        let value_type = &expression.return_type;
        let deref_type = value_type.deref();

        let tuple_ref: &Tuple = context.allocator.store(&Tuple { elements: Array<Type>::new(context.allocator) });
        let is_tuple = false;
        match deref_type {
            Type::Tuple(t) => { tuple_ref = t; is_tuple = true; },
            _ => {},
        }
        if !is_tuple {
            context.error_token(first_token, "Destructuring let requires a tuple value");
            return null;
        }

        if tuple_ref.elements.length != names.length {
            context.error_token(first_token, "Destructuring let arity does not match tuple arity");
            return null;
        }

        let bindings = Array<DestructureBinding>::new(context.allocator);
        let bi: usize = 0;
        while bi < names.length {
            let name_token = names.data[bi];
            let element_type = &tuple_ref.elements.data[bi];
            if !name_token.value.eq("_") {
                if !context.set_value(name_token, element_type) { context.error("set_value"); return null; }
            }
            bindings.append(DestructureBinding { name: name_token, type: element_type });
            bi += 1;
        }

        if !context.expect_value(TokenType::Symbol, ";") { return null; }

        if value_type.is_unknown() {
            context.error_token(first_token, "Let statement is unable to determine it's type, manually specify it");
        }

        return context.allocator.store(&LetStatement {
            is_static,
            token: first_token,
            name: null,
            type: value_type,
            value: expression,
            destructure: bindings,
        });
    }
}
