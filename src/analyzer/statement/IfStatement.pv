use std
use analyzer
use expression
use types

struct IfStatement {
    pattern: *MatchPattern,
    expression: *Expression,
    block: *Block,
    else_statements: Array<ElseStatement>,
}

impl IfStatement {
    // If `expr` is a null-comparison `var == null` / `null == var` (when narrow_on_true=false)
    // or `var != null` / `null != var` (when narrow_on_true=true) where `var` has pointer type,
    // returns (variable_name, narrowed &T reference type). Otherwise returns null.
    fn detect_null_narrowing(context: &Context, expr: &Expression, narrow_on_true: bool) -> *Type {
        let inner = expr;
        match inner.data {
            ExpressionData::ParenthesizedExpression(child) => { inner = child; },
            _ => {},
        }

        match inner.data {
            ExpressionData::BinaryExpression(lhs, op, rhs) => {
                let want_op: str = if narrow_on_true { "!=" } else { "==" };
                if !op.eq(want_op) { return null; }

                let var_expr: *Expression = null;
                let other: *Expression = null;

                match lhs.data {
                    ExpressionData::Variable(_) => { var_expr = lhs; other = rhs; },
                    _ => {},
                }

                if var_expr == null {
                    match rhs.data {
                        ExpressionData::Variable(_) => { var_expr = rhs; other = lhs; },
                        _ => { return null; },
                    }
                }

                let other_inner = other;
                match other_inner.data {
                    ExpressionData::ParenthesizedExpression(c) => { other_inner = c; },
                    _ => {},
                }

                match other_inner.data {
                    ExpressionData::NullLiteral => {},
                    _ => { return null; },
                }

                match var_expr.return_type {
                    Type::Indirect(indirect) => {
                        if indirect.type != IndirectType::Pointer && indirect.type != IndirectType::ConstPointer {
                            return null;
                        }
                        let ref_indirect = Indirect::new_reference(context.allocator, indirect.to);
                        return context.allocator.store(&Type::Indirect(ref_indirect));
                    },
                    _ => { return null; },
                }
            },
            _ => { return null; },
        }

        return null;
    }

    fn block_always_diverges(block: &Block) -> bool {
        if block.statements.length == 0 { return false; }
        let last = &block.statements.data[block.statements.length - 1];
        match last.data {
            StatementData::ReturnStatement(_) => { return true; },
            StatementData::BreakStatement(_) => { return true; },
            StatementData::ContinueStatement(_) => { return true; },
            _ => { return false; },
        }
    }

    fn narrowed_var_name(expr: &Expression) -> str {
        let inner = expr;
        match inner.data {
            ExpressionData::ParenthesizedExpression(child) => { inner = child; },
            _ => {},
        }
        match inner.data {
            ExpressionData::BinaryExpression(lhs, _, rhs) => {
                match lhs.data {
                    ExpressionData::Variable(name) => { return name; },
                    _ => {},
                }
                match rhs.data {
                    ExpressionData::Variable(name) => { return name; },
                    _ => {},
                }
            },
            _ => {},
        }
        return str { ptr: null, length: 0 };
    }

    fn parse(context: &Context, generics: &Generics) -> *IfStatement {
        if !context.expect_value(TokenType::Keyword, "if") { return null; }

        let pattern: *MatchPattern = null;
        let expression: *Expression = null;
        let block = Block::new_ptr(context);

        if context.check_next(TokenType::Keyword, "let") {
            context.push_scope(block);
            let p: MatchPattern = MatchPattern::Default;
            if !MatchPattern::parse(context, generics, &p) { context.pop_scope(); return null; }
            if !context.expect_value(TokenType::Symbol, "=") { context.pop_scope(); return null; }
            pattern = context.allocator.store(&p);
            expression = Expression::parse(context, generics);
            if expression == null { context.pop_scope(); return null; }
            match p {
                MatchPattern::EnumVariant(enum_type, _, _) => {
                    if !expression.return_type.deref().eq(enum_type) {
                        context.error_token(expression.token, "If let expression type does not match pattern enum type");
                        context.pop_scope();
                        return null;
                    }
                },
                _ => {
                    if !expression.return_type.deref().is_discriminated_union() {
                        context.error_token(expression.token, "If let expression must be an enum (discriminated union)");
                        context.pop_scope();
                        return null;
                    }
                },
            }
            if !block.parse(context, generics, false) { context.pop_scope(); return null; }
            context.pop_scope();
        } else {
            expression = Expression::parse(context, generics);
            if expression == null { return null; }
            match expression.return_type {
                Type::Primitive(prim) => {
                    if !prim.name.eq("bool") {
                        context.error_token(expression.token, "If condition must be a bool expression");
                        return null;
                    }
                },
                _ => {
                    context.error_token(expression.token, "If condition must be a bool expression");
                    return null;
                },
            }

            let narrow_true = IfStatement::detect_null_narrowing(context, expression, true);
            if narrow_true != null {
                let var_name = IfStatement::narrowed_var_name(expression);
                context.push_scope(block);
                context.set_narrowed(var_name, narrow_true);
                if !block.parse(context, generics, false) { context.pop_scope(); return null; }
                context.pop_scope();
            } else {
                if !block.parse(context, generics, true) { return null; }
            }
        }

        let else_statements = Array<ElseStatement>::new(context.allocator);
        let else_expression: *Expression = null;
        let else_pattern: *MatchPattern = null;
        let else_block: *Block = null;
        let else_end = false;

        while !else_end && context.check_next(TokenType::Keyword, "else") {
            else_expression = null;
            else_pattern = null;

            if context.check_next(TokenType::Keyword, "if") {
                if context.check_next(TokenType::Keyword, "let") {
                    else_block = Block::new_ptr(context);
                    context.push_scope(else_block);
                    let ep: MatchPattern = MatchPattern::Default;
                    if !MatchPattern::parse(context, generics, &ep) { context.pop_scope(); return null; }
                    if !context.expect_value(TokenType::Symbol, "=") { context.pop_scope(); return null; }
                    else_pattern = context.allocator.store(&ep);
                    else_expression = Expression::parse(context, generics);
                    if else_expression == null { context.pop_scope(); return null; }
                    match ep {
                        MatchPattern::EnumVariant(enum_type, _, _) => {
                            if !else_expression.return_type.eq(enum_type) {
                                context.error_token(else_expression.token, "If let expression type does not match pattern enum type");
                                context.pop_scope();
                                return null;
                            }
                        },
                        _ => {
                            if !else_expression.return_type.is_enum() {
                                context.error_token(else_expression.token, "If let expression must be an enum (discriminated union)");
                                context.pop_scope();
                                return null;
                            }
                        },
                    }
                    if !else_block.parse(context, generics, false) { context.pop_scope(); return null; }
                    context.pop_scope();
                } else {
                    else_expression = Expression::parse(context, generics);
                    if else_expression == null { return null; }
                    match else_expression.return_type {
                        Type::Primitive(prim) => {
                            if !prim.name.eq("bool") {
                                context.error_token(else_expression.token, "If condition must be a bool expression");
                                return null;
                            }
                        },
                        _ => {
                            context.error_token(else_expression.token, "If condition must be a bool expression");
                            return null;
                        },
                    }
                    else_block = Block::new_ptr(context);
                    if !else_block.parse(context, generics, true) { return null; }
                }
            } else {
                else_end = true;
                else_block = Block::new_ptr(context);

                let narrow_false: *Type = null;
                if pattern == null && expression != null {
                    narrow_false = IfStatement::detect_null_narrowing(context, expression, false);
                }

                if narrow_false != null {
                    let var_name = IfStatement::narrowed_var_name(expression);
                    context.push_scope(else_block);
                    context.set_narrowed(var_name, narrow_false);
                    if !else_block.parse(context, generics, false) { context.pop_scope(); return null; }
                    context.pop_scope();
                } else {
                    if !else_block.parse(context, generics, true) { return null; }
                }
            }

            else_statements.append(ElseStatement {
                pattern: else_pattern,
                expression: else_expression,
                block: else_block,
            });
        }

        if pattern == null && expression != null && else_statements.length == 0 {
            if IfStatement::block_always_diverges(block) {
                let narrow_after = IfStatement::detect_null_narrowing(context, expression, false);
                if narrow_after != null {
                    let var_name = IfStatement::narrowed_var_name(expression);
                    context.set_narrowed(var_name, narrow_after);
                }
            }
        }

        return context.allocator.store(&IfStatement {
            pattern,
            expression,
            block,
            else_statements,
        });
    }
}
