use std
use types

struct Scope {
    values: HashMap<str, Type>,
    narrow_originals: HashMap<str, Type>,
    definition_tokens: HashMap<str, &Token>,
    block: *Block,
}

impl Scope {
    fn new(allocator: &ArenaAllocator, block: *Block) -> Self {
        return Self {
            values: HashMap<str, Type>::new(allocator),
            narrow_originals: HashMap<str, Type>::new(allocator),
            definition_tokens: HashMap<str, &Token>::new(allocator),
            block,
        };
    }
}
