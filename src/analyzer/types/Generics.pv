use std
use analyzer

struct Generic {
    name: *Token,
    traits: Array<Type>,
    const_type: *Type,
}

impl Generic {
    fn new(allocator: &dyn Allocator) -> Self {
        return Self { name: null, traits: Array<Type>::new(allocator), const_type: null };
    }

    fn is_const(&self) -> bool {
        return self.const_type != null;
    }

    fn parse_const_type(&self, context: &Context, generics: &Generics) -> bool {
        if !context.expect_value(TokenType::Symbol, ":") { return false; }

        let type_token = context.current();
        if type_token == null { return false; }

        let const_type: Type;
        if !context.parse_type(&const_type, generics) { return false; }

        let is_integer = false;
        match const_type {
            Type::Primitive(primitive_info) => {
                if primitive_info != null {
                    is_integer = primitive_info.is_number()
                        && !primitive_info.name.eq("f32")
                        && !primitive_info.name.eq("f64");
                }
            },
            _ => {},
        }

        if !is_integer {
            context.error_token(type_token, "Const generic type must be an integer primitive");
            return false;
        }

        self.const_type = context.allocator.store(&const_type);

        return self.const_type != null;
    }

    fn parse_traits(&self, context: &Context, generics: &Generics) -> bool {
        let module: &Module = context.module;

        if context.check_next(TokenType::Symbol, ":") {
            let has_more = true;
            while has_more {
                let name = context.expect(TokenType::Identifier);
                if name == null { return false; }

                let usage_types = Array<Type>::new(context.allocator);
                if context.check_next(TokenType::Symbol, "<") {
                    while !context.check_next(TokenType::Symbol, ">") {
                        let usage_type: Type;
                        if !context.parse_type(&usage_type, generics) { return false; }
                        usage_types.append(usage_type);

                        if !context.check_next(TokenType::Symbol, ",") && !context.check_value(TokenType::Symbol, ">") {
                            context.error("Expected , or >");
                            return false;
                        }
                    }
                }

                let trait_info = module.find_trait(name.value, usage_types.length);
                if trait_info == null { context.error_token(name, "Unable to find trait"); return false; }
                let generic_map = GenericMap::new(context.allocator, &trait_info.generics, &usage_types);
                self.traits.append(Type::Trait(trait_info, context.allocator.store(&generic_map)));

                has_more = context.check_next(TokenType::Symbol, "+");
            }
        }

        return true;
    }
}

struct Generics {
    parent: *Generics,
    array: Array<Generic>,
    map: HashMap<str, usize>,
}

impl Generics {
    fn new(allocator: &dyn Allocator) -> Self {
        return Self {
            parent: null,
            array: Array<Generic>::new(allocator),
            map: HashMap<str, usize>::new(allocator),
        };
    }

    fn has(&self, name: str) -> bool {
        if self.map.find(&name) != null { return true; }
        if self.parent != null && self.parent.has(name) { return true; }

        return false;
    }

    fn find(&self, name: str) -> *Generic {
        let index_ptr = self.map.find(&name);
        if index_ptr != null {
            let index = *index_ptr;
            return self.array.data + index;
        }

        if self.parent != null { return self.parent.find(name); }

        return null;
    }

    fn parse(&self, context: &Context) -> bool {
        if !context.expect_value(TokenType::Symbol, "<") { return false; }

        while !context.check_next(TokenType::Symbol, ">") {
            let generic = Generic::new(self.array.allocator);
            let is_const = context.check_next(TokenType::Keyword, "const");
            generic.name = context.expect(TokenType::Identifier);
            let generic_name = generic.name;
            if generic_name == null || self.has(generic_name.value) { return false; }

            let index = self.array.append(generic);
            self.map.insert(generic_name.value, index);
            let stored_generic = self.array.get(index);
            if stored_generic == null { return false; }

            if is_const {
                if !stored_generic.parse_const_type(context, self) { return false; }
            } else {
                if !stored_generic.parse_traits(context, self) { return false; }
            }

            if !context.check_next(TokenType::Symbol, ",") {
                return context.expect_value(TokenType::Symbol, ">");
            }
        }

        if !context.expect_value(TokenType::Symbol, ">") { return false; }

        return true;
    }

    fn is_empty(&self) -> bool {
        return self.array.length == 0;
    }
}
