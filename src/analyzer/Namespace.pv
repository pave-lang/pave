#include "fs.h"

use std
use types

struct Namespace {
    root: &Root,
    parent: *Namespace,
    name: str,
    path: str,
    children: HashMap<str, &Namespace>,
    modules: HashMap<str, &Module>,
    types: HashMap<str, Array<Type>>,
    traits: HashMap<str, Array<&Trait>>,
    functions: HashMap<str, Type>,
}

impl Namespace {
    fn new(root: &Root, parent: *Namespace, name: str, path: str) -> &Self {
        let allocator = root.allocator;
        let self: &Self = allocator.alloc(sizeof(Self));

        *self = Self {
            root,
            parent,
            name,
            path,
            children: HashMap<str, &Namespace>::new(allocator),
            modules: HashMap<str, &Module>::new(allocator),
            types: HashMap<str, Array<Type>>::new(allocator),
            traits: HashMap<str, Array<&Trait>>::new(allocator),
            functions: HashMap<str, Type>::new(allocator),
        };

        return self;
    }

    fn add_type(&self, name: str, type: Type) -> bool {
        let arr = self.types.find(&name);
        if arr == null {
            let new_arr = Array<Type>::new(self.root.allocator);
            new_arr.append(type);
            self.types.insert(name, new_arr);
        } else {
            let arity = type.get_arity();
            let i: usize = 0;
            while i < arr.length {
                if arr.data[i].get_arity() == arity { return false; }
                i += 1;
            }
            arr.append(type);
        }
        return true;
    }

    fn add_trait(&self, name: str, trait_info: &Trait) -> bool {
        let arr = self.traits.find(&name);
        if arr == null {
            let new_arr = Array<&Trait>::new(self.root.allocator);
            new_arr.append(trait_info);
            self.traits.insert(name, new_arr);
        } else {
            let i: usize = 0;
            while i < arr.length {
                if arr.data[i].generic_arity == trait_info.generic_arity { return false; }
                i += 1;
            }
            arr.append(trait_info);
        }
        return true;
    }

    fn parse(&self) -> bool {
        return self.add_module("ns");
    }

    fn add_namespace(&self, name: str, path: str) -> bool {
        let child = Namespace::new(self.root, self, name, path);
        self.children.insert(name, child);
        return child.parse();
    }

    fn add_namespace_subfolder(&self, name: str) -> bool {
        let path = String::new(self.root.allocator);
        path.append(self.path);
        path.append("/");
        path.append(name);
        return self.add_namespace(name, path.as_str());
    }

    fn find_namespace(&self, name: str) -> *Namespace {
        let child = self.children.find(&name);
        if child != null { return *child; }

        if self.parent != null {
            return self.parent.find_namespace(name);
        } else {
            return self.root.find_namespace(name);
        }
    }

    fn add_module(&self, name: str) -> bool {
        if self.modules.find(&name) != null {
            return true;
        }

        let path = String::new(self.root.allocator);
        path.append(self.path);
        path.append("/");
        path.append(name);
        path.append(".pave");

        if path_exists(path.c_str()) == 0 {
            path.array.length -= 5;
            path.append(".pv");
        }

        let module = Module::new(self, path.as_str());
        self.modules.insert(name, module);
        return module.parse();
    }

    fn add_use_namespaces(&self) -> bool {
        for (_, module) in self.modules {
            module.add_use_namespaces();
        }

        for (_, child) in self.children {
            child.add_use_namespaces();
        }

        return true;
    }

    fn fill_namespace(&self) -> bool {
        let success = true;

        for (_, child) in self.children {
            success = child.fill_namespace() && success;
        }

        for (_, module) in self.modules {
            success = module.fill_namespace() && success;
        }

        return success;
    }

    fn prefill_types(&self) -> bool {
        for (_, child) in self.children {
            child.prefill_types();
        }

        for (_, module) in self.modules {
            module.prefill_types();
        }

        return true;
    }

    fn prefill_types_impl(&self) -> bool {
        for (_, child) in self.children {
            child.prefill_types_impl();
        }

        for (_, module) in self.modules {
            module.prefill_types_impl();
        }

        return true;
    }

    fn parse_declarations(&self) -> bool {
        for (_, module) in self.modules {
            module.parse_declarations();
        }

        for (_, child) in self.children {
            child.parse_declarations();
        }

        return true;
    }

    fn parse_globals(&self) -> bool {
        for (_, module) in self.modules {
            module.parse_globals();
        }

        for (_, child) in self.children {
            child.parse_globals();
        }

        return true;
    }

    fn parse_functions(&self) -> bool {
        for (_, module) in self.modules {
            module.parse_functions();
        }

        for (_, child) in self.children {
            child.parse_functions();
        }

        return true;
    }

    fn parse_functions_if_path(&self, path: str) -> bool {
        for (_, module) in self.modules {
            module.parse_functions_if_path(path);
        }

        for (_, child) in self.children {
            child.parse_functions_if_path(path);
        }

        return true;
    }

    fn find_module_by_path(&self, path: str) -> *Module {
        for (_, module) in self.modules {
            if module.path.eq(path) { return module; }
        }
        for (_, child) in self.children {
            let result = child.find_module_by_path(path);
            if result != null { return result; }
        }
        return null;
    }

    fn find_type(&self, name: str, arity: usize) -> *Type {
        let arr = self.types.find(&name);
        if arr == null { return null; }
        let i: usize = 0;
        while i < arr.length {
            if arr.data[i].get_arity() == arity { return &arr.data[i]; }
            i += 1;
        }
        return null;
    }

    fn find_trait(&self, name: str, arity: usize) -> *Trait {
        let arr = self.traits.find(&name);
        if arr == null { return null; }
        let i: usize = 0;
        while i < arr.length {
            let trait_info = arr.data[i];
            if trait_info.generic_arity == arity { return trait_info; }
            i += 1;
        }
        return null;
    }

    fn find_function(&self, name: str) -> *Type {
        return self.functions.find(&name);
    }
}
