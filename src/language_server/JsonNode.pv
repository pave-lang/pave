#include "math.h"
#include "stdio.h"

use std

enum JsonNode {
    Array(Array<JsonNode>),
    Object(HashMap<str, JsonNode>),
    Number(f64),
    String(str),
    Boolean(bool),
    Null,
    Undefined,
}

impl JsonNode {
    const UNDEFINED = JsonNode::Undefined;
    const NULL = JsonNode::Null;

    fn is_array(&self) -> bool {
        match self {
            JsonNode::Array(_) => { return true; },
            _ => { return false; },
        }
    }

    fn is_object(&self) -> bool {
        match self {
            JsonNode::Object(_) => { return true; },
            _ => { return false; },
        }
    }

    fn key(&self, key: str) -> &JsonNode {
        match self {
            JsonNode::Object(&object) => {
                let result = object.find(&key);
                if result != null { return result; }
            },
            _ => {},
        }

        return &JsonNode::UNDEFINED;
    }

    fn index(&self, i: usize) -> &JsonNode {
        match self {
            JsonNode::Array(&array) => {
                if i < array.length { return array.data + i; }
            },
            _ => {},
        }
        return &JsonNode::UNDEFINED;
    }

    fn array(&self) -> *Array<JsonNode> {
        match self {
            JsonNode::Array(&value) => {
                return value;
            },
            _ => {},
        }
        return null;
    }

    fn object(&self) -> *HashMap<str, JsonNode> {
        match self {
            JsonNode::Object(&value) => {
                return value;
            },
            _ => {},
        }
        return null;
    }

    fn string(&self) -> str {
        match self {
            JsonNode::String(value) => {
                return value;
            },
            _ => {},
        }
        return str { ptr: null, length: 0 };
    }

    fn number(&self) -> f64 {
        match self {
            JsonNode::Number(value) => {
                return value;
            },
            _ => {},
        }
        return NAN;
    }

    fn to_string(&self, allocator: &ArenaAllocator) -> String {
        let result = String::new(allocator);
        self.append_to(&result);
        return result;
    }

    fn append_to(&self, result: &String) {
        match self {
            JsonNode::Array(array) => {
                result.append("[");

                let first = true;
                for node in array {
                    if first { first = false; } else { result.append(","); }
                    node.append_to(result);
                }

                result.append("]");
            },
            JsonNode::Object(object) => {
                result.append("{");

                let first = true;
                for (key, &value) in object {
                    if first { first = false; } else { result.append(","); }

                    self.append_string(result, key);
                    result.append(":");
                    value.append_to(result);
                }

                result.append("}");
            },
            JsonNode::Number(value) => {
                JsonNode::append_number(result, value);
            },
            JsonNode::String(value) => {
                self.append_string(result, value);
            },
            JsonNode::Boolean(value) => {
                if value { result.append("true"); }
                else { result.append("false"); }
            },
            JsonNode::Null => {
                result.append("null");
            },
            JsonNode::Undefined => {
                result.append("null");
            },
        }
    }

    // A whole number is written in full, so that an id or a position comes
    // back as it was sent; JSON has no NaN or infinity.
    fn append_number(result: &String, value: f64) {
        if value != value || value - value != 0 {
            result.append("null");
            return;
        }

        let array: &Array<char> = &result.array;
        result.ensure_can_hold(32);

        if value == floor(value) && fabs(value) < 9007199254740992.0 {
            array.length += snprintf(array.data + array.length, 32, "%.0f", value);
        } else {
            array.length += snprintf(array.data + array.length, 32, "%.17g", value);
        }
    }

    fn append_string(&self, result: &String, value: str) {
        result.append("\"");

        let pos: usize = 0;
        let start: usize = 0;
        while pos < value.length {
            let c = value.ptr[pos];
            pos += 1;

            // Unsigned, so a byte of a UTF-8 character isn't taken for a control character.
            let byte: u32 = cast<u8>(c);
            if c != '\\' && c != '"' && byte >= 32 { continue; }

            result.append(value.slice(start, pos - 1));
            start = pos;

            if c == '\\' { result.append("\\\\"); }
            else if c == '"' { result.append("\\\""); }
            else if c == '\n' { result.append("\\n"); }
            else if c == '\r' { result.append("\\r"); }
            else if c == '\t' { result.append("\\t"); }
            else {
                let array: &Array<char> = &result.array;
                result.ensure_can_hold(8);
                array.length += snprintf(array.data + array.length, 8, "\\u%04x", byte);
            }
        }

        result.append(value.slice(start, pos));

        result.append("\"");
    }
}
