use std

fn main(argc: i32, argv: **const char) -> i32 {
    let allocator_ptr = ArenaAllocator::new(GeneralPurposeAllocator::default(), 5 * 1024 * 1024);
    if allocator_ptr == null { return 1; }
    let allocator: &ArenaAllocator = allocator_ptr;
    let args = Array<*const char> { data: argv, length: argc, allocator, capacity: 0 };

    let ls = LanguageServer::new(allocator, &args);
    if ls == null { return 1; }
    defer ls.destroy();

    return ls.run();
}
