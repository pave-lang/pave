    fn did_change_configuration(&self, ls: &LanguageServer, params: &JsonNode) -> bool {
        let settings = params.key("settings").key("pave");
        let args = settings.key("args").array();
        let clang_args = settings.key("clang_args").array();

        ls.args.clear();
        if args != null {
            for *arg in args {
                let arg_string = arg.string();
                let copy: *char = ls.allocator.alloc(arg_string.length + 1);
                memcpy(copy, arg_string.ptr, arg_string.length);
                ls.args.append(copy);
            }
        }

        ls.clang_args.clear();
        if clang_args != null {
            for *arg in clang_args {
                let arg_string = arg.string();
                let copy: *char = ls.allocator.alloc(arg_string.length + 1);
                memcpy(copy, arg_string.ptr, arg_string.length);
                ls.clang_args.append(copy);
            }
        }

        let analysis = ls.analyze();
        self.publish_diagnostics(analysis);
        self.inlay_hint_refresh();

        return true;
    }

    fn publish_diagnostics(&self, analysis: &Analysis) {
        let blank_diagnostics = Array<Diagnostic> { allocator: self.allocator, data: null, length: 0, capacity: 0 };

        for (filename, _) in analysis.files {
            if analysis.diagnostics.find(&filename) == null {
                self.publish_diagnostics_file(filename, &blank_diagnostics);
            }
        }

        for (filename, &analysis_diagnostics) in analysis.diagnostics {
            self.publish_diagnostics_file(filename, analysis_diagnostics);
        }        
    }

    fn publish_diagnostics_file(&self, filename: str, analysis_diagnostics: &Array<Diagnostic>) {
        let source = JsonNode::String("pave");
        let params = HashMap<str, JsonNode>::new(self.allocator);

        let uri = Uri::file(self.allocator, filename);

        params.insert("uri", JsonNode::String(uri));
        let diagnostics = Array<JsonNode>::new(self.allocator);

        for diagnostic in analysis_diagnostics {
            let entry = HashMap<str, JsonNode>::new(self.allocator);
            let range = HashMap<str, JsonNode>::new(self.allocator);

            let start = HashMap<str, JsonNode>::new(self.allocator);
            start.insert("line", JsonNode::Number(diagnostic.range.start.line));
            start.insert("character", JsonNode::Number(diagnostic.range.start.character));
            range.insert("start", JsonNode::Object(start));

            let end = HashMap<str, JsonNode>::new(self.allocator);
            end.insert("line", JsonNode::Number(diagnostic.range.end.line));
            end.insert("character", JsonNode::Number(diagnostic.range.end.character));
            range.insert("end", JsonNode::Object(end));

            entry.insert("range", JsonNode::Object(range));
            entry.insert("severity", JsonNode::Number(1));
            entry.insert("source", source);
            entry.insert("message", JsonNode::String(diagnostic.message));

            diagnostics.append(JsonNode::Object(entry));
        }

        params.insert("diagnostics", JsonNode::Array(diagnostics));

        self.send_message("textDocument/publishDiagnostics", JsonNode::Object(params));
    }

    fn did_change(&self, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        if uri.length == 0 { return; }
        let filename = ls.file_map.find(&uri);
        if filename == null { return; }
        let filename_copy = String::new(self.allocator);
        filename_copy.append(*filename);
        let filename_str = filename_copy.as_str();

        ls.set_dirty_uri(uri, true);

        let content_changes = params.key("contentChanges").array();
        if content_changes != null && content_changes.length > 0 {
            let latest_change = content_changes.back();
            if latest_change != null {
                let latest_text = latest_change.key("text").string();
                ls.set_override_file(filename_str, latest_text);
            }
        }

        let analysis = ls.analyze_file(filename_str);
        let diagnostics = analysis.diagnostics.find(&filename_str);

        let blank_diagnostics = Array<Diagnostic> { allocator: self.allocator, data: null, length: 0, capacity: 0 };
        if diagnostics == null { self.publish_diagnostics_file(filename_str, &blank_diagnostics); }
        else { self.publish_diagnostics_file(filename_str, diagnostics); }
    }

    fn did_open(&self, ls: &LanguageServer, params: &JsonNode) {
        let text_document = params.key("textDocument");
        let uri = text_document.key("uri").string();
        if uri.length == 0 { return; }

        let text = text_document.key("text").string();

        // Ensure we have an initial analysis for the file_map
        if ls.root == null { ls.analyze(); }
        let filename = ls.file_map.find(&uri);
        if filename == null {
            let fallback_path = Uri::path(self.allocator, uri);
            if fallback_path.length == 0 { return; }
            ls.set_override_file(fallback_path, text);
            ls.set_dirty_uri(uri, true);
            return;
        }

        let filename_copy = String::new(self.allocator);
        filename_copy.append(*filename);
        let filename_str = filename_copy.as_str();

        ls.set_override_file(filename_str, text);
        ls.set_dirty_uri(uri, true);

        let analysis = ls.analyze_file(filename_str);
        let diagnostics = analysis.diagnostics.find(&filename_str);

        let blank_diagnostics = Array<Diagnostic> { allocator: self.allocator, data: null, length: 0, capacity: 0 };
        if diagnostics == null { self.publish_diagnostics_file(filename_str, &blank_diagnostics); }
        else { self.publish_diagnostics_file(filename_str, diagnostics); }
    }

    fn did_close(&self, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        if uri.length == 0 { return; }

        let filename = ls.file_map.find(&uri);
        if filename != null {
            ls.clear_override_file(*filename);
        } else {
            let fallback_path = Uri::path(self.allocator, uri);
            if fallback_path.length > 0 {
                ls.clear_override_file(fallback_path);
            }
        }

        ls.set_dirty_uri(uri, false);
    }

    fn inlay_hint(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        if uri.length == 0 {
            self.send_response(id, JsonNode::Array(Array<JsonNode>::new(self.allocator)));
            return;
        }
        let range = params.key("range");
        let start_line = range.key("start").key("line").number();
        let start_character = range.key("start").key("character").number();
        let end_line = range.key("end").key("line").number();
        let end_character = range.key("end").key("character").number();

        let filename = ls.file_map.find(&uri);
        if filename == null {
            self.send_response(id, JsonNode::Array(Array<JsonNode>::new(self.allocator)));
            return;
        }

        // If there are diagnostics for this file, don't respond — the client
        // keeps showing the last good hints until the file is error-free again.
        let file_diagnostics = ls.analysis.diagnostics.find(filename);
        if file_diagnostics != null && file_diagnostics.length > 0 {
            return;
        }

        ls.parse_functions_file(*filename);

        let inlay_hints = ls.analysis.inlay_hints.find(filename);
        if inlay_hints == null {
            self.send_response(id, JsonNode::Array(Array<JsonNode>::new(self.allocator)));
            return;
        }

        let result = Array<JsonNode>::new(self.allocator);

        for inlay_hint in inlay_hints {
            let hint_line = inlay_hint.position.line;
            let hint_character = inlay_hint.position.character;
            let before_start = hint_line < start_line || (hint_line == start_line && hint_character < start_character);
            if before_start { continue; }
            let after_end = hint_line > end_line || (hint_line == end_line && hint_character > end_character);
            if after_end { continue; }

            let item = HashMap<str, JsonNode>::new(self.allocator);

            let position = HashMap<str, JsonNode>::new(self.allocator);
            position.insert("line", JsonNode::Number(inlay_hint.position.line));
            position.insert("character", JsonNode::Number(inlay_hint.position.character));
            item.insert("position", JsonNode::Object(position));

            item.insert("label", JsonNode::String(inlay_hint.label));

            match inlay_hint.kind {
                InlayHintKind::Type => { item.insert("kind", JsonNode::Number(1)); },
                InlayHintKind::Parameter => { item.insert("kind", JsonNode::Number(2)); },
                InlayHintKind::Unknown => { item.insert("kind", JsonNode::Number(0)); },
            }

            item.insert("padding_left", JsonNode::Boolean(inlay_hint.padding_left));
            item.insert("padding_right", JsonNode::Boolean(inlay_hint.padding_right));

            result.append(JsonNode::Object(item));
        }

        self.send_response(id, JsonNode::Array(result));
    }

    fn inlay_hint_refresh(&self) {
        self.send_message_no_params("workspace/inlayHint/refresh");
    }

    fn find_symbol_at(&self, symbols: *Array<SymbolInfo>, line: usize, character: usize) -> *SymbolInfo {
        if symbols == null { return null; }

        for symbol in symbols {
            let before_start = line < symbol.range.start.line || (line == symbol.range.start.line && character < symbol.range.start.character);
            if before_start { continue; }
            let after_end = line > symbol.range.end.line || (line == symbol.range.end.line && character >= symbol.range.end.character);
            if after_end { continue; }
            return symbol;
        }

        return null;
    }

    fn make_position_json(&self, line: usize, character: usize) -> JsonNode {
        let pos = HashMap<str, JsonNode>::new(self.allocator);
        pos.insert("line", JsonNode::Number(line));
        pos.insert("character", JsonNode::Number(character));
        return JsonNode::Object(pos);
    }

    fn make_range_json(&self, range: &Range) -> JsonNode {
        let r = HashMap<str, JsonNode>::new(self.allocator);
        r.insert("start", self.make_position_json(range.start.line, range.start.character));
        r.insert("end", self.make_position_json(range.end.line, range.end.character));
        return JsonNode::Object(r);
    }

    fn make_token_range(&self, token: &Token) -> Range {
        return Range {
            start: Position { line: token.start_line, character: token.start_column },
            end: Position { line: token.end_line, character: token.end_column },
        };
    }

    fn make_token_span_range(&self, first: &Token, last: &Token) -> Range {
        return Range {
            start: Position { line: first.start_line, character: first.start_column },
            end: Position { line: last.end_line, character: last.end_column },
        };
    }

    fn token_at_or_name(&self, module: &Module, token_index: usize, name: &Token) -> &Token {
        if token_index > 0 && token_index <= module.tokens.length {
            return &module.tokens.data[token_index - 1];
        }
        return name;
    }

    fn make_document_symbol_json(&self, name: str, kind: usize, range: &Range, selection_range: &Range, children: Array<JsonNode>) -> JsonNode {
        let item = HashMap<str, JsonNode>::new(self.allocator);
        item.insert("name", JsonNode::String(name));
        item.insert("kind", JsonNode::Number(kind));
        item.insert("range", self.make_range_json(range));
        item.insert("selectionRange", self.make_range_json(selection_range));
        if children.length > 0 {
            item.insert("children", JsonNode::Array(children));
        }
        return JsonNode::Object(item);
    }

    fn make_location_json(&self, uri: str, range: &Range) -> JsonNode {
        let location = HashMap<str, JsonNode>::new(self.allocator);
        location.insert("uri", JsonNode::String(uri));
        location.insert("range", self.make_range_json(range));
        return JsonNode::Object(location);
    }

    fn make_workspace_symbol_json(&self, name: str, kind: usize, container_name: str, uri: str, range: &Range) -> JsonNode {
        let item = HashMap<str, JsonNode>::new(self.allocator);
        item.insert("name", JsonNode::String(name));
        item.insert("kind", JsonNode::Number(kind));
        if container_name.length > 0 {
            item.insert("containerName", JsonNode::String(container_name));
        }
        item.insert("location", self.make_location_json(uri, range));
        return JsonNode::Object(item);
    }

    fn ascii_lower(&self, c: char) -> char {
        if c >= 'A' && c <= 'Z' { return c + 32; }
        return c;
    }

    fn symbol_matches_query(&self, name: str, query: str) -> bool {
        if query.length == 0 { return true; }
        if query.length > name.length { return false; }

        let i: usize = 0;
        while i <= name.length - query.length {
            let matched = true;
            let j: usize = 0;
            while j < query.length {
                if self.ascii_lower(name.ptr[i + j]) != self.ascii_lower(query.ptr[j]) {
                    matched = false;
                    break;
                }
                j += 1;
            }
            if matched { return true; }
            i += 1;
        }

        return false;
    }

    fn append_workspace_symbol_if_matches(&self, result: &Array<JsonNode>, name: str, kind: usize, container_name: str, uri: str, range: &Range, query: str) {
        if !self.symbol_matches_query(name, query) { return; }
        result.append(self.make_workspace_symbol_json(name, kind, container_name, uri, range));
    }

    fn function_kind(&self, func_info: &Function, parent_kind: usize) -> usize {
        match func_info.parent {
            FunctionParent::None => {
                if func_info.type == FunctionType::Test { return 24; }
                return 12;
            },
            _ => { return parent_kind; },
        }
    }

    fn function_range(&self, func_info: &Function) -> Range {
        let name = func_info.name;
        if name == null { return Range { start: Position { line: 0, character: 0 }, end: Position { line: 0, character: 0 } }; }

        if func_info.context != null && func_info.token_end > 0 && func_info.token_end <= func_info.context.length {
            return self.make_token_span_range(name, &func_info.context.tokens[func_info.token_end - 1]);
        }

        return self.make_token_range(name);
    }

    fn append_function_document_symbol(&self, result: &Array<JsonNode>, func_info: &Function, kind: usize) {
        let name = func_info.name;
        if name == null { return; }
        let range = self.function_range(func_info);
        let selection_range = self.make_token_range(name);
        let children = Array<JsonNode>::new(self.allocator);
        result.append(self.make_document_symbol_json(name.value, kind, &range, &selection_range, children));
    }

    fn append_impl_document_symbols(&self, result: &Array<JsonNode>, impls: &Array<&Impl>) {
        for *impl_info in impls {
            for (_, &func_info) in impl_info.functions {
                self.append_function_document_symbol(result, func_info, 6);
            }
            for (_, impl_const) in impl_info.consts {
                let range = self.make_token_range(impl_const.name);
                let children = Array<JsonNode>::new(self.allocator);
                result.append(self.make_document_symbol_json(impl_const.name.value, 14, &range, &range, children));
            }
        }
    }

    fn append_struct_document_symbol(&self, result: &Array<JsonNode>, struct_info: &Struct) {
        let name = struct_info.name;
        if name == null { return; }
        let last = self.token_at_or_name(struct_info.module, struct_info.token_end, name);
        let range = self.make_token_span_range(name, last);
        let selection_range = self.make_token_range(name);
        let children = Array<JsonNode>::new(self.allocator);

        for (_, &field) in struct_info.fields {
            let field_range = self.make_token_range(field.name);
            let field_children = Array<JsonNode>::new(self.allocator);
            children.append(self.make_document_symbol_json(field.name.value, 8, &field_range, &field_range, field_children));
        }

        self.append_impl_document_symbols(&children, &struct_info.impls);
        result.append(self.make_document_symbol_json(name.value, 23, &range, &selection_range, children));
    }

    fn append_enum_document_symbol(&self, result: &Array<JsonNode>, enum_info: &Enum) {
        let name = enum_info.name;
        if name == null { return; }
        let module = enum_info.context.module;
        let last = self.token_at_or_name(module, enum_info.token_end, name);
        let range = self.make_token_span_range(name, last);
        let selection_range = self.make_token_range(name);
        let children = Array<JsonNode>::new(self.allocator);

        for (_, &variant) in enum_info.variants {
            let variant_range = self.make_token_range(variant.name);
            let variant_children = Array<JsonNode>::new(self.allocator);
            children.append(self.make_document_symbol_json(variant.name.value, 22, &variant_range, &variant_range, variant_children));
        }

        self.append_impl_document_symbols(&children, &enum_info.impls);
        result.append(self.make_document_symbol_json(name.value, 10, &range, &selection_range, children));
    }

    fn append_trait_document_symbol(&self, result: &Array<JsonNode>, trait_info: &Trait) {
        let name = trait_info.name;
        if name == null { return; }
        let last = self.token_at_or_name(trait_info.module, trait_info.token_end, name);
        let range = self.make_token_span_range(name, last);
        let selection_range = self.make_token_range(name);
        let children = Array<JsonNode>::new(self.allocator);

        for (_, &func_info) in trait_info.functions {
            self.append_function_document_symbol(&children, func_info, 6);
        }

        result.append(self.make_document_symbol_json(name.value, 11, &range, &selection_range, children));
    }

    fn append_module_document_symbols(&self, result: &Array<JsonNode>, module: &Module) {
        for (_, &struct_arr) in module.structs {
            for *struct_info in struct_arr {
                self.append_struct_document_symbol(result, struct_info);
            }
        }

        for (_, &enum_arr) in module.enums {
            for *enum_info in enum_arr {
                self.append_enum_document_symbol(result, enum_info);
            }
        }

        for (_, &trait_arr) in module.traits {
            for *trait_info in trait_arr {
                self.append_trait_document_symbol(result, trait_info);
            }
        }

        for (_, &func_info) in module.functions {
            if func_info.type == FunctionType::Test { continue; }
            self.append_function_document_symbol(result, func_info, self.function_kind(func_info, 12));
        }

        for (_, global) in module.globals {
            let kind: usize = 13;
            if global.is_const { kind = 14; }
            let range = self.make_token_range(global.name);
            let children = Array<JsonNode>::new(self.allocator);
            result.append(self.make_document_symbol_json(global.name.value, kind, &range, &range, children));
        }

        for test_info in module.tests {
            let range = self.make_token_range(test_info.description);
            let children = Array<JsonNode>::new(self.allocator);
            let display_name = test_info.description.value;
            if display_name.length >= 2 {
                display_name = display_name.slice(1, display_name.length - 1);
            }
            result.append(self.make_document_symbol_json(display_name, 12, &range, &range, children));
        }
    }

    fn append_impl_workspace_symbols(&self, result: &Array<JsonNode>, impls: &Array<&Impl>, container_name: str, uri: str, query: str) {
        for *impl_info in impls {
            for (_, &func_info) in impl_info.functions {
                let name = func_info.name;
                if name == null { continue; }
                let range = self.function_range(func_info);
                self.append_workspace_symbol_if_matches(result, name.value, 6, container_name, uri, &range, query);
            }
            for (_, impl_const) in impl_info.consts {
                let range = self.make_token_range(impl_const.name);
                self.append_workspace_symbol_if_matches(result, impl_const.name.value, 14, container_name, uri, &range, query);
            }
        }
    }

    fn append_module_workspace_symbols(&self, result: &Array<JsonNode>, module: &Module, query: str) {
        let uri = Uri::file(self.allocator, module.path);

        for (_, &struct_arr) in module.structs {
            for *struct_info in struct_arr {
                let name = struct_info.name;
                if name == null { continue; }
                let last = self.token_at_or_name(module, struct_info.token_end, name);
                let range = self.make_token_span_range(name, last);
                self.append_workspace_symbol_if_matches(result, name.value, 23, "", uri, &range, query);

                for (_, &field) in struct_info.fields {
                    let field_range = self.make_token_range(field.name);
                    self.append_workspace_symbol_if_matches(result, field.name.value, 8, name.value, uri, &field_range, query);
                }

                self.append_impl_workspace_symbols(result, &struct_info.impls, name.value, uri, query);
            }
        }

        for (_, &enum_arr) in module.enums {
            for *enum_info in enum_arr {
                let name = enum_info.name;
                if name == null { continue; }
                let last = self.token_at_or_name(module, enum_info.token_end, name);
                let range = self.make_token_span_range(name, last);
                self.append_workspace_symbol_if_matches(result, name.value, 10, "", uri, &range, query);

                for (_, &variant) in enum_info.variants {
                    let variant_range = self.make_token_range(variant.name);
                    self.append_workspace_symbol_if_matches(result, variant.name.value, 22, name.value, uri, &variant_range, query);
                }

                self.append_impl_workspace_symbols(result, &enum_info.impls, name.value, uri, query);
            }
        }

        for (_, &trait_arr) in module.traits {
            for *trait_info in trait_arr {
                let name = trait_info.name;
                if name == null { continue; }
                let last = self.token_at_or_name(module, trait_info.token_end, name);
                let range = self.make_token_span_range(name, last);
                self.append_workspace_symbol_if_matches(result, name.value, 11, "", uri, &range, query);

                for (_, &func_info) in trait_info.functions {
                    let func_name = func_info.name;
                    if func_name == null { continue; }
                    let func_range = self.function_range(func_info);
                    self.append_workspace_symbol_if_matches(result, func_name.value, 6, name.value, uri, &func_range, query);
                }
            }
        }

        for (_, &func_info) in module.functions {
            if func_info.type == FunctionType::Test { continue; }
            let name = func_info.name;
            if name == null { continue; }
            let range = self.function_range(func_info);
            self.append_workspace_symbol_if_matches(result, name.value, self.function_kind(func_info, 12), "", uri, &range, query);
        }

        for (_, global) in module.globals {
            let kind: usize = 13;
            if global.is_const { kind = 14; }
            let range = self.make_token_range(global.name);
            self.append_workspace_symbol_if_matches(result, global.name.value, kind, "", uri, &range, query);
        }

        for test_info in module.tests {
            let range = self.make_token_range(test_info.description);
            let display_name = test_info.description.value;
            if display_name.length >= 2 {
                display_name = display_name.slice(1, display_name.length - 1);
            }
            self.append_workspace_symbol_if_matches(result, display_name, 12, "", uri, &range, query);
        }
    }

    fn append_namespace_workspace_symbols(&self, result: &Array<JsonNode>, namespace: &Namespace, query: str) {
        for (_, module) in namespace.modules {
            self.append_module_workspace_symbols(result, module, query);
        }

        for (_, child) in namespace.children {
            self.append_namespace_workspace_symbols(result, child, query);
        }
    }

    fn position_in_range(&self, range: &Range, line: usize, character: usize) -> bool {
        let before_start = line < range.start.line || (line == range.start.line && character < range.start.character);
        if before_start { return false; }
        let after_end = line > range.end.line || (line == range.end.line && character > range.end.character);
        return !after_end;
    }

    fn position_before_or_equal(&self, position: &Position, line: usize, character: usize) -> bool {
        return position.line < line || (position.line == line && position.character <= character);
    }

    fn make_completion_item_json(&self, label: str, kind: usize, detail: str, insert_text: str, sort_prefix: str, label_detail: str, label_description: str) -> JsonNode {
        let item = HashMap<str, JsonNode>::new(self.allocator);
        item.insert("label", JsonNode::String(label));
        item.insert("kind", JsonNode::Number(kind));
        if detail.length > 0 { item.insert("detail", JsonNode::String(detail)); }
        item.insert("insertText", JsonNode::String(insert_text));
        let sort_text = String::new(self.allocator);
        sort_text.append(sort_prefix);
        sort_text.append(label);
        item.insert("sortText", JsonNode::String(sort_text.as_str()));
        if label_detail.length > 0 || label_description.length > 0 {
            let label_details = HashMap<str, JsonNode>::new(self.allocator);
            if label_detail.length > 0 { label_details.insert("detail", JsonNode::String(label_detail)); }
            if label_description.length > 0 { label_details.insert("description", JsonNode::String(label_description)); }
            item.insert("labelDetails", JsonNode::Object(label_details));
        }
        return JsonNode::Object(item);
    }

    fn append_completion_item(&self, result: &Array<JsonNode>, seen: &HashMap<str, bool>, label: str, kind: usize, detail: str, sort_prefix: str) {
        if label.length == 0 { return; }
        if seen.find(&label) != null { return; }
        seen.insert(label, true);
        result.append(self.make_completion_item_json(label, kind, detail, label, sort_prefix, "", ""));
    }

    fn function_has_self_parameter(&self, func_info: &Function) -> bool {
        if func_info.parameters.length == 0 { return false; }
        let first = &func_info.parameters.data[0];
        let name = first.name;
        if name != null && name.value.eq("self") { return true; }
        return first.type.deref().is_self();
    }

    fn function_self_type(&self, func_info: &Function, fallback: &Type) -> Type {
        match func_info.parent {
            FunctionParent::Primitive(primitive, _, _) => { return Type::Primitive(primitive); },
            FunctionParent::Enum(enum_info, _, _) => { return Type::Enum(enum_info, null); },
            FunctionParent::Struct(struct_info, _, _) => { return Type::Struct(struct_info, null); },
            FunctionParent::Type(type, _, _) => {
                if type.is_fat_pointer() {
                    let deref = type.deref_1();
                    if deref != null { return *deref; }
                }
                return *type;
            },
            _ => {},
        }
        return *fallback;
    }

    fn append_function_completion(&self, result: &Array<JsonNode>, seen: &HashMap<str, bool>, func_info: &Function, kind: usize, context: &Context, skip_self: bool) {
        let name = func_info.name;
        if name == null { return; }
        if name.value.length == 0 { return; }
        if seen.find(&name.value) != null { return; }
        seen.insert(name.value, true);
        let self_type = self.function_self_type(func_info, context.type_self);

        let detail = String::new(self.allocator);
        let label_detail = String::new(self.allocator);
        detail.append("fn ");
        detail.append(name.value);
        detail.append("(");
        label_detail.append("(");
        let first = true;
        let i: usize = 0;
        for param in func_info.parameters {
            if skip_self && i == 0 && self.function_has_self_parameter(func_info) {
                i += 1;
                continue;
            }
            if !first {
                detail.append(", ");
                label_detail.append(", ");
            }
            first = false;
            if i == 0 && self.function_has_self_parameter(func_info) {
                if param.type.deref().is_self() && !param.type.is_self() {
                    detail.append("&self");
                    label_detail.append("&self");
                } else {
                    detail.append("self");
                    label_detail.append("self");
                }
            } else {
                let pname = param.name;
                if pname != null {
                    detail.append(pname.value);
                    detail.append(": ");
                    label_detail.append(pname.value);
                    label_detail.append(": ");
                }
                let type_decl = context.root.naming_decl.get_type_decl(&param.type, &self_type, null);
                detail.append(type_decl.as_str());
                label_detail.append(type_decl.as_str());
            }
            i += 1;
        }
        detail.append(")");
        label_detail.append(")");

        let label_description = String::new(self.allocator);
        if !func_info.return_type.is_void() {
            detail.append(" -> ");
            let ret_decl = context.root.naming_decl.get_type_decl(&func_info.return_type, &self_type, null);
            detail.append(ret_decl.as_str());
            label_description.append("-> ");
            label_description.append(ret_decl.as_str());
        }

        let insert_text = String::new(self.allocator);
        insert_text.append(name.value);
        insert_text.append("()");

        result.append(self.make_completion_item_json(name.value, kind, detail.as_str(), insert_text.as_str(), "1", label_detail.as_str(), label_description.as_str()));
    }

    fn append_type_member_completions(&self, result: &Array<JsonNode>, seen: &HashMap<str, bool>, type: &Type, is_static: bool, context: &Context) {
        match type.resolve_typedef() {
            Type::Indirect(indirect) => {
                self.append_type_member_completions(result, seen, &indirect.to, is_static, context);
            },
            Type::Self => {
                if context.type_self != null && !context.type_self.is_self() {
                    self.append_type_member_completions(result, seen, context.type_self, is_static, context);
                }
            },
            Type::Primitive(primitive_info) => {
                if primitive_info == null || is_static { return; }
                for *impl_info in primitive_info.impls {
                    for (_, &func_info) in impl_info.functions {
                        self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                    }
                }
            },
            Type::Struct(struct_info, generic_map) => {
                if !is_static {
                    for (_, &field) in struct_info.fields {
                        let field_type = Context::resolve_type(self.allocator, &field.type, generic_map, null);
                        let detail = context.root.naming_decl.get_type_decl(field_type, context.type_self, null);
                        self.append_completion_item(result, seen, field.name.value, 5, detail.as_str(), "0");
                    }
                }

                for *impl_info in struct_info.impls {
                    for (_, &func_info) in impl_info.functions {
                        if !is_static && !self.function_has_self_parameter(func_info) { continue; }
                        self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                    }
                    if is_static {
                        for (_, impl_const) in impl_info.consts {
                            let detail = context.root.naming_decl.get_type_decl(&impl_const.type, context.type_self, null);
                            self.append_completion_item(result, seen, impl_const.name.value, 21, detail.as_str(), "3");
                        }
                    }
                }
            },
            Type::Enum(enum_info, _) => {
                if is_static {
                    for (_, &variant) in enum_info.variants {
                        self.append_completion_item(result, seen, variant.name.value, 20, "enum variant", "3");
                    }
                }

                for *impl_info in enum_info.impls {
                    for (_, &func_info) in impl_info.functions {
                        if !is_static && !self.function_has_self_parameter(func_info) { continue; }
                        self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                    }
                    if is_static {
                        for (_, impl_const) in impl_info.consts {
                            let detail = context.root.naming_decl.get_type_decl(&impl_const.type, context.type_self, null);
                            self.append_completion_item(result, seen, impl_const.name.value, 21, detail.as_str(), "3");
                        }
                    }
                }
            },
            Type::Trait(trait_info, _) => {
                if !is_static {
                    self.append_completion_item(result, seen, "instance", 5, "*void", "0");
                }
                for (_, &func_info) in trait_info.functions {
                    self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                }
            },
            Type::Sequence(sequence) => {
                if is_static { return; }
                let data_detail = context.root.naming_decl.get_type_decl(&sequence.element_pointer, context.type_self, null);
                self.append_completion_item(result, seen, "data", 5, data_detail.as_str(), "0");
                let length_detail = context.root.naming_decl.get_type_decl(&context.root.type_usize, context.type_self, null);
                self.append_completion_item(result, seen, "length", 5, length_detail.as_str(), "0");

                let hack_type_impl = context.root.hack_type_impl;
                if hack_type_impl != null {
                    let impl_info = hack_type_impl.impl_info;
                    for (_, &func_info) in impl_info.functions {
                        self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                    }
                }
            },
            Type::Tuple(tuple) => {
                if is_static { return; }
                let i: usize = 0;
                while i < tuple.elements.length {
                    let label = String::new(self.allocator);
                    label.append_usize(i);
                    let detail = context.root.naming_decl.get_type_decl(&tuple.elements.data[i], context.type_self, null);
                    self.append_completion_item(result, seen, label.as_str(), 5, detail.as_str(), "0");
                    i += 1;
                }
            },
            Type::StructC(struct_info) => {
                if is_static { return; }
                for (_, &field) in struct_info.fields {
                    let detail = context.root.naming_decl.get_type_decl(&field.type, context.type_self, null);
                    self.append_completion_item(result, seen, field.name, 5, detail.as_str(), "0");
                }
            },
            Type::UnionC(union_info) => {
                if is_static { return; }
                for (_, &field) in union_info.fields {
                    let detail = context.root.naming_decl.get_type_decl(&field.type, context.type_self, null);
                    self.append_completion_item(result, seen, field.name, 5, detail.as_str(), "0");
                }
            },
            Type::ClassCpp(class_info) => {
                for (name, &field_type) in class_info.fields {
                    let detail = context.root.naming_decl.get_type_decl(field_type, context.type_self, null);
                    self.append_completion_item(result, seen, name, 5, detail.as_str(), "0");
                }
                for (name, &value_type) in class_info.values {
                    let detail = context.root.naming_decl.get_type_decl(value_type, context.type_self, null);
                    self.append_completion_item(result, seen, name, 6, detail.as_str(), "4");
                }
                for base in class_info.bases {
                    self.append_type_member_completions(result, seen, base, is_static, context);
                }
            },
            Type::Generic(generic) => {
                if is_static { return; }
                for *trait_info in generic.traits {
                    for (_, &func_info) in trait_info.functions {
                        self.append_function_completion(result, seen, func_info, 2, context, !is_static);
                    }
                }
            },
            Type::CoroutineInstance(_, _) => {
                if is_static { return; }
                self.append_completion_item(result, seen, "next", 2, "fn next()", "1");
                self.append_completion_item(result, seen, "value", 2, "fn value()", "1");
            },
            Type::NamespaceCpp(ns_info) => {
                for (name, &member_type) in ns_info.types {
                    let detail = context.root.naming_decl.get_type_decl(member_type, context.type_self, null);
                    self.append_completion_item(result, seen, name, 7, detail.as_str(), "2");
                }
                for (name, &member_type) in ns_info.values {
                    let detail = context.root.naming_decl.get_type_decl(member_type, context.type_self, null);
                    self.append_completion_item(result, seen, name, 6, detail.as_str(), "4");
                }
            },
            _ => {},
        }
    }

    fn find_member_completion_at(&self, infos: *Array<MemberCompletionInfo>, line: usize, character: usize) -> *MemberCompletionInfo {
        if infos == null { return null; }
        let found: *MemberCompletionInfo = null;
        for info in infos {
            if info.dot_position.line != line { continue; }
            if info.dot_position.line > line { continue; }
            if info.dot_position.line == line && info.dot_position.character + 1 > character { continue; }
            if found == null {
                found = info;
            } else if info.dot_position.line > (*found).dot_position.line || (info.dot_position.line == (*found).dot_position.line && info.dot_position.character > (*found).dot_position.character) {
                found = info;
            }
        }
        return found;
    }

    fn completion_separator_kind(&self, module: *Module, line: usize, character: usize) -> usize {
        if module == null { return 0; }

        let found = false;
        let found_end: usize = 0;
        let found_value: str = "";
        for token in (*module).tokens {
            if token.end_line != line { continue; }
            if token.end_column > character { continue; }
            if !found || token.end_column > found_end {
                found = true;
                found_end = token.end_column;
                found_value = token.value;
            }
        }

        if !found { return 0; }
        if found_value.eq(".") { return 1; }
        if found_value.eq("::") { return 2; }
        if found_value.eq(":") { return 3; }
        return 0;
    }

    fn append_module_name_completions(&self, result: &Array<JsonNode>, seen: &HashMap<str, bool>, module: &Module) {
        for (_, &func_info) in module.functions {
            if func_info.type == FunctionType::Test { continue; }
            self.append_function_completion(result, seen, func_info, 3, &module.context, false);
        }

        for (_, global) in module.globals {
            let detail = module.context.root.naming_decl.get_type_decl(&global.type, module.context.type_self, null);
            let kind: usize = 6;
            if global.is_const { kind = 21; }
            self.append_completion_item(result, seen, global.name.value, kind, detail.as_str(), "4");
        }

        for (_, &struct_arr) in module.structs {
            for *struct_info in struct_arr {
                let name = struct_info.name;
                if name != null { self.append_completion_item(result, seen, name.value, 22, "struct", "2"); }
            }
        }

        for (_, &enum_arr) in module.enums {
            for *enum_info in enum_arr {
                let name = enum_info.name;
                if name != null { self.append_completion_item(result, seen, name.value, 13, "enum", "2"); }
            }
        }

        for (_, &trait_arr) in module.traits {
            for *trait_info in trait_arr {
                let name = trait_info.name;
                if name != null { self.append_completion_item(result, seen, name.value, 8, "trait", "2"); }
            }
        }
    }

    fn completion(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        let line: usize = params.key("position").key("line").number();
        let character: usize = params.key("position").key("character").number();
        let result = Array<JsonNode>::new(self.allocator);

        if uri.length == 0 {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let filename = ls.file_map.find(&uri);
        if filename == null {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        ls.parse_functions_file(*filename);

        let seen = HashMap<str, bool>::new(self.allocator);
        let module: *Module = null;
        if ls.root != null { module = ls.root.find_module_by_path(*filename); }

        let separator_kind = self.completion_separator_kind(module, line, character);
        if separator_kind == 3 {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let member_infos = ls.analysis.member_completion_info.find(filename);
        let member_info = self.find_member_completion_at(member_infos, line, character);
        if separator_kind == 1 || separator_kind == 2 {
            if member_info != null && module != null {
                self.append_type_member_completions(&result, &seen, &member_info.receiver_type, member_info.is_static, &(*module).context);
            }
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let completion_items = ls.analysis.completion_info.find(filename);
        if completion_items != null {
            for item in completion_items {
                if !self.position_in_range(&item.range, line, character) { continue; }
                if !self.position_before_or_equal(&item.definition_position, line, character) { continue; }
                self.append_completion_item(&result, &seen, item.name, item.kind, item.type_label, "0");
            }
        }

        if module != null {
            self.append_module_name_completions(&result, &seen, module);
        }

        self.send_response(id, JsonNode::Array(result));
    }

    fn document_symbol(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        let result = Array<JsonNode>::new(self.allocator);

        if uri.length == 0 {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let filename_ptr = ls.file_map.find(&uri);
        if filename_ptr == null {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let filename_copy = String::new(self.allocator);
        filename_copy.append(*filename_ptr);
        let filename = filename_copy.as_str();

        if ls.root == null {
            ls.analyze();
        }

        if ls.root == null {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        let module = ls.root.find_module_by_path(filename);
        if module == null {
            self.send_response(id, JsonNode::Array(result));
            return;
        }

        self.append_module_document_symbols(&result, module);
        self.send_response(id, JsonNode::Array(result));
    }

    fn workspace_symbol(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let result = Array<JsonNode>::new(self.allocator);
        let query = params.key("query").string();

        if ls.root == null {
            ls.analyze();
        }
        if ls.root != null {
            for (_, child) in ls.root.children {
                self.append_namespace_workspace_symbols(&result, child, query);
            }
        }

        self.send_response(id, JsonNode::Array(result));
    }

    fn definition(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        let line: usize = params.key("position").key("line").number();
        let character: usize = params.key("position").key("character").number();

        if uri.length == 0 {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let filename = ls.file_map.find(&uri);
        if filename == null {
            self.send_response(id, JsonNode::Null);
            return;
        }

        ls.parse_functions_file(*filename);

        let symbols = ls.analysis.symbol_info.find(filename);
        let symbol = self.find_symbol_at(symbols, line, character);

        if symbol == null || symbol.definition_path.length == 0 {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let def_uri = Uri::file(self.allocator, symbol.definition_path);
        let def_range = Range {
            start: symbol.definition_position,
            end: Position { line: symbol.definition_position.line, character: symbol.definition_position.character + 1 },
        };

        let location = HashMap<str, JsonNode>::new(self.allocator);
        location.insert("uri", JsonNode::String(def_uri));
        location.insert("range", self.make_range_json(&def_range));

        self.send_response(id, JsonNode::Object(location));
    }

    fn hover(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        let line: usize = params.key("position").key("line").number();
        let character: usize = params.key("position").key("character").number();

        if uri.length == 0 {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let filename = ls.file_map.find(&uri);
        if filename == null {
            self.send_response(id, JsonNode::Null);
            return;
        }

        ls.parse_functions_file(*filename);

        let symbols = ls.analysis.symbol_info.find(filename);
        let symbol = self.find_symbol_at(symbols, line, character);

        if symbol == null || symbol.type_label.length == 0 {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let contents = HashMap<str, JsonNode>::new(self.allocator);
        contents.insert("kind", JsonNode::String("plaintext"));
        contents.insert("value", JsonNode::String(symbol.type_label));

        let result = HashMap<str, JsonNode>::new(self.allocator);
        result.insert("contents", JsonNode::Object(contents));
        result.insert("range", self.make_range_json(&symbol.range));

        self.send_response(id, JsonNode::Object(result));
    }

    fn signature_help(&self, id: f64, ls: &LanguageServer, params: &JsonNode) {
        let uri = params.key("textDocument").key("uri").string();
        let line: usize = params.key("position").key("line").number();
        let character: usize = params.key("position").key("character").number();

        if uri.length == 0 {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let filename = ls.file_map.find(&uri);
        if filename == null {
            self.send_response(id, JsonNode::Null);
            return;
        }

        ls.parse_functions_file(*filename);

        let sigs = ls.analysis.signature_info.find(filename);
        if sigs == null {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let found: *SignatureInfo = null;
        for sig in sigs {
            let after_open = line > sig.open_paren.line || (line == sig.open_paren.line && character > sig.open_paren.character);
            let before_close = line < sig.close_paren.line || (line == sig.close_paren.line && character <= sig.close_paren.character);
            if after_open && before_close {
                found = sig;
            }
        }

        if found == null {
            self.send_response(id, JsonNode::Null);
            return;
        }

        let active_param: usize = 0;
        for comma in found.comma_positions {
            let after_comma = line > comma.line || (line == comma.line && character > comma.character);
            if after_comma { active_param += 1; }
        }

        let param_infos = Array<JsonNode>::new(self.allocator);
        for param_label in found.parameters {
            let pi = HashMap<str, JsonNode>::new(self.allocator);
            pi.insert("label", JsonNode::String(*param_label));
            param_infos.append(JsonNode::Object(pi));
        }

        let sig_obj = HashMap<str, JsonNode>::new(self.allocator);
        sig_obj.insert("label", JsonNode::String(found.label));
        sig_obj.insert("parameters", JsonNode::Array(param_infos));

        let signatures = Array<JsonNode>::new(self.allocator);
        signatures.append(JsonNode::Object(sig_obj));

        let result = HashMap<str, JsonNode>::new(self.allocator);
        result.insert("signatures", JsonNode::Array(signatures));
        result.insert("activeSignature", JsonNode::Number(0));
        result.insert("activeParameter", JsonNode::Number(active_param));

        self.send_response(id, JsonNode::Object(result));
    }

    fn process(&self, ls: &LanguageServer) -> bool {
        let msg_str = self.read_message();
        defer msg_str.release();
        let msg_json = JsonNode::Undefined;

        if !JsonParser::parse(self.allocator, &msg_json, msg_str.as_str()) {
            fprintf(stderr, "Failed to parse json: %.*s\n\n", msg_str.len_i32(), msg_str.c_str());
            return true;
        }

        let id = msg_json.key("id").number();
        let method = msg_json.key("method").string();

        if method.eq("initialize") {
            let result = self.initialize(msg_json.key("params"));
            self.send_response(id, result);
        // } else if method.eq("initialized") {
        //     self.register_capabilities();
        } else if method.eq("workspace/didChangeConfiguration") {
            self.did_change_configuration(ls, msg_json.key("params"));
        } else if method.eq("textDocument/didSave") {
            let uri = msg_json.key("params").key("textDocument").key("uri").string();
            if uri.length == 0 { return true; }
            let filename = ls.file_map.find(&uri);
            if filename == null { return true; }
            let filename_copy = String::new(self.allocator);
            filename_copy.append(*filename);
            let filename_str = filename_copy.as_str();

            ls.clear_override_file(filename_str);
            ls.set_dirty_uri(uri, false);

            let analysis = ls.analyze();
            ls.parse_functions_file(filename_str);
            let diagnostics = analysis.diagnostics.find(&filename_str);
            if diagnostics == null {
                let blank_diagnostics = Array<Diagnostic> { allocator: self.allocator, data: null, length: 0, capacity: 0 };
                self.publish_diagnostics_file(filename_str, &blank_diagnostics);
            } else {
                self.publish_diagnostics_file(filename_str, diagnostics);
            }
            self.inlay_hint_refresh();
        } else if method.eq("textDocument/didOpen") {
            self.did_open(ls, msg_json.key("params"));
        } else if method.eq("textDocument/didChange") {
            self.did_change(ls, msg_json.key("params"));
        } else if method.eq("textDocument/didClose") {
            self.did_close(ls, msg_json.key("params"));
        } else if method.eq("textDocument/inlayHint") {
            self.inlay_hint(id, ls, msg_json.key("params"));
        } else if method.eq("textDocument/documentSymbol") {
            self.document_symbol(id, ls, msg_json.key("params"));
        } else if method.eq("workspace/symbol") {
            self.workspace_symbol(id, ls, msg_json.key("params"));
        } else if method.eq("textDocument/completion") {
            self.completion(id, ls, msg_json.key("params"));
        } else if method.eq("textDocument/definition") {
            self.definition(id, ls, msg_json.key("params"));
        } else if method.eq("textDocument/hover") {
            self.hover(id, ls, msg_json.key("params"));
        } else if method.eq("textDocument/signatureHelp") {
            self.signature_help(id, ls, msg_json.key("params"));
        } else if method.eq("exit") {
            return false;
        }

        return true;
    }
}
