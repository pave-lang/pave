#include "pipes.h"

use std
use analyzer
use analyzer::types

struct Processor {
    allocator: &ArenaAllocator,
    pipe_read: pipe_t,
    pipe_write: pipe_t,
}

impl Processor {
    fn new(allocator: &ArenaAllocator, pipe_read: pipe_t, pipe_write: pipe_t) -> Self {
        return Self {
            allocator,
            pipe_read,
            pipe_write,
        };
    }

    fn read_headers(&self, content_length: &usize) -> bool {
        let MAX_LENGTH: usize = 1024;
        let buf: *char = self.allocator.alloc(1024);
        defer self.allocator.free(buf);
        let pipe = self.pipe_read;

        let pos: usize = 0;
        let c: char = 0;
        let newlines: usize = 0;
        while pos < MAX_LENGTH - 1 {
            if read_pipe(pipe, &c, 1) == 0 { return false; }

            buf[pos] = c;
            pos += 1;
            
            if c == '\n' {
                newlines += 1;
                if newlines == 2 && pos >= 4 && buf[pos-4] == '\r' && buf[pos-3] == '\n' && buf[pos-2] == '\r' && buf[pos-1] == '\n' {
                    buf[pos] = '\0';
                    
                    let cl = strstr(buf, "Content-Length:");
                    if cl != null { *content_length = strtoul(cl + 15, 0, 10); }

                    return true;
                }
            } else if c != '\r' {
                newlines = 0;
            }
      }

      return false;
    }

    fn read_message(&self) -> String {
        let content_length: usize = 0;
        if !self.read_headers(&content_length) { return String::new(self.allocator); }

        let content = String::new(self.allocator);
        content.ensure_can_hold(content_length);

        content.array.length = content_length;
        if read_pipe(self.pipe_read, content.array.data, content_length) == 0 { return String::new(self.allocator); }

        fprintf(stderr, "Receved: %s\n\n", content.c_str());

        return content;
    }

    fn send_message(&self, method: *const char, params: JsonNode) {
        let response = HashMap<str, JsonNode>::new(self.allocator);
        response.insert("jsonrpc", JsonNode::String("2.0"));
        response.insert("method", JsonNode::String(method));
        response.insert("params", params);
        
        let text = JsonNode::Object(response).to_string(self.allocator);
        self.send_response_text(text.as_str());
    }

    fn send_message_no_params(&self, method: *const char) {
        let response = HashMap<str, JsonNode>::new(self.allocator);
        response.insert("jsonrpc", JsonNode::String("2.0"));
        response.insert("method", JsonNode::String(method));
        
        let text = JsonNode::Object(response).to_string(self.allocator);
        self.send_response_text(text.as_str());
    }

    // fn send_message_id(&self, id: f64, method: *const char, params: JsonNode) {
    //     let response = HashMap<str, JsonNode>::new(self.allocator);
    //     response.insert("jsonrpc", JsonNode::String("2.0"));
    //     response.insert("id", JsonNode::Number(id));
    //     response.insert("method", JsonNode::String(method));
    //     response.insert("params", params);
        
    //     let text = JsonNode::Object(response).to_string(self.allocator);
    //     self.send_response_text(text.as_str());
    // }

    fn send_response(&self, id: f64, result: JsonNode) {
        let response = HashMap<str, JsonNode>::new(self.allocator);
        response.insert("jsonrpc", JsonNode::String("2.0"));
        response.insert("id", JsonNode::Number(id));
        response.insert("result", result);
        
        let text = JsonNode::Object(response).to_string(self.allocator);
        self.send_response_text(text.as_str());
    }

    fn send_response_text(&self, string: str) {
        let header: *char = self.allocator.alloc(128);
        defer self.allocator.free(header);

        let header_len: usize = snprintf(header, 128, "Content-Length: %zu\r\n\r\n", string.length);

        write_pipe(self.pipe_write, header, header_len);
        write_pipe(self.pipe_write, string.ptr, string.length);

        fprintf(stderr, "Sent: %s\n\n", string.ptr);
    }

    fn initialize(&self, params: &JsonNode) -> JsonNode {
        let result = HashMap<str, JsonNode>::new(self.allocator);

        let capabilities = HashMap<str, JsonNode>::new(self.allocator);

        let text_document_sync = HashMap<str, JsonNode>::new(self.allocator);
        text_document_sync.insert("openClose", JsonNode::Boolean(true));
        text_document_sync.insert("change", JsonNode::Number(1));
    
        let save = HashMap<str, JsonNode>::new(self.allocator);
        save.insert("includeText", JsonNode::Boolean(false));
        text_document_sync.insert("save", JsonNode::Object(save));

        capabilities.insert("textDocumentSync", JsonNode::Object(text_document_sync));

        let inlay_hint_provider = HashMap<str, JsonNode>::new(self.allocator);
        inlay_hint_provider.insert("resolveProvider", JsonNode::Boolean(false));
        capabilities.insert("inlayHintProvider", JsonNode::Object(inlay_hint_provider));

        capabilities.insert("definitionProvider", JsonNode::Boolean(true));
        capabilities.insert("hoverProvider", JsonNode::Boolean(true));
        capabilities.insert("documentSymbolProvider", JsonNode::Boolean(true));
        capabilities.insert("workspaceSymbolProvider", JsonNode::Boolean(true));

        let completion_provider = HashMap<str, JsonNode>::new(self.allocator);
        completion_provider.insert("resolveProvider", JsonNode::Boolean(false));
        let completion_triggers = Array<JsonNode>::new(self.allocator);
        completion_triggers.append(JsonNode::String("."));
        completion_triggers.append(JsonNode::String(":"));
        completion_provider.insert("triggerCharacters", JsonNode::Array(completion_triggers));
        capabilities.insert("completionProvider", JsonNode::Object(completion_provider));

        let sig_help = HashMap<str, JsonNode>::new(self.allocator);
        let trigger_chars = Array<JsonNode>::new(self.allocator);
        trigger_chars.append(JsonNode::String("("));
        trigger_chars.append(JsonNode::String(","));
        sig_help.insert("triggerCharacters", JsonNode::Array(trigger_chars));
        capabilities.insert("signatureHelpProvider", JsonNode::Object(sig_help));

        let has_workspace_folder_capability = true;
        if has_workspace_folder_capability {
            let workspace = HashMap<str, JsonNode>::new(self.allocator);
            let workspace_folders = HashMap<str, JsonNode>::new(self.allocator);
            workspace_folders.insert("supported", JsonNode::Boolean(true));
            workspace.insert("workspaceFolders", JsonNode::Object(workspace_folders));
            capabilities.insert("workspace", JsonNode::Object(workspace));
        }

        result.insert("capabilities", JsonNode::Object(capabilities));

        return JsonNode::Object(result);
    }

