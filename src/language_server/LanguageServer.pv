#include "stdio.h"
#include "string.h"
#include "stdlib.h"
#include "pipes.h"

use std
use analyzer

struct LanguageServer {
    allocator: &ArenaAllocator,
    root: *Root,
    args: Array<*const char>,
    clang_args: Array<*const char>,
    c_std_arg: *const char,
    cpp_std_arg: *const char,
    analysis_alloc: ArenaAllocator,
    analysis: Analysis,
    file_map: HashMap<Uri, str>,
    dirty_files: HashMap<str, bool>,
    file_overrides: HashMap<str, str>,
    decl_fingerprints: HashMap<str, u64>,
    global_phases_ok: bool,
    pipe_read: pipe_t,
    pipe_write: pipe_t,
}

impl LanguageServer {
    fn new(allocator: &ArenaAllocator, args: &Array<*const char>) -> *LanguageServer {
        let self = allocator.store(&LanguageServer {
            allocator,
            args: Array<*const char>::new(allocator),
            clang_args: Array<*const char>::new(allocator),
            c_std_arg: null,
            cpp_std_arg: null,
            root: null,
            analysis_alloc: ArenaAllocator { state: null },
            analysis: Analysis {
                files: HashMap<str, bool> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                diagnostics: HashMap<str, Array<Diagnostic>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                inlay_hints: HashMap<str, Array<InlayHint>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                symbol_info: HashMap<str, Array<SymbolInfo>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                signature_info: HashMap<str, Array<SignatureInfo>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                completion_info: HashMap<str, Array<CompletionInfo>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                member_completion_info: HashMap<str, Array<MemberCompletionInfo>> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                collect_symbols: true,
                parsed_function_files: HashMap<str, bool> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
                file_overrides: HashMap<str, str> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
            },
            file_map: HashMap<Uri, str> { allocator, buckets: null, data: null, capacity: 0, length: 0 },
            dirty_files: HashMap<str, bool>::new(allocator),
            file_overrides: HashMap<str, str>::new(allocator),
            decl_fingerprints: HashMap<str, u64>::new(allocator),
            global_phases_ok: false,
            pipe_read: cast<pipe_t>(null),
            pipe_write: cast<pipe_t>(null),
        });

        if self == null { return null; }

        let use_stdio = true;
        for *arg in args.iter().skip(1) {
            if strncmp(arg, "--pipe=", 7) == 0 {
                let pipe_name = arg + 7;

                self.pipe_read = open_pipe(pipe_name);
                if self.pipe_read == INVALID_PIPE {
                    return null;
                }
                self.pipe_write = self.pipe_read;

                fprintf(stderr, "LSP Server started (using pipe %s)...\n", pipe_name);
                use_stdio = false;
            }
        }

        if use_stdio {
            self.pipe_read = get_stdin_pipe();
            self.pipe_write = get_stdout_pipe();
            fprintf(stderr, "LSP Server started (using stdio)...\n");
        }

        return self;
    }

    fn add_arg(&self, arg: *const char) {
        self.args.append(arg);
    }

    fn add_clang_arg(&self, arg: *const char) {
        if strncmp(arg, "-std=c++", 8) == 0 || strncmp(arg, "-std=gnu++", 10) == 0 {
            self.cpp_std_arg = arg;
        } else if strncmp(arg, "-std=", 5) == 0 {
            self.c_std_arg = arg;
        } else {
            self.clang_args.append(arg);
        }
    }

    fn copy_c_string(&self, value: str) -> *char {
        let copy: *char = self.allocator.alloc(value.length + 1);
        if copy == null { return null; }
        memcpy(copy, value.ptr, value.length);
        copy[value.length] = 0;
        return copy;
    }

    fn analyze(&self) -> &Analysis {
        self.global_phases_ok = false;
        self.analysis_alloc.destroy();
        self.analysis_alloc = ArenaAllocator::new(GeneralPurposeAllocator::default(), 5 * 1024 * 1024);
        self.analysis = Analysis::new(&self.analysis_alloc);
        self.analysis.collect_symbols = true;
        self.file_map = HashMap<Uri, str>::new(&self.analysis_alloc);
        let analysis = &self.analysis;
        for (path, content) in self.file_overrides {
            analysis.file_overrides.insert(path, content);
        }

        self.root = Root::new(&self.analysis_alloc, &self.args, &self.clang_args, self.c_std_arg, self.cpp_std_arg, analysis);
        let root = self.root;
        if root == null { self.store_fingerprints(); return analysis; }

        for (filename, _) in analysis.files {
            let uri = Uri::file(&self.analysis_alloc, filename);
            self.file_map.insert(uri, filename);
        }

        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.add_use_namespaces();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.fill_namespace();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.prefill_types();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.prefill_types_impl();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.parse_declarations();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        root.parse_globals();
        if analysis.diagnostics.length > 0 { self.store_fingerprints(); return analysis; }

        self.global_phases_ok = true;
        self.store_fingerprints();
        return analysis;
    }

    fn analyze_file(&self, path: str) -> &Analysis {
        // Fast path: if we have a valid snapshot from a clean global phase and the
        // changed file's declarations haven't changed, skip the full rebuild —
        // just retokenize and reparse bodies.  Function-body errors from a previous
        // keystroke do NOT invalidate global state, so global_phases_ok stays true.
        if self.root != null && self.global_phases_ok {
            let override_text = self.file_overrides.find(&path);
            if override_text != null {
                let old_fp = self.decl_fingerprints.find(&path);
                if old_fp != null {
                    // Quick-tokenize the new content on a temporary allocator to compute fingerprint
                    let tmp_alloc = ArenaAllocator::new(GeneralPurposeAllocator::default(), 256 * 1024);
                    let tmp_tokens = Tokenizer::tokenize_data(&tmp_alloc, *override_text);
                    let new_fp = Module::compute_declaration_fingerprint(&tmp_tokens);
                    tmp_alloc.destroy();

                    if new_fp == *old_fp {
                        // Declarations unchanged — reuse existing snapshot
                        let analysis = &self.analysis;

                        // Copy fresh override text into analysis arena
                        analysis.file_overrides.remove(&path);
                        let path_arena = String::new(&self.analysis_alloc);
                        path_arena.append(path);
                        let text_arena = String::new(&self.analysis_alloc);
                        text_arena.append(*override_text);
                        analysis.file_overrides.insert(path_arena.as_str(), text_arena.as_str());

                        // Find the module and retokenize + update function boundaries
                        let module = self.root.find_module_by_path(path);
                        if module != null {
                            module.retokenize_for_bodies();
                        }

                        // Clear parsed state and old diagnostics for this file
                        analysis.parsed_function_files.remove(&path);
                        analysis.diagnostics.remove(&path);
                        return self.parse_functions_file(path);
                    }
                }
            }
        }

        let analysis = self.analyze();
        self.store_fingerprints();
        if analysis.diagnostics.length > 0 { return analysis; }
        return self.parse_functions_file(path);
    }

    fn parse_functions_file(&self, path: str) -> &Analysis {
        let analysis = &self.analysis;
        if self.root == null { return analysis; }
        if analysis.parsed_function_files.find(&path) != null { return analysis; }

        let path_copy = String::new(&self.analysis_alloc);
        path_copy.append(path);
        let path_str = path_copy.as_str();

        analysis.inlay_hints.remove(&path_str);
        analysis.symbol_info.remove(&path_str);
        analysis.signature_info.remove(&path_str);
        analysis.completion_info.remove(&path_str);
        analysis.member_completion_info.remove(&path_str);
        if self.root.parse_functions_if_path(path_str) {
            analysis.parsed_function_files.insert(path_str, true);
        }
        return analysis;
    }

    // Walk all modules in a namespace tree and compute/store declaration fingerprints.
    fn store_fingerprints(&self) {
        if self.root == null { return; }
        for (_, child) in self.root.children {
            self.store_fingerprints_namespace(child);
        }
    }

    fn store_fingerprints_namespace(&self, namespace: &Namespace) {
        for (_, module) in namespace.modules {
            let fp = module.declaration_fingerprint();
            let existing = self.decl_fingerprints.find(&module.path);
            if existing != null {
                *existing = fp;
            } else {
                let key = String::new(self.allocator);
                key.append(module.path);
                self.decl_fingerprints.insert(key.as_str(), fp);
            }
        }
        for (_, child) in namespace.children {
            self.store_fingerprints_namespace(child);
        }
    }

    fn set_dirty_uri(&self, uri: str, dirty: bool) {
        let existing = self.dirty_files.find(&uri);
        if existing != null {
            *existing = dirty;
            return;
        }
        let key = String::new(self.allocator);
        key.append(uri);
        self.dirty_files.insert(key.as_str(), dirty);
    }

    fn is_dirty_uri(&self, uri: str) -> bool {
        let dirty = self.dirty_files.find(&uri);
        if dirty == null { return false; }
        return *dirty;
    }

    fn set_override_file(&self, path: str, text: str) {
        let existing = self.file_overrides.find(&path);
        if existing != null {
            // Key already exists — just replace the value.
            // The old text string leaks on the persistent allocator,
            // but we avoid leaking a new key string on every keystroke.
            let text_copy = String::new(self.allocator);
            text_copy.append(text);
            *existing = text_copy.as_str();
            return;
        }
        let path_copy = String::new(self.allocator);
        path_copy.append(path);
        let text_copy = String::new(self.allocator);
        text_copy.append(text);
        self.file_overrides.insert(path_copy.as_str(), text_copy.as_str());
    }

    fn clear_override_file(&self, path: str) {
        self.file_overrides.remove(&path);
    }

    fn alloc(&self, size: usize) -> &void {
        return self.allocator.alloc(size);
    }

    fn destroy(&self) {
        self.allocator.destroy();
    }

    fn run(&self) -> i32 {
        let run = true;
        while run {
            let allocator = ArenaAllocator::new(GeneralPurposeAllocator::default(), 5 * 1024 * 1024);

            let processor = Processor::new(&allocator, self.pipe_read, self.pipe_write);
            run = processor.process(self);

            allocator.destroy();
        }

        return 0;
    }
}
