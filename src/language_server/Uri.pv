#include "stdio.h"
#include "path.h"

use std

enum Uri {
    File(str),
}

impl Uri {
    const FILE_SCHEME: str = "file:///";

    fn file(allocator: &ArenaAllocator, path: str) -> Uri {
        let resolved_path: *const char = resolve_path(path.ptr);
        if resolved_path == null { return Uri::File(""); }
        let file_path = Uri::copy_c_str(allocator, resolved_path);
        return Uri::File(file_path);
    }

    fn parse(allocator: &ArenaAllocator, value: str) -> Uri {
        if !value.starts_with(Uri::FILE_SCHEME) { return Uri::File(""); }

        let encoded_path = value.slice(Uri::FILE_SCHEME.length, value.length);
        let file_path = Uri::from_percent_encoded(allocator, encoded_path);

        let resolved_path: *const char = resolve_path(file_path.ptr);
        if resolved_path == null { return Uri::File(file_path); }

        return Uri::File(Uri::copy_c_str(allocator, resolved_path));
    }

    fn to_string(&self, allocator: &ArenaAllocator) -> str {
        match self {
            Uri::File(path) => {
                let result = String::new(allocator);
                result.append(Uri::FILE_SCHEME);
                result.append(Uri::to_percent_encoded(allocator, path.ptr));
                return result.as_str();
            },
        }
    }

    fn path(&self) -> str {
        match self {
            Uri::File(path) => { return path; },
        }
    }

    fn copy_c_str(allocator: &ArenaAllocator, value: *const char) -> str {
        let result = String::new(allocator);
        result.append(str::new(value));
        return result.as_str();
    }

    fn to_percent_encoded(allocator: &ArenaAllocator, value: *const char) -> str {
        let result = String::new(allocator);
        let i: usize = 0;
        let pos: usize = 0;
        while value[i] != '\0' {
            if value[i] == ':' { result.append_sized(value + pos, i - pos); result.append("%3A"); pos = i + 1; }
            i += 1;
        }

        result.append_sized(value + pos, i - pos);
        return result.as_str();
    }

    fn from_percent_encoded(allocator: &ArenaAllocator, encoded: str) -> str {
        let decoded = String::new(allocator);

        let i: usize = 0;
        while i < encoded.length {
            let c = encoded.ptr[i];
            if c == '%' && i + 2 < encoded.length {
                let hi = Uri::hex_value(encoded.ptr[i + 1]);
                let lo = Uri::hex_value(encoded.ptr[i + 2]);
                if hi >= 0 && lo >= 0 {
                    decoded.append_char(cast<char>(hi * 16 + lo));
                    i += 3;
                    continue;
                }
            }

            decoded.append_char(c);
            i += 1;
        }

        return decoded.as_str();
    }

    fn hex_value(c: char) -> i32 {
        if c >= '0' && c <= '9' { return cast<i32>(c - '0'); }
        if c >= 'a' && c <= 'f' { return cast<i32>(c - 'a') + 10; }
        if c >= 'A' && c <= 'F' { return cast<i32>(c - 'A') + 10; }
        return -1;
    }
}

impl Hash for Uri {
    fn hash(&self) -> Hash {
        match self {
            Uri::File(path) => { return Uri::FILE_SCHEME.hash().continue_with(path.ptr, path.length); },
        }
    }
}
