trait Add<T> {
    typedef Output;
    fn add(self, other: T) -> Output;
}

trait Sub<T> {
    typedef Output;
    fn sub(self, other: T) -> Output;
}

trait Mul<T> {
    typedef Output;
    fn mul(self, other: T) -> Output;
}

trait Div<T> {
    typedef Output;
    fn div(self, other: T) -> Output;
}

trait Eq<T> {
    fn eq(self, other: T) -> bool;
}

trait Neg {
    typedef Output;
    fn neg(self) -> Output;
}

trait Ord<T> {
    fn lt(self, other: T) -> bool;
    fn gt(self, other: T) -> bool;
    fn le(self, other: T) -> bool;
    fn ge(self, other: T) -> bool;
}

trait Index<T> {
    typedef Output;
    fn index(&self, idx: T) -> &Output;
}
