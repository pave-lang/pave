#include "stdio.h"
#include "stdlib.h"
#include "string.h"
#include "stddef.h"

struct ArenaAllocator {
    allocator: &dyn Allocator,
    block_size: usize,
    last_block: *ArenaBlock,
    last_oversize: *ArenaOversize,
}

struct ArenaBlock {
    buffer: *u8,
    capacity: usize,
    offset: usize,
    prev: *ArenaBlock,
}

struct ArenaOversize {
    size: usize,
    data: *void,
    prev: *ArenaOversize,
}

impl ArenaBlock {
    fn new(allocator: &dyn Allocator, capacity: usize, prev: *ArenaBlock) -> *Self {
        let buffer: *u8 = allocator.alloc(capacity);
        if buffer == null {
            fprintf(stderr, "ArenaBlock::new: failed to allocate capacity %zu\n", capacity);
            return null;
        }

        let self = Self { buffer, capacity, prev, offset: 0 };
        let self_ptr: *Self = self.alloc(sizeof(Self));
        *self_ptr = self;

        return self_ptr;
    }

    fn alloc(&self, size: usize) -> *void {
        let header_size: usize = sizeof(ArenaAllocation);
        let alignment = ArenaAllocator::alignment();
        let data_offset = ArenaAllocator::align_up(self.offset + header_size, alignment);
        let next_offset = ArenaAllocator::align_up(data_offset + size, alignment);

        if next_offset > self.capacity {
            return null;
        }

        let header_ptr: &void = self.buffer + data_offset - header_size;
        let data_ptr: &void = self.buffer + data_offset;

        let header: &ArenaAllocation = header_ptr;
        header.size = size;
        header.start_offset = self.offset;
        header.end_offset = next_offset;
        self.offset = next_offset;

        return data_ptr;
    }

    fn is_in_block(&self, ptr: &void) -> bool {
        let buffer_start: &void = self.buffer;
        let buffer_end: &void = self.buffer + self.capacity;
        return buffer_start < ptr && ptr < buffer_end;
    }

    fn size(&self, ptr: *void) -> usize {
        if !self.is_in_block(ptr) { return 0; }

        let header: *ArenaAllocation = ptr;
        header -= 1;
        if header == null { return 0; }

        return header.size;
    }

    fn free(&self, ptr: *void) -> bool {
        if ptr == null { return false; }

        let header: *ArenaAllocation = ptr;
        header -= 1;
        if header == null { return false; }

        if header.end_offset == self.offset {
            let old_offset = self.offset;
            self.offset = header.start_offset;
            memset(self.buffer + self.offset, 0, old_offset - self.offset);
            return true;
        }

        return false;
    }

    fn destroy(&self, allocator: &dyn Allocator) {
        allocator.free(self.buffer);
    }

    fn realloc(&self, ptr: *void, size: usize) -> *void {
        let header: *ArenaAllocation = ptr;
        header -= 1;
        if header == null { return null; }

        let data: &u8 = ptr;

        if size <= header.size {
            memset(data + size, 0, header.size - size);
            if header.end_offset == self.offset {
                self.offset = ArenaAllocator::align_up(data - self.buffer + size, ArenaAllocator::alignment());
                header.end_offset = self.offset;
            }
            header.size = size;
            return data;
        }

        if header.end_offset == self.offset {
            let next_offset = ArenaAllocator::align_up(data - self.buffer + size, ArenaAllocator::alignment());
            if next_offset > self.capacity {
                // self.free(ptr);
                return null;
            }

            self.offset = next_offset;
            header.size = size;
            header.end_offset = next_offset;
            return data;
        }

        let new_ptr: *void = self.alloc(size);
        if new_ptr == null {
            // self.free(ptr);
            return null;
        }

        memcpy(new_ptr, ptr, header.size);
        self.free(ptr);

        return new_ptr;
    }
}

struct ArenaAllocation {
    size: usize,
    start_offset: usize,
    end_offset: usize,
}

impl ArenaAllocator {
    fn alignment() -> usize {
        return __BIGGEST_ALIGNMENT__;
    }

    fn align_up(value: usize, alignment: usize) -> usize {
        return ((value + alignment - 1) / alignment) * alignment;
    }

    fn new(allocator: &dyn Allocator, block_size: usize) -> Self {
        let block = ArenaBlock::new(allocator, block_size, null);
        if block == null { return Self { allocator, block_size: 0, last_block: null, last_oversize: null }; }

        return Self {
            allocator,
            block_size,
            last_block: block,
            last_oversize: null,
        };
    }

    fn destroy(&self) {
        let oversize = self.last_oversize;

        while oversize != null {
            let prev = oversize.prev;
            self.allocator.free(oversize);
            oversize = prev;
        }

        self.last_oversize = null;

        let block = self.last_block;

        while block != null {
            if block.is_in_block(self) {
                block.destroy(self.allocator);
                return;
            }

            let prev = block.prev;
            block.destroy(self.allocator);
            block = prev;
        }

        self.block_size = 0;
        self.last_block = null;
    }

    fn store<T>(&self, value: *T) -> *T {
        let new_memory: *T = self.alloc(sizeof(T));
        if new_memory == null { return null; }

        memcpy(new_memory, value, sizeof(T));
        return new_memory;
    }

    fn store_dyn(&self, value: &dyn Any) -> *void {
        let size = value.size();
        let new_memory = self.alloc(size);
        if new_memory == null { return null; }

        memcpy(new_memory, value.instance, size);
        return new_memory;
    }
}

impl Allocator for ArenaAllocator {
    fn alloc(&self, size: usize) -> *void {
        if size > self.block_size / 4 {
            let data_offset = ArenaAllocator::align_up(sizeof(ArenaOversize), ArenaAllocator::alignment());
            let total_size = data_offset + size;
            let oversize: *ArenaOversize = self.allocator.alloc(total_size);
            if oversize == null { return null; }
            let oversize_void: *void = oversize;
            let oversize_bytes: &u8 = oversize_void;
            oversize.size = size;
            oversize.data = oversize_bytes + data_offset;
            oversize.prev = self.last_oversize;
            self.last_oversize = oversize;
            return oversize.data;
        }

        let last_block = self.last_block;
        if last_block == null { return null; }

        let ptr = last_block.alloc(size);
        if ptr != null { return ptr; }

        let block = ArenaBlock::new(self.allocator, self.block_size, self.last_block);
        if block == null { return null; }

        self.last_block = block;
        return block.alloc(size);
    }

    fn realloc(&self, ptr: *void, new_size: usize) -> *void {
        if ptr == null { return self.alloc(new_size); }

        let oversize = self.last_oversize;
        while oversize != null {
            let prev = oversize.prev;

            if ptr == oversize.data {
                let old_size = oversize.size;

                let new_ptr = self.alloc(new_size);
                if new_ptr == null { return null; }

                if new_size < old_size {
                    memcpy(new_ptr, ptr, new_size);
                } else {
                    memcpy(new_ptr, ptr, old_size);
                }
                
                self.free(ptr);

                return new_ptr;
            }

            oversize = prev;
        }

        let current_block: *ArenaBlock = null;
        let block = self.last_block;
        while current_block == null && block != null {
            if block.is_in_block(ptr) {
                let realloc_ptr = block.realloc(ptr, new_size);
                if realloc_ptr != null { return realloc_ptr; }
                current_block = block;
            }

            block = block.prev;
        }

        if current_block == null {
            fprintf(stderr, "ArenaAllocator.realloc: No block found to reallocate from\n");
            return null;
        }

        let old_size = current_block.size(ptr);

        let new_ptr = self.alloc(new_size);
        if new_ptr == null { return null; }

        memcpy(new_ptr, ptr, if new_size < old_size { new_size } else { old_size });
        current_block.free(ptr);

        return new_ptr;
    }

    fn free(&self, ptr: *void) -> bool {
        if ptr == null { return false; }

        let oversize = self.last_oversize;
        let next: *ArenaOversize = null;
        while oversize != null {
            let prev = oversize.prev;

            if ptr == oversize.data {
                if self.last_oversize == oversize { self.last_oversize = prev; }
                if next != null { next.prev = prev; }

                return self.allocator.free(oversize);
            }

            next = oversize;
            oversize = prev;
        }

        let block = self.last_block;
        while block != null {
            let prev = block.prev;
            
            if block.is_in_block(ptr) {
                return block.free(ptr);
            }

            block = prev;
        }

        return false;
    }
}

test "destroy clears oversize allocations" {
    let allocator = ArenaAllocator::new(GeneralPurposeAllocator::default(), 1024);

    if allocator.alloc(300) == null { abort(); }
    if allocator.alloc(400) == null { abort(); }

    allocator.destroy();

    if allocator.last_oversize != null { abort(); }
}

test "allocations preserve maximum alignment" {
    let allocator = ArenaAllocator::new(GeneralPurposeAllocator::default(), 1024);
    let block = allocator.last_block;
    if block != null {
        let first: *void = allocator.alloc(1);
        if first == null { abort(); }
        let first_bytes: &u8 = first;
        let first_offset: usize = first_bytes - block.buffer;
        if first_offset / ArenaAllocator::alignment() * ArenaAllocator::alignment() != first_offset { abort(); }
        if block.offset / ArenaAllocator::alignment() * ArenaAllocator::alignment() != block.offset { abort(); }

        let before_second = block.offset;
        let second: *void = allocator.alloc(sizeof(usize));
        if second == null { abort(); }
        let second_bytes: &u8 = second;
        let second_offset: usize = second_bytes - block.buffer;
        if second_offset / ArenaAllocator::alignment() * ArenaAllocator::alignment() != second_offset { abort(); }
        if block.offset / ArenaAllocator::alignment() * ArenaAllocator::alignment() != block.offset { abort(); }

        if allocator.realloc(second, 1) == null { abort(); }
        if !allocator.free(second) { abort(); }
        if block.offset != before_second { abort(); }
    } else { abort(); }

    let large: *void = allocator.alloc(300);
    if large == null { abort(); }
    let oversize = allocator.last_oversize;
    if oversize != null {
        let large_bytes: &u8 = large;
        let oversize_void: *void = oversize;
        let oversize_bytes: &u8 = oversize_void;
        let data_offset: usize = large_bytes - oversize_bytes;
        if data_offset / ArenaAllocator::alignment() * ArenaAllocator::alignment() != data_offset { abort(); }
    } else { abort(); }

    allocator.destroy();
}
