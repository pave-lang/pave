struct Hash(u64);

struct Fnv1a;
impl Fnv1a {
    fn hash(value: *const void, size: usize) -> Hash {
        let fnv_prime: u64 = 1099511628211u;
        let fnv_offset_basis: u64 = 14695981039346656037u;
        
        let result = fnv_offset_basis;

        let bytes: *const u8 = value;

        let i: usize = 0;
        while i < size {
            result = result ^ bytes[i];
            result = result * fnv_prime;
            i += 1;
        }

        return Hash(result);
    }

    fn continue_with(hash: Hash, value: *const void, size: usize) -> Hash {
        let fnv_prime: u64 = 1099511628211u;
        
        let result = hash._0; 

        let bytes: *const u8 = value;

        let i: usize = 0;
        while i < size {
            result = result ^ bytes[i];
            result = result * fnv_prime;
            i += 1;
        }

        return Hash(result);
    }
}

impl Hash {
    fn continue_with(self, value: *const void, size: usize) -> Hash {
        return Fnv1a::continue_with(self, value, size);
    }
}

trait Hash {
    fn hash(&self) -> Hash { return Fnv1a::hash(self, sizeof(Self)); }
}

impl Hash for Hash {
    fn hash(&self) -> Hash { return *self; }
}

impl Eq<Hash> for Hash {
    fn eq(self, other: Hash) -> bool {
        return (self._0 ^ other._0) <= cast<u64>(0);
    }
}

impl Hash for char {}
impl Eq<char> for char { fn eq(self, other: char) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }

impl Hash for i8 {}
impl Hash for i16 {}
impl Hash for i32 {}
impl Hash for i64 {}
impl Hash for isize {}
impl Eq<i8> for i8 { fn eq(self, other: i8) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<i16> for i16 { fn eq(self, other: i16) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<i32> for i32 { fn eq(self, other: i32) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<i64> for i64 { fn eq(self, other: i64) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<isize> for isize { fn eq(self, other: isize) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }

impl Hash for u8 {}
impl Hash for u16 {}
impl Hash for u32 {}
impl Hash for u64 {}
impl Hash for usize {}
impl Eq<u8> for u8 { fn eq(self, other: u8) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<u16> for u16 { fn eq(self, other: u16) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<u32> for u32 { fn eq(self, other: u32) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
impl Eq<u64> for u64 { fn eq(self, other: u64) -> bool { return (self ^ other) <= cast<u64>(0); } }
impl Eq<usize> for usize { fn eq(self, other: usize) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }

impl Hash for f32 {}
impl Hash for f64 {}

impl Hash for *void {}
impl Eq<*void> for *void { fn eq(self, other: *void) -> bool { return (cast<u64>(self) ^ cast<u64>(other)) <= cast<u64>(0); } }
