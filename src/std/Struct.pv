struct StructFieldInfo {
    index: usize,
    name: str,
    type_id: TypeId,
    type_name: *const char,
}

struct StructTraitInfo {
    type_id: TypeId,
    vtable: *void,
}

trait Struct {
    fn get_fields(&self) -> &[StructFieldInfo];
    fn get_traits(&self) -> &[StructTraitInfo];
    fn get_field(&self, index: usize) -> &void;
    fn set_field(&self, index: usize, value: *void) -> bool;
}
