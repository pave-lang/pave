trait Format {
    fn format(&self, out: &dyn Writer, info: str);
}

fn format(out: &dyn Writer, fmt: str, parts: ...&dyn Format) {
    let part_i: usize = 0;
    let i: usize = 0;

    while i < fmt.length {
        let start = i;

        while i < fmt.length {
            if fmt.ptr[i] == '{' {
                if i + 1 < fmt.length && fmt.ptr[i + 1] == '{' {
                    out.write(fmt.slice(start, i + 1));
                    i += 2;
                    start = i;
                } else {
                    break;
                }
            } else if fmt.ptr[i] == '}' && i + 1 < fmt.length && fmt.ptr[i + 1] == '}' {
                out.write(fmt.slice(start, i + 1));
                i += 2;
                start = i;
            } else {
                i += 1;
            }
        }

        if start < i {
            out.write(fmt.slice(start, i));
        }

        if i >= fmt.length {
            return;
        }

        let end = i + 1;

        while end < fmt.length && fmt.ptr[end] != '}' {
            end += 1;
        }

        if end >= fmt.length {
            out.write_char(fmt.ptr[i]);
            i += 1;
            continue;
        }

        let info = fmt.slice(i + 1, end);

        if part_i >= parts.length {
            out.write_char('{');
            out.write(info);
            out.write_char('}');
            i = end + 1;
            continue;
        }

        parts[part_i].format(out, info);
        part_i += 1;

        i = end + 1;
    }
}
