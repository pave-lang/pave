#include "stdlib.h"

use std

// Compiler regressions in expressions: `>>`, which the tokenizer leaves as
// two `>` so nested generics close.

test "two touching > shift right, and still close nested generics" {
    let word: u32 = 197121u;
    let nested = Array<Array<u32>>::new(GeneralPurposeAllocator::default());
    if ((word >> 8) & 255u) != 2 || (word >> 16) != 3 || nested.length != 0 { abort(); }
    if !(word > 3) { abort(); }
}
