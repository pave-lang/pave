#include "stdio.h"

use std
use analyzer
use analyzer::types
use analyzer::c

struct IncludeWriter {
    allocator: &ArenaAllocator,
    c_includes: HashSet<str>,
    includes: HashSet<str>,
    type_declarations: HashSet<str>,
}

impl IncludeWriter {
    fn new(allocator: &ArenaAllocator) -> Self {
        return Self {
            allocator,
            c_includes: HashSet<str>::new(allocator),
            includes: HashSet<str>::new(allocator),
            type_declarations: HashSet<str>::new(allocator),
        };
    }

    fn has_unresolved_generic(type: &Type, generics_map: *GenericMap) -> bool {
        match type {
            Type::Indirect(indirect) => {
                return IncludeWriter::has_unresolved_generic(&indirect.to, generics_map);
            },
            Type::Sequence(sequence) => {
                return IncludeWriter::has_unresolved_generic(&sequence.element, generics_map);
            },
            Type::Tuple(tuple) => {
                for element in tuple.elements {
                    if IncludeWriter::has_unresolved_generic(element, generics_map) { return true; }
                }
            },
            Type::Enum(_, type_generics) => {
                if type_generics != null {
                    for generic in type_generics.array {
                        if IncludeWriter::has_unresolved_generic(generic, generics_map) { return true; }
                    }
                }
            },
            Type::Struct(_, type_generics) => {
                if type_generics != null {
                    for generic in type_generics.array {
                        if IncludeWriter::has_unresolved_generic(generic, generics_map) { return true; }
                    }
                }
            },
            Type::Trait(_, type_generics) => {
                if type_generics != null {
                    for generic in type_generics.array {
                        if IncludeWriter::has_unresolved_generic(generic, generics_map) { return true; }
                    }
                }
            },
            Type::Function(_, type_generics) => {
                if type_generics != null {
                    for generic in type_generics.array {
                        if IncludeWriter::has_unresolved_generic(generic, generics_map) { return true; }
                    }
                }
            },
            Type::Generic(generic) => {
                let generic_name = generic.name;
                if generic_name == null { return false; }
                if generics_map == null { return true; }
                let concrete_type = generics_map.get(generic_name.value);
                if concrete_type == null { return true; }
                match concrete_type {
                    Type::Generic(concrete_generic) => {
                        let concrete_name = concrete_generic.name;
                        if concrete_name != null && concrete_name.value.eq(generic_name.value) { return true; }
                    },
                    _ => {},
                }
                return IncludeWriter::has_unresolved_generic(concrete_type, generics_map);
            },
            Type::GenericTypedef(gt) => {
                return IncludeWriter::has_unresolved_generic(&Type::Generic(gt.generic), generics_map);
            },
            Type::Self => {
                return generics_map == null || generics_map.self_type == null;
            },
            _ => {},
        }

        return false;
    }

    fn write(&self, file: &FILE, generator: &Generator, types: &HashMap<str, Type>, generics: &GenericMap, deref: bool) {
        let c_includes = HashSet<str>::new(self.allocator);
        defer c_includes.release();
        let includes = HashSet<str>::new(self.allocator);
        defer includes.release();
        let type_declarations = HashSet<str>::new(self.allocator);
        defer type_declarations.release();

        for (_, &type) in types {
            let resolved = Context::resolve_type(self.allocator, type, generics, null);
            if resolved == null { continue; }
            let resolved_nn: &Type = if deref { resolved.deref_all() } else { resolved };

            let found_type_impl_header = false;
            for *type_impl in generator.root.type_impls {
                if type_impl.impl_info.generics.array.length != 0 { continue; }
                if !generator.root.type_impl_target_eq(&type_impl.type, resolved) { continue; }

                found_type_impl_header = true;
                let include_type = &type_impl.type;
                if include_type.is_fat_pointer() {
                    include_type = include_type.deref_1();
                    if include_type == null { include_type = &type_impl.type; }
                }
                let name = generator.naming_ident.get_type_name(include_type, generics.self_type, generics);
                let path = generator.make_rel_path(type_impl.impl_info.context.module, name.as_str(), "");
                if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
            }
            if found_type_impl_header { continue; }

            match resolved_nn {
                Type::Indirect(_) => {
                    let type_deref = resolved_nn.deref_all();

                    match type_deref {
                        Type::Trait(_, _) => {
                            let name = generator.naming_ident.get_type_name(type_deref, generics.self_type, generics);
                            let module = type_deref.get_module();
                            let path = generator.make_rel_path(module, name.as_str(), "");
                            if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                        },
                        Type::Struct(struct_info, _) => {
                            let name = generator.naming_c99.get_type_name(type_deref, generics.self_type, generics);

                            if struct_info.is_newtype() {
                                let typedef_info = TypedefC { include: null, name: name.as_str(), type: &struct_info.fields.data[0].value.type };
                                let typedef_type = Type::TypedefC(&typedef_info);
                                let type_declaration = generator.naming_c99.get_type_decl(&typedef_type, generics.self_type, generics);
                                if self.type_declarations.insert(type_declaration.as_str()) { type_declarations.insert(type_declaration.as_str()); }
                            } else {
                                if self.type_declarations.insert(name.as_str()) { type_declarations.insert(name.as_str()); }
                            }

                        },
                        Type::Enum(enum_info, _) => {
                            if enum_info.is_discriminated_union() {
                                let name = generator.naming_c99.get_type_name(type_deref, generics.self_type, generics);
                                if type_declarations.insert(name.as_str()) { type_declarations.insert(name.as_str()); }
                            } else {
                                let name = generator.naming_ident.get_type_name(type_deref, generics.self_type, generics);
                                let module = type_deref.get_module();
                                let path = generator.make_rel_path(module, name.as_str(), "");
                                if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                            }
                        },
                        Type::StructC(_) => {
                            let name = generator.naming_c99.get_type_name(type_deref, generics.self_type, generics);
                            if self.type_declarations.insert(name.as_str()) { type_declarations.insert(name.as_str()); }
                        },
                        Type::EnumC(_) => {
                            let name = generator.naming_c99.get_type_name(type_deref, generics.self_type, generics);
                            if self.type_declarations.insert(name.as_str()) { type_declarations.insert(name.as_str()); }
                        },
                        Type::UnionC(_) => {
                            let name = generator.naming_c99.get_type_name(type_deref, generics.self_type, generics);
                            if self.type_declarations.insert(name.as_str()) { type_declarations.insert(name.as_str()); }
                        },
                        Type::FunctionC(info) => {
                            if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                        },
                        Type::TypedefC(info) => {
                            if info.include != null && self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                        },
                        Type::ClassCpp(info) => {
                            if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                        },
                        Type::UnknownC(info) => {
                            if info.include != null && self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                        },
                        _ => {},
                    }
                },
                Type::Global(g) => {
                    let path = generator.make_rel_path(g.module, g.name.value, "");
                    if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                },
                Type::Function(func_info, func_generic_map) => {
                    match func_info.parent {
                        FunctionParent::None => {
                            if func_generic_map == null { continue; }
                            let context = func_info.context;
                            if context == null { continue; }
                            let name = generator.naming_ident.get_type_name(&Type::Function(func_info, func_generic_map), func_generic_map.self_type, func_generic_map);
                            let module = context.module;
                            let path = generator.make_rel_path(module, name.as_str(), "");
                            if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                        },
                        FunctionParent::Primitive(primitive_info, _, _) => {
                            let name = primitive_info.name;
                            let path = generator.make_rel_path(null, name, "");
                            if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                        },
                        FunctionParent::Trait(_) => {},
                        FunctionParent::Type(type_info, impl_index, _) => {
                            let include_generics: &GenericMap = generics;
                            if func_generic_map != null {
                                let resolved_generics = (*func_generic_map).resolve_types(self.allocator, generics);
                                include_generics = &resolved_generics;
                            }

                            let include_type = type_info;
                            if type_info.is_fat_pointer() {
                                include_type = type_info.deref_1();
                                if include_type == null { include_type = type_info; }
                            }

                            let resolved_include_type = Context::resolve_type(self.allocator, include_type, include_generics, generics);
                            if resolved_include_type != null { include_type = resolved_include_type; }

                            if IncludeWriter::has_unresolved_generic(include_type, include_generics) {
                                fprintf(stderr, "IncludeWriter.write: unresolved generic while writing type impl include\n");
                            }

                            let name = generator.naming_ident.get_type_name(include_type, include_generics.self_type, include_generics);
                            let module = include_type?.get_module();
                            let type_impl = generator.root.get_type_impl(type_info, impl_index);
                            if type_impl != null { module = type_impl.impl_info.context.module; }
                            let path = generator.make_rel_path(module, name.as_str(), "");
                            if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                        },
                        _ => {},
                    }

                },
                Type::EnumC(info) => {
                    if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::StructC(info) => {
                    if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::UnionC(info) => {
                    if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::TypedefC(info) => {
                    if info.include != null && self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::FunctionC(info) => {
                    if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::ClassCpp(info) => {
                    if self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                Type::UnknownC(info) => {
                    if info.include != null && self.c_includes.insert(info.include.path) { c_includes.insert(info.include.path); }
                },
                _ => {
                    let name = generator.naming_ident.get_type_name(resolved_nn, generics.self_type, generics);
                    let module = resolved_nn.get_module();

                    let path = generator.make_rel_path(module, name.as_str(), "");
                    if self.includes.insert(path.as_str()) { includes.insert(path.as_str()); }
                },
            }
        }

        for *include in c_includes {
            fprintf(file, "#include <%.*s>\n", cast<i32>(include.length - 2), include.ptr + 1);
        }

        for *include in includes {
            fprintf(file, "#include <%.*s.h>\n", cast<i32>(include.length), include.ptr);
        }

        for *type_declaration in type_declarations {
            fprintf(file, "%.*s;\n", cast<i32>(type_declaration.length), type_declaration.ptr);
        }
    }

    fn release(&self) {
        self.includes.release();
    }
}
