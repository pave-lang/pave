#include "stdio.h"

use std
use analyzer
use analyzer::expression
use analyzer::statement
use analyzer::types

struct TypeFunctionUsage {
    allocator: &ArenaAllocator,
    type: &Function,
    usage_contexts: Array<UsageContext>,
    impl_dynamic_function: bool,
}

impl TypeFunctionUsage {
    fn new(allocator: &ArenaAllocator, type: &Function) -> Self {
        return Self {
            allocator,
            type,
            impl_dynamic_function: false,
            usage_contexts: Array<UsageContext>::new(allocator),
        };
    }

    fn add_usage(&self, generic_map: &GenericMap) -> &UsageContext {
        let usage_context = UsageContext::new(self.allocator, generic_map);
        usage_context.function_context = FunctionContext::new(self.allocator, self.type, false);
        usage_context.impl_dynamic_function = self.impl_dynamic_function;
        let index = self.usage_contexts.append(usage_context);
        return &self.usage_contexts.data[index];
    }
}

enum UsageMode {
    Layout,
    Signature,
    Body,
}

struct UsageContext {
    generic_map: &GenericMap,
    function_context: FunctionContext,
    impl_dynamic_function: bool,
    primitive_header: HashSet<str>,
    primitive_code: HashSet<str>,
    layout: HashMap<str, Type>,
    signature: HashMap<str, Type>,
    body: HashMap<str, Type>,
    cpp_usages: HashMap<str, Type>,
    impl_functions: Array<HashMap<usize, TypeFunctionUsage>>,
}

impl UsageContext {
    fn new(allocator: &ArenaAllocator, generic_map: &GenericMap) -> Self {
        return Self {
            generic_map,
            function_context: FunctionContext::new_const(allocator),
            impl_dynamic_function: false,
            primitive_header: HashSet<str>::new(allocator),
            primitive_code: HashSet<str>::new(allocator),
            layout: HashMap<str, Type>::new(allocator),
            signature: HashMap<str, Type>::new(allocator),
            body: HashMap<str, Type>::new(allocator),
            cpp_usages: HashMap<str, Type>::new(allocator),
            impl_functions: Array<HashMap<usize, TypeFunctionUsage>> { allocator, data: null, length: 0, capacity: 0 },
        };
    }

    fn populate_impls(&self, allocator: &ArenaAllocator, impls: &Array<&Impl>) {
        let impl_count = impls.length;
        self.impl_functions = Array<HashMap<usize, TypeFunctionUsage>>::new(allocator);
        self.impl_functions.reserve(impl_count);
        self.impl_functions.length = impl_count;

        let i: usize = 0;
        for *impl_info in impls {
            self.impl_functions.data[i] = HashMap<usize, TypeFunctionUsage>::new(allocator);
            for (_, &func_info) in impl_info.functions {
                self.impl_functions.data[i].insert(cast<usize>(func_info), TypeFunctionUsage::new(allocator, func_info));
            }
            let trait_info = impl_info.trait_;
            if trait_info != null {
                for (func_base_name, &func_info) in trait_info.functions {
                    if impl_info.functions.find(&func_base_name) != null { continue; }
                    self.impl_functions.data[i].insert(cast<usize>(func_info), TypeFunctionUsage::new(allocator, func_info));
                }
            }
            i += 1;
        }
    }

    fn populate_trait_functions(&self, allocator: &ArenaAllocator, trait_info: &Trait) {
        self.impl_functions = Array<HashMap<usize, TypeFunctionUsage>>::new(allocator);
        self.impl_functions.reserve(1);
        self.impl_functions.length = 1;
        self.impl_functions.data[0] = HashMap<usize, TypeFunctionUsage>::new(allocator);

        for (_, &func_info) in trait_info.functions {
            self.impl_functions.data[0].insert(cast<usize>(func_info), TypeFunctionUsage::new(allocator, func_info));
        }
    }

    fn apply_pending_dynamic_functions(&self, dynamic_impl_functions: &HashSet<usize>) {
        for *impl_functions_for_impl in self.impl_functions {
            for (func_ptr, &function_usage) in impl_functions_for_impl {
                if dynamic_impl_functions.has(&func_ptr) {
                    function_usage.impl_dynamic_function = true;
                }
            }
        }
    }
}

struct TypeUsage<T> {
    allocator: &ArenaAllocator,
    type: &T,
    usage_contexts: Array<UsageContext>,
    impl_dynamic_usage: bool,
    any_usage: bool,
}

impl<T> TypeUsage<T> {
    fn new(allocator: &ArenaAllocator, type: &T) -> Self {
        return Self {
            allocator,
            type,
            usage_contexts: Array<UsageContext>::new(allocator),
            impl_dynamic_usage: false,
            any_usage: false,
        };
    }

    fn add_usage(&self, generic_map: &GenericMap) -> &UsageContext {
        let usage_context = UsageContext::new(self.allocator, generic_map);
        let index = self.usage_contexts.append(usage_context);
        return &self.usage_contexts.data[index];
    }
}

struct Usages {
    allocator: &ArenaAllocator,
    generator: &Generator,
    root: &Root,
    naming_ident: &Naming,

    usages: Array<Type>,
    usage_types: HashSet<str>,
    usage_traits: HashSet<str>,

    primitives: HashMap<usize, TypeUsage<Primitive>>,
    functions: HashMap<usize, TypeFunctionUsage>,
    structs: HashMap<usize, TypeUsage<Struct>>,
    enums: HashMap<usize, TypeUsage<Enum>>,
    traits: HashMap<usize, TypeUsage<Trait>>,
    sequences: HashMap<usize, TypeUsage<Sequence>>,
    tuples: HashMap<usize, TypeUsage<Tuple>>,
    type_impls: HashMap<usize, TypeUsage<TypeImpl>>,
    dynamic_impl_functions: HashSet<usize>,

    usage_mode: UsageMode,
    usage_context: *UsageContext,
    function_context: *FunctionContext,
    active_impl_index: usize,

    std_namespace: *Namespace,
}

impl Usages {
    fn new(generator: &Generator) -> Self {
        let allocator = generator.allocator;

        let self = Self {
            allocator,
            generator,
            root: generator.root,
            naming_ident: &generator.naming_ident,

            usages: Array<Type>::new(allocator),
            usage_types: HashSet<str>::new(allocator),
            usage_traits: HashSet<str>::new(allocator),

            primitives: HashMap<usize, TypeUsage<Primitive>>::new(allocator),
            functions: HashMap<usize, TypeFunctionUsage>::new(allocator),
            structs: HashMap<usize, TypeUsage<Struct>>::new(allocator),
            enums: HashMap<usize, TypeUsage<Enum>>::new(allocator),
            traits: HashMap<usize, TypeUsage<Trait>>::new(allocator),
            sequences: HashMap<usize, TypeUsage<Sequence>>::new(allocator),
            tuples: HashMap<usize, TypeUsage<Tuple>>::new(allocator),
            type_impls: HashMap<usize, TypeUsage<TypeImpl>>::new(allocator),
            dynamic_impl_functions: HashSet<usize>::new(allocator),

            std_namespace: generator.root.find_namespace("std"),
            usage_mode: UsageMode::Layout,
            usage_context: null,
            function_context: null,
            active_impl_index: 0,
        };

        for (_, &info) in self.root.primitives {
            if info.impls.length > 0 {
                let primitive_ptr = cast<usize>(info);
                self.primitives.insert(primitive_ptr, TypeUsage<Primitive>::new(self.allocator, info));
                self.usages.append(Type::Primitive(info));
            }
        }

        self.add_namespace(&self.root.children);

        let type_impl_i: usize = 0;
        while type_impl_i < self.root.type_impls.length {
            let type_impl = &self.root.type_impls.data[type_impl_i];
            if type_impl.impl_info.generics.array.length == 0 {
                self.type_impls.insert(cast<usize>(type_impl), TypeUsage<TypeImpl>::new(self.allocator, type_impl));
                self.usages.append(type_impl.type);
            }
            type_impl_i += 1;
        }

        let usage_i: usize = 0;
        while usage_i < self.usages.length {
            let usage = self.usages.data[usage_i];
            self.usage_mode = UsageMode::Layout;

            match usage {
                Type::Primitive(primitive_info) => { self.process_primitive(primitive_info); },
                Type::Struct(struct_info, generic_map) => { self.process_struct(struct_info, generic_map); },
                Type::Enum(enum_info, generic_map) => { self.process_enum(enum_info, generic_map); },
                Type::Trait(trait_info, generic_map) => { self.process_trait(trait_info, generic_map); },
                Type::Function(func_info, generic_map) => { self.process_function(func_info, generic_map); },
                Type::Sequence(sequence) => { self.process_sequence(sequence); },
                Type::Tuple(tuple) => { self.process_tuple(tuple); },
                _ => {},
            }

            usage_i += 1;
        }

        for (_, &usage) in self.type_impls {
            self.process_type_impl(usage.type);
        }

        self.normalize();

        return self;
    }

    fn add_namespace(&self, children: &HashMap<str, &Namespace>) {
        for (_, namespace) in children {
            for (_, module) in namespace.modules {
                self.add_module(module);
            }

            self.add_namespace(&namespace.children);
        }
    }

    fn add_module(&self, module: &Module) {
        for (_, &func_info) in module.functions {
            self.functions.insert(cast<usize>(func_info), TypeFunctionUsage::new(self.allocator, func_info));

            let name = func_info.name;
            if name == null || func_info.generics.array.length != 0 { continue; }

            if !self.usage_types.insert(name.value) { continue; }

            let generic_map = self.allocator.store(&GenericMap { self_type: null, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
            if generic_map == null { continue; }
            let self_type = self.allocator.store(&Type::Function(func_info, generic_map));
            generic_map.self_type = self_type;
            self.usages.append(Type::Function(func_info, generic_map));
        }

        for (_, &enum_arr) in module.enums {
            for *enum_info in enum_arr {
                self.enums.insert(cast<usize>(enum_info), TypeUsage<Enum>::new(self.allocator, enum_info));
                
                let name = enum_info.name;
                if name != null && enum_info.generics.array.length == 0 && self.usage_types.insert(name.value) {
                    let generic_map = self.allocator.store(&GenericMap { self_type: null, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
                    let self_type = self.allocator.store(&Type::Enum(enum_info, generic_map));
                    if generic_map != null { generic_map.self_type = self_type; }
                    self.usages.append(Type::Enum(enum_info, generic_map));
                }
            }
        }

        for (_, &struct_arr) in module.structs {
            for *struct_info in struct_arr {
                self.structs.insert(cast<usize>(struct_info), TypeUsage<Struct>::new(self.allocator, struct_info));

                let name = struct_info.name;
                if name != null && struct_info.generics.array.length == 0 && self.usage_types.insert(name.value) {
                    let generic_map = self.allocator.store(&GenericMap { self_type: null, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
                    let self_type = self.allocator.store(&Type::Struct(struct_info, generic_map));
                    if generic_map != null { generic_map.self_type = self_type; }
                    self.usages.append(Type::Struct(struct_info, generic_map));
                }
            }
        }

        for (_, &trait_arr) in module.traits {
            for *trait_info in trait_arr {
                self.traits.insert(cast<usize>(trait_info), TypeUsage<Trait>::new(self.allocator, trait_info));

                let name = trait_info.name;
                if name != null && trait_info.generics.array.length == 0 && self.usage_traits.insert(name.value) {
                    let generic_map = self.allocator.store(&GenericMap { self_type: null, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
                    let self_type = self.allocator.store(&Type::Trait(trait_info, generic_map));
                    if generic_map != null { generic_map.self_type = self_type; }
                    self.usages.append(Type::Trait(trait_info, generic_map));
                }
            }
        }
    }

    fn add_type(&self, type: &Type, generic_map: &GenericMap) {
        let resolved_type = Context::resolve_type(self.allocator, type, generic_map, null);
        if resolved_type == null { return; }

        let type_deref = resolved_type.deref();
        let type_deref_all = resolved_type.deref_all();
        let is_type = false;
        let is_trait = false;
        let usage_context = self.usage_context;
        if usage_context == null { return; }

        match type_deref {
            Type::Global(g) => {
                let path = self.generator.make_rel_path(g.module, g.name.value, "");
                if self.usage_mode == UsageMode::Body {
                    usage_context.body.insert(path.as_str(), *type);
                }
                return;
            },
            Type::Indirect(_) => {
                match type_deref_all {
                    Type::Primitive(primitive_info) => {
                        if primitive_info == null { return; }
                        if self.usage_mode == UsageMode::Layout || self.usage_mode == UsageMode::Signature {
                            usage_context.primitive_header.insert(primitive_info.name);
                        } else {
                            usage_context.primitive_code.insert(primitive_info.name);
                        }

                        return;
                    },
                    Type::Trait(trait_info, _) => { is_trait = trait_info.has_dynamic_dispatch(); },
                    _ => {},
                }
            },
            Type::Primitive(primitive_info) => {
                if primitive_info == null { return; }
                if self.usage_mode == UsageMode::Layout || self.usage_mode == UsageMode::Signature {
                    usage_context.primitive_header.insert(primitive_info.name);
                } else {
                    usage_context.primitive_code.insert(primitive_info.name);
                }
            },
            Type::Struct(_, _) => { is_type = true; },
            Type::Enum(_, _) => { is_type = true; },
            Type::Function(func_info, type_generic_map) => {
                is_type = func_info.type != FunctionType::Builtin && func_info.generics.array.length > 0;

                match func_info.parent {
                    FunctionParent::None => {
                        is_type = (func_info.type == FunctionType::Standard || func_info.type == FunctionType::Coroutine) && func_info.name != null;
                    },
                    FunctionParent::Primitive(primitive_info, _, _) => {
                        self.add_type(&Type::Primitive(primitive_info), generic_map);
                        is_type = true;
                    },
                    FunctionParent::Struct(struct_info, _, _) => {
                        self.add_type(&Type::Struct(struct_info, type_generic_map), generic_map);
                    },
                    FunctionParent::Enum(enum_info, _, _) => {
                        self.add_type(&Type::Enum(enum_info, type_generic_map), generic_map);
                    },
                    FunctionParent::Trait(trait_info) => {
                        self.add_type(&Type::Trait(trait_info, type_generic_map), generic_map);
                    },
                    FunctionParent::Type(type_info, _, _) => {
                        self.add_type(type_info, type_generic_map);
                        if func_info.generics.array.length == 0 {
                            let function_generic_map: &GenericMap = generic_map;
                            if type_generic_map != null { function_generic_map = type_generic_map; }
                            let function_type = Type::Function(func_info, function_generic_map);
                            let function_type_name = self.naming_ident.get_type_name(&function_type, function_generic_map.self_type, function_generic_map);
                            match self.usage_mode {
                                UsageMode::Layout => { usage_context.layout.insert(function_type_name.as_str(), function_type); },
                                UsageMode::Signature => { usage_context.signature.insert(function_type_name.as_str(), function_type); },
                                UsageMode::Body => { usage_context.body.insert(function_type_name.as_str(), function_type); },
                            }
                        }
                    },
                }
            },
            Type::Trait(trait_info, _) => { is_trait = trait_info.has_dynamic_dispatch(); },
            Type::Sequence(sequence) => {
                match sequence.type {
                    SequenceType::FixedArray(expression) => {
                        self.process_expression(expression, generic_map);
                    },
                    SequenceType::Slice => {
                        is_type = sequence.is_slice();
                        type = type_deref;
                        resolved_type = type_deref;
                    }
                }
            },
            Type::Tuple(_) => { is_type = true; },
            Type::StructC(struct_c) => { is_type = !struct_c.include.mode_cpp; },
            Type::UnionC(union_c) => { is_type = !union_c.include.mode_cpp; },
            Type::EnumC(enum_c) => { is_type = !enum_c.include.mode_cpp; },
            Type::UnknownC(unknown_c) => { is_type = unknown_c.include != null; },
            Type::FunctionC(_) => { is_type = true; },
            Type::TypedefC(typedef_c) => {
                let include = typedef_c.include;
                if include == null { return; }
                is_type = !include.mode_cpp;
            },
            Type::ClassCpp(class_info) => {
                if self.usage_mode != UsageMode::Body {
                    usage_context.cpp_usages.insert(class_info.name, *type);
                } else {
                    let include = class_info.include;
                    is_type = include.mode_cpp;
                }
            },
            _ => {},
        }

        if !is_type && !is_trait { return; }

        let type_name_generic = self.naming_ident.get_type_name(resolved_type, generic_map.self_type, generic_map);

        match self.usage_mode {
            UsageMode::Layout => { usage_context.layout.insert(type_name_generic.as_str(), *resolved_type); },
            UsageMode::Signature => { usage_context.signature.insert(type_name_generic.as_str(), *resolved_type); },
            UsageMode::Body => { usage_context.body.insert(type_name_generic.as_str(), *resolved_type); },
        }
        
        if !is_type && !is_trait { return; }

        let type_name = self.root.naming_decl.get_type_name(type_deref_all, generic_map.self_type, generic_map);
        let type_name_str = type_name.as_str();

        if (is_type && !self.usage_types.insert(type_name_str)) || (is_trait && !self.usage_traits.insert(type_name_str)) {
            type_name.release();
            return;
        }

        self.usages.append(*type_deref_all);
    }

    fn add_type_impl_header(&self, self_type: &Type) {
        let usage_context = self.usage_context;
        if usage_context == null { return; }

        let type_name = self.naming_ident.get_type_name(self_type, self_type, &GenericMap { self_type, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
        usage_context.body.insert(type_name.as_str(), *self_type);
    }

    fn process_impls(&self, impls: &Array<&Impl>, generic_map: &GenericMap) {
        self.usage_mode = UsageMode::Signature;

        for (impl_index, *impl_info) in impls.iter().enumerate() {
            self.active_impl_index = impl_index;

            if impl_info.has_trait {
                self.add_type(&impl_info.trait_type, generic_map);

                if impl_info.trait_ != null && !impl_info.trait_.has_dynamic_dispatch() {
                    for (_, &func_info) in impl_info.functions {
                        for param in func_info.parameters {
                            self.add_type(&param.type, generic_map);
                        }
                        self.add_type(&func_info.return_type, generic_map);
                    }
                }
            }

            for (_, &func_info) in impl_info.functions {
                if func_info.generics.array.length > 0 { continue; }
                self.process_function(func_info, generic_map);
            }

            let trait_info = impl_info.trait_;
            if trait_info != null {
                for (func_base_name, &func_info) in trait_info.functions {
                    if impl_info.functions.find(&func_base_name) != null { continue; }
                    self.process_function(func_info, generic_map);
                }
            }
        }

        self.active_impl_index = 0;
    }

    fn process_type_impl(&self, type_impl: &TypeImpl) {
        let entry_usage_context = self.usage_context;
        let generic_map_val = GenericMap::new(self.allocator, &type_impl.impl_info.generics, &Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 });
        let generic_map = self.allocator.store(&generic_map_val);
        if generic_map == null { return; }
        generic_map.self_type = &type_impl.type;

        let parent_ptr = cast<usize>(type_impl);
        let parent_usage = self.type_impls.find(&parent_ptr);
        if parent_usage == null { return; }

        let usage_context = parent_usage.add_usage(generic_map);
        let impls_base = [type_impl.impl_info];
        let impls = Array<&Impl> { data: impls_base, length: impls_base.length, allocator: self.allocator, capacity: 0 };
        usage_context.populate_impls(self.allocator, &impls);
        usage_context.apply_pending_dynamic_functions(&self.dynamic_impl_functions);

        self.usage_context = usage_context;
        self.process_impls(&impls, generic_map);

        self.usage_context = entry_usage_context;
    }

    fn process_primitive(&self, primitive_info: &Primitive) {
        let entry_usage_context = self.usage_context;
        let self_type = self.allocator.store(&Type::Primitive(primitive_info));
        let generic_map = self.allocator.store(&GenericMap { self_type, array: Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } });
        if generic_map == null { return; }

        let parent_ptr = cast<usize>(primitive_info);
        let parent_usage = self.primitives.find(&parent_ptr);
        if parent_usage == null { return; }

        let usage_context = parent_usage.add_usage(generic_map);
        usage_context.populate_impls(self.allocator, &primitive_info.impls);
        usage_context.apply_pending_dynamic_functions(&self.dynamic_impl_functions);

        self.usage_context = usage_context;

        self.process_impls(&primitive_info.impls, generic_map);

        self.usage_context = entry_usage_context;
    }

    fn process_sequence(&self, sequence: &Sequence) {
        let entry_usage_context = self.usage_context;
        let generic_map_val = GenericMap::new(self.allocator, &Generics { parent: null, array: Array<Generic> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } }, &Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 });
        let generic_map = self.allocator.store(&generic_map_val);
        if generic_map == null { return; }
        generic_map.insert("T", sequence.element);
        let sequence_type = Type::Sequence(sequence);
        let indirect = self.allocator.store(&Indirect { type: IndirectType::Reference, to: sequence_type });
        if indirect == null { return; }
        generic_map.self_type = self.allocator.store(&Type::Indirect(indirect));
        if generic_map.self_type == null { return; }

        let parent_ptr = cast<usize>(sequence);
        let parent_usage = self.sequences.find(&parent_ptr);
        if parent_usage == null {
            parent_usage = self.sequences.insert(parent_ptr, TypeUsage<Sequence>::new(self.allocator, sequence));
        }
        if parent_usage == null { return; }

        let usage_context = parent_usage.add_usage(generic_map);
        self.usage_context = usage_context;

        self.add_type(&sequence.element, generic_map);

        if self.std_namespace != null {
            let iter_type = self.std_namespace.find_type("Iter", 1);
            if iter_type != null {
                let element_reference = Type::Indirect(Indirect::new_reference(self.allocator, sequence.element));
                let sequence_iter = self.root.make_type_usage(iter_type, &Array<Type> { data: &element_reference, length: 1, allocator: self.allocator, capacity: 0 });
                if sequence_iter != null {
                    self.add_type(sequence_iter, generic_map);
                }
            }
        }

        let root_hack_type = self.root.hack_type_impl;
        if root_hack_type != null {
            let impl_info = root_hack_type.impl_info;

            match sequence.element.deref_all() {
                Type::Generic(_) => {},
                Type::GenericTypedef(_) => {},
                _ => {
                    for (_, &func_info) in impl_info.functions {
                        self.process_function(func_info, generic_map);
                    }
                },
            }
        }

        self.usage_context = entry_usage_context;
    }

    fn process_tuple(&self, tuple: &Tuple) {
        let entry_usage_context = self.usage_context;
        let generic_map_val = GenericMap::new(self.allocator, &Generics { parent: null, array: Array<Generic> { allocator: self.allocator, data: null, length: 0, capacity: 0 }, map: HashMap<str, usize> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 } }, &Array<Type> { allocator: self.allocator, data: null, length: 0, capacity: 0 });
        let generic_map = self.allocator.store(&generic_map_val);
        let tuple_type = Type::Tuple(tuple);

        let parent_ptr = cast<usize>(tuple);
        let parent_usage = self.tuples.find(&parent_ptr);
        if parent_usage == null { parent_usage = self.tuples.insert(parent_ptr, TypeUsage<Tuple>::new(self.allocator, tuple)); }
        if parent_usage == null { return; }

        self.usage_context = parent_usage.add_usage(generic_map);
        self.usage_mode = UsageMode::Layout;

        let indirect = self.allocator.store(&Indirect { type: IndirectType::Reference, to: tuple_type });
        if generic_map != null { generic_map.self_type = self.allocator.store(&Type::Indirect(indirect)); }

        for element in tuple.elements {
            self.add_type(element, generic_map);
        }

        self.usage_context = entry_usage_context;
    }

    fn process_struct(&self, struct_info: &Struct, generic_map: &GenericMap) {
        let entry_usage_context = self.usage_context;
        let parent_ptr = cast<usize>(struct_info);
        let parent_usage = self.structs.find(&parent_ptr);
        if parent_usage == null { return; }
        let usage_context = parent_usage.add_usage(generic_map);
        usage_context.populate_impls(self.allocator, &struct_info.impls);
        usage_context.apply_pending_dynamic_functions(&self.dynamic_impl_functions);

        self.usage_context = usage_context;
        self.usage_mode = UsageMode::Layout;

        for (_, &field) in struct_info.fields {
            self.add_type(&field.type, generic_map);

            match field.type.deref_all() {
                Type::Function(param_func_info, param_generic_map) => {
                    if param_generic_map == null { continue; }
                    let resolved_generic_map = param_generic_map.resolve_types(self.allocator, generic_map);

                    for param in param_func_info.parameters {
                        self.add_type(&param.type, &resolved_generic_map);
                    }
                    self.add_type(&param_func_info.return_type, &resolved_generic_map);
                },
                Type::Sequence(sequence) => {
                    if sequence.is_fixed_array() {
                        self.add_type(&sequence.element, generic_map);
                    }
                },
                _ => {},
            }
        }

        self.process_impls(&struct_info.impls, generic_map);

        self.usage_context = entry_usage_context;
    }

    fn process_enum(&self, enum_info: &Enum, generic_map: &GenericMap) {
        let entry_usage_context = self.usage_context;
        let parent_ptr = cast<usize>(enum_info);
        let parent_usage = self.enums.find(&parent_ptr);
        if parent_usage == null { return; }
        let usage_context = parent_usage.add_usage(generic_map);
        usage_context.populate_impls(self.allocator, &enum_info.impls);
        usage_context.apply_pending_dynamic_functions(&self.dynamic_impl_functions);

        self.usage_context = usage_context;

        self.usage_mode = UsageMode::Layout;

        for (_, &variant) in enum_info.variants {
            for type in variant.types {
                self.add_type(type, generic_map);
            }
        }

        self.process_impls(&enum_info.impls, generic_map);

        self.usage_context = entry_usage_context;
    }

    fn process_trait(&self, trait_info: &Trait, generic_map: &GenericMap) {
        let entry_usage_context = self.usage_context;
        let parent_ptr = cast<usize>(trait_info);
        let parent_usage = self.traits.find(&parent_ptr);
        if parent_usage == null { return; }
        let usage_context = parent_usage.add_usage(generic_map);
        usage_context.populate_trait_functions(self.allocator, trait_info);
        
        self.usage_context = usage_context;

        for (_, &func_info) in trait_info.functions {
            self.process_function(func_info, generic_map);
        }

        self.usage_context = entry_usage_context;
    }

    fn usage_context_matches(uc: &UsageContext, generics: &Generics, generic_map: &GenericMap) -> bool {
        for *generic in generics.array {
            let generic_name = generic.name;
            if generic_name == null { return false; }
            let parent_v = uc.generic_map.get(generic_name.value);
            let func_v = generic_map.get(generic_name.value);
            if parent_v == null { return false; }
            if func_v == null { return false; }
            let parent_t: Type = *parent_v;
            if !parent_t.eq(func_v) { return false; }
        }
        return true;
    }

    fn find_parent_usage_context_struct(&self, struct_info: &Struct, generic_map: &GenericMap) -> *UsageContext {
        let parent_ptr = cast<usize>(struct_info);
        let parent_usage = self.structs.find(&parent_ptr);
        if parent_usage == null { return null; }
        for i in 0..parent_usage.usage_contexts.length {
            let uc = &parent_usage.usage_contexts.data[i];
            if Usages::usage_context_matches(uc, &struct_info.generics, generic_map) { return uc; }
        }
        return null;
    }

    fn find_parent_usage_context_enum(&self, enum_info: &Enum, generic_map: &GenericMap) -> *UsageContext {
        let parent_ptr = cast<usize>(enum_info);
        let parent_usage = self.enums.find(&parent_ptr);
        if parent_usage == null { return null; }
        for i in 0..parent_usage.usage_contexts.length {
            let uc = &parent_usage.usage_contexts.data[i];
            if Usages::usage_context_matches(uc, &enum_info.generics, generic_map) { return uc; }
        }
        return null;
    }

    fn mark_any_usage(&self, type: &Type) {
        match type {
            Type::Struct(struct_info, _) => {
                let ptr = cast<usize>(struct_info);
                let usage = self.structs.find(&ptr);
                if usage != null { usage.any_usage = true; }
            },
            Type::Enum(enum_info, _) => {
                let ptr = cast<usize>(enum_info);
                let usage = self.enums.find(&ptr);
                if usage != null { usage.any_usage = true; }
            },
            Type::Primitive(primitive_info) => {
                if primitive_info == null { return; }
                let ptr = cast<usize>(primitive_info);
                let usage = self.primitives.find(&ptr);
                if usage != null { usage.any_usage = true; }
            },
            _ => {},
        }
    }

    fn find_parent_usage_context_primitive(&self, primitive_info: &Primitive, generic_map: &GenericMap) -> *UsageContext {
        let parent_ptr = cast<usize>(primitive_info);
        let parent_usage = self.primitives.find(&parent_ptr);
        if parent_usage == null { return null; }
        // primitives have no generics — just use the first usage_context
        if parent_usage.usage_contexts.length > 0 {
            return &parent_usage.usage_contexts.data[0];
        }
        return null;
    }

    fn process_function(&self, func_info: &Function, generic_map: &GenericMap) {
        let entry_usage_context = self.usage_context;
        let parent_usage_context: *UsageContext = null;

        if func_info.type == FunctionType::Builtin { return; }

        let func_ptr = cast<usize>(func_info);

        match func_info.parent {
            FunctionParent::None => {
                let func_usage = self.functions.find(&func_ptr);
                if func_usage == null { return; }
                let usage_context = func_usage.add_usage(generic_map);
                self.usage_context = usage_context;
                self.function_context = &usage_context.function_context;
            },
            FunctionParent::Primitive(primitive_info, impl_index, _) => {
                if entry_usage_context != null && entry_usage_context.impl_functions.length > impl_index {
                    parent_usage_context = entry_usage_context;
                } else {
                    parent_usage_context = self.find_parent_usage_context_primitive(primitive_info, generic_map);
                }
                if parent_usage_context == null { return; }

                let impl_functions = parent_usage_context.impl_functions.get(impl_index);
                if impl_functions == null { return; }
                let func_usage = impl_functions.find(&func_ptr);
                if func_usage == null { self.usage_context = entry_usage_context; return; }
                let function_usage_context = func_usage.add_usage(generic_map);
                if func_info.generics.array.length > 0 || entry_usage_context == null {
                    self.usage_context = function_usage_context;
                } else {
                    self.usage_context = parent_usage_context;
                }
                self.function_context = &function_usage_context.function_context;
            },
            FunctionParent::Struct(struct_info, impl_index, _) => {
                if entry_usage_context != null && entry_usage_context.impl_functions.length > impl_index {
                    parent_usage_context = entry_usage_context;
                } else {
                    parent_usage_context = self.find_parent_usage_context_struct(struct_info, generic_map);
                }
                if parent_usage_context == null { return; }

                let impl_functions = parent_usage_context.impl_functions.get(impl_index);
                if impl_functions == null { return; }
                let func_usage = impl_functions.find(&func_ptr);
                if func_usage == null { self.usage_context = entry_usage_context; return; }
                let function_usage_context = func_usage.add_usage(generic_map);
                if func_info.generics.array.length > 0 || entry_usage_context == null {
                    self.usage_context = function_usage_context;
                } else {
                    self.usage_context = parent_usage_context;
                }
                self.function_context = &function_usage_context.function_context;
            },
            FunctionParent::Enum(enum_info, impl_index, _) => {
                if entry_usage_context != null && entry_usage_context.impl_functions.length > impl_index {
                    parent_usage_context = entry_usage_context;
                } else {
                    parent_usage_context = self.find_parent_usage_context_enum(enum_info, generic_map);
                }
                if parent_usage_context == null { return; }

                let impl_functions = parent_usage_context.impl_functions.get(impl_index);
                if impl_functions == null { return; }
                let func_usage = impl_functions.find(&func_ptr);
                if func_usage == null { self.usage_context = entry_usage_context; return; }
                let function_usage_context = func_usage.add_usage(generic_map);
                if func_info.generics.array.length > 0 || entry_usage_context == null {
                    self.usage_context = function_usage_context;
                } else {
                    self.usage_context = parent_usage_context;
                }
                self.function_context = &function_usage_context.function_context;
            },
            FunctionParent::Trait(_) => {
                parent_usage_context = entry_usage_context;
                if parent_usage_context == null { return; }

                let impl_index = self.active_impl_index;
                if parent_usage_context.impl_functions.length <= impl_index { impl_index = 0; }
                let impl_functions = parent_usage_context.impl_functions.get(impl_index);
                if impl_functions == null { return; }
                let func_usage = impl_functions.find(&func_ptr);
                if func_usage == null { self.usage_context = entry_usage_context; return; }
                let function_usage_context = func_usage.add_usage(generic_map);
                if func_info.generics.array.length > 0 || entry_usage_context == null {
                    self.usage_context = function_usage_context;
                } else {
                    self.usage_context = parent_usage_context;
                }
                self.function_context = &function_usage_context.function_context;
            },
            FunctionParent::Type(_, _, _) => {
                if entry_usage_context == null { return; }
                entry_usage_context.function_context = FunctionContext::new(self.allocator, func_info, false);
                self.function_context = &entry_usage_context.function_context;
                self.usage_context = entry_usage_context;
            },
        }

        let std_namespace = self.std_namespace;
        if std_namespace != null && func_info.type == FunctionType::Coroutine {
            let iter_trait = std_namespace.find_trait("Iter", 1);
            if iter_trait != null {
                let sequence_iter = self.root.make_type_usage(&Type::Trait(iter_trait, null), &Array<Type> { data: &func_info.return_type, length: 1, allocator: self.allocator, capacity: 0 });
                if sequence_iter != null {
                    self.add_type(sequence_iter, generic_map);
                }
            }
        }

        self.usage_mode = UsageMode::Signature;

        for param in func_info.parameters {
            self.add_type(&param.type, generic_map);
        }

        self.add_type(&func_info.return_type, generic_map);

        self.usage_mode = UsageMode::Body;

        self.process_block(func_info.body, generic_map);

        self.usage_context = entry_usage_context;
        self.function_context = null;
    }

    fn process_block(&self, block: *Block, generic_map: &GenericMap) {
        if block == null { return; }

        for statement_iter in block.statements {
            match statement_iter.data {
                StatementData::BlockStatement(child_block) => {
                    self.process_block(child_block, generic_map);
                },
                StatementData::LetStatement(statement) => {
                    if !statement.is_static {
                        let function_context = self.function_context;
                        if function_context == null { return; }
                        if statement.name != null {
                            function_context.add_variable(statement.name.value, statement.type);
                        }

                        for binding in statement.destructure {
                            function_context.add_variable(binding.name.value, binding.type);
                        }
                    }

                    self.add_type(statement.type, generic_map);

                    for binding in statement.destructure {
                        self.add_type(binding.type, generic_map);
                    }

                    if statement.value != null {
                        self.process_expression(statement.value, generic_map);
                    }
                },
                StatementData::ReturnStatement(statement) => {
                    if statement.expression != null {
                        self.process_expression(statement.expression, generic_map);
                    }
                },
                StatementData::YieldStatement(statement) => {
                    let function_context = self.function_context;
                    if function_context == null { return; }
                    function_context.coroutine.yield_count += 1;
                    self.process_expression(statement.expression, generic_map);
                },
                StatementData::IfStatement(statement) => {
                    self.process_expression(statement.expression, generic_map);
                    self.process_block(statement.block, generic_map);

                    for else_statement in statement.else_statements {
                        if else_statement.expression != null { self.process_expression(else_statement.expression, generic_map); }
                        self.process_block(else_statement.block, generic_map);
                    }
                },
                StatementData::MatchStatement(statement) => {
                    self.process_expression(statement.expression, generic_map);

                    for case_info in statement.cases {
                        self.process_block(case_info.body, generic_map);
                    }
                },
                StatementData::WhileStatement(statement) => {
                    self.process_expression(statement.expression, generic_map);
                    self.process_block(statement.block, generic_map);
                },
                StatementData::ForStatement(statement) => {
                    self.process_expression(statement.expression, generic_map);
                    self.add_type(statement.iter_type, generic_map);
                    if statement.value_type != null {
                        self.add_type(statement.value_type, generic_map);
                    }

                    match statement.type {
                        ForStatementType::Range(start, end) => {
                            let variable = &statement.variables.data[0];
                            let function_context = self.function_context;
                            if function_context == null { return; }
                            function_context.add_variable(variable.name.value, variable.type);
                            self.process_expression(start, generic_map);
                            self.process_expression(end, generic_map);
                        },
                        ForStatementType::Sequence(iter_expression) => {
                            self.process_expression(iter_expression, generic_map);
                        },
                        ForStatementType::Iter(iter_expression) => {
                            self.process_expression(iter_expression, generic_map);
                        },
                        ForStatementType::Error => {},
                    }

                    self.process_block(statement.block, generic_map);
                },
                StatementData::AssignmentStatement(statement) => {
                    self.process_expression(statement.left, generic_map);
                    self.process_expression(statement.right, generic_map);
                },
                StatementData::ExpressionStatement(statement) => {
                    self.process_expression(statement, generic_map);
                },
                StatementData::DeferStatement(defer_stmt) => {
                    match defer_stmt {
                        DeferStatement::Expression(expression) => {
                            self.process_expression(expression, generic_map);
                        },
                        DeferStatement::Block(block) => {
                            self.process_block(block, generic_map);
                        },
                    }
                },
                StatementData::ContinueStatement => {},
                StatementData::BreakStatement => {},
            }
        }
    }

    fn process_expression(&self, expression: &Expression, generic_map: &GenericMap) {
        self.add_type(&expression.return_type, generic_map);

        match expression.data {
            ExpressionData::EnumVariant(_) => {},
            ExpressionData::Invoke(target, arguments) => {
                self.process_expression(target, generic_map);
                for *arg in arguments {
                    self.process_expression(arg.value, generic_map);
                }

                match target.return_type {
                    Type::Function(func_info, _) => {
                        match func_info.parent {
                            FunctionParent::Trait(_) => {
                                if arguments.length > 0 {
                                    let func_name = func_info.name;
                                    let exact_usage_context = self.usage_context;
                                    if func_name != null && exact_usage_context != null {
                                        let exact_arg_type_resolved = Context::resolve_type(self.allocator, &arguments.data[0].value.return_type, generic_map, null);
                                        let exact_arg_type: &Type = &arguments.data[0].value.return_type;
                                        if exact_arg_type_resolved != null { exact_arg_type = exact_arg_type_resolved; }
                                        exact_arg_type = exact_arg_type.deref_reference();
                                        let type_impl_function = self.root.find_type_impl_function(exact_arg_type, func_name.value, null);
                                        if type_impl_function != null {
                                            self.add_type_impl_header(exact_arg_type);
                                        }
                                    }

                                    let type = arguments.data[0].value.return_type.deref();

                                    match type {
                                        Type::Generic(generic) => {
                                            let generic_name = generic.name;
                                            if generic_name == null { return; }
                                            let name = generic_name.value;
                                            let resolved_type = generic_map.get(name);
                                            if resolved_type != null { type = resolved_type; }
                                        },
                                        _ => {},
                                    }

                                    let allocator = self.allocator;
                                    let usage_context = self.usage_context;
                                    if usage_context == null { return; }

                                    match type {
                                        Type::Primitive(primitive_info) => {
                                            if primitive_info == null { return; }

                                            match self.usage_mode {
                                                UsageMode::Layout => { usage_context.layout.insert(primitive_info.name, *type); },
                                                UsageMode::Signature => { usage_context.signature.insert(primitive_info.name, *type); },
                                                UsageMode::Body => { usage_context.body.insert(primitive_info.name, *type); },
                                            }
                                        },
                                        Type::TypedefC(typedef_c) => {
                                            let primitive_info = allocator.store(&Primitive { name: typedef_c.name, traits: HashMap<str, &Trait> { allocator: self.allocator, buckets: null, data: null, capacity: 0, length: 0 }, impls: Array<&Impl> { allocator: self.allocator, data: null, length: 0, capacity: 0 } });
                                            if primitive_info == null { return; }

                                            match self.usage_mode {
                                                UsageMode::Layout => { usage_context.layout.insert(typedef_c.name, Type::Primitive(primitive_info)); },
                                                UsageMode::Signature => { usage_context.signature.insert(typedef_c.name, Type::Primitive(primitive_info)); },
                                                UsageMode::Body => { usage_context.body.insert(typedef_c.name, Type::Primitive(primitive_info)); },
                                            }
                                        },
                                        _ => {},
                                    }
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            },
            ExpressionData::Type(type) => { self.add_type(type, generic_map); },
            ExpressionData::Literal(_) => {},
            ExpressionData::NullLiteral => {},
            ExpressionData::Variable(_) => {},
            ExpressionData::UnaryExpression(_, inner) => {
                self.process_expression(inner, generic_map);
            },
            ExpressionData::BinaryExpression(left, _, right) => {
                self.process_expression(left, generic_map);
                self.process_expression(right, generic_map);
            },
            ExpressionData::MemberStaticExpression(inner, _) => {
                self.add_type(inner.return_type.deref(), generic_map);
                self.process_expression(inner, generic_map);
            },
            ExpressionData::MemberInstanceExpression(inner, _) => {
                self.add_type(inner.return_type.deref(), generic_map);
                self.process_expression(inner, generic_map);

                match expression.return_type {
                    Type::Function(func_info, _) => {
                        match func_info.parent {
                            FunctionParent::Type(_, _, _) => {
                                let resolved_self_type = Context::resolve_type(self.allocator, &inner.return_type, generic_map, null);
                                if resolved_self_type != null {
                                    self.add_type_impl_header(resolved_self_type);
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            },
            ExpressionData::IndexExpression(inner, index) => {
                self.process_expression(inner, generic_map);
                self.process_expression(index, generic_map);
            },
            ExpressionData::ParenthesizedExpression(inner) => {
                self.process_expression(inner, generic_map);
            },
            ExpressionData::IfExpression(cond, a, b) => {
                self.process_expression(cond, generic_map);
                self.process_expression(a, generic_map);
                self.process_expression(b, generic_map);
            },
            ExpressionData::OptionalExpression(_, value) => {
                self.process_expression(value, generic_map);
            },
            ExpressionData::CppExpression(cpp_expression) => {
                match cpp_expression {
                    CppExpression::New { placement, expression: new_expression } => {
                        if placement != null { self.process_expression(placement, generic_map); }
                        self.process_expression(new_expression, generic_map);
                    },
                    CppExpression::Delete(delete_expression) => {
                        self.process_expression(delete_expression, generic_map);
                    }
                }
            },
            ExpressionData::ImplicitCast(inner) => {
                self.process_expression(inner, generic_map);

                match expression.return_type {
                    Type::Indirect(target_indirect) => {
                        match target_indirect.to {
                            Type::Trait(target_trait, _) => {
                                let target_trait_name = target_trait.name;
                                if target_trait_name != null && target_trait_name.value.eq("Any") {
                                    let source = Context::resolve_type(self.allocator, &inner.return_type, generic_map, null);
                                    if source != null { self.mark_any_usage(source.deref_all()); }
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }

                match expression.return_type {
                    Type::Struct(struct_info, _) => {
                        let struct_name = struct_info.name;
                        let usage_context = self.usage_context;
                        if struct_name != null && struct_name.value.eq("str") {
                            if usage_context != null {
                                usage_context.primitive_code.insert("str");
                            }
                        }
                    },
                    _ => {},
                }

                let return_type_nullable = Context::resolve_type(self.allocator, &inner.return_type, generic_map, null);
                if return_type_nullable == null { return; }
                let return_type = return_type_nullable.deref();

                match return_type {
                    Type::Function(func_info, _) => {
                        let func_ptr = cast<usize>(func_info);

                        match func_info.parent {
                            FunctionParent::None => {
                                let usage = self.functions.find(&func_ptr);
                                if usage == null { return; }

                                if func_info.generics.array.length == 0 {
                                    usage.impl_dynamic_function = true;
                                }
                                for *uc in usage.usage_contexts {
                                    uc.impl_dynamic_function = true;
                                }
                            },
                            FunctionParent::Primitive(primitive_info, impl_index, _) => {
                                let parent_ptr = cast<usize>(primitive_info);
                                let parent_usage = self.primitives.find(&parent_ptr);
                                let marked = false;
                                if parent_usage != null {
                                    for *uc in parent_usage.usage_contexts {
                                        let usage_context_function = uc.impl_functions.get(impl_index);
                                        if usage_context_function == null { continue; }

                                        let impl_function = usage_context_function.find(&func_ptr);
                                        if impl_function != null {
                                            marked = true;
                                            if func_info.generics.array.length == 0 {
                                                impl_function.impl_dynamic_function = true;
                                            }
                                            for *func_uc in impl_function.usage_contexts {
                                                func_uc.impl_dynamic_function = true;
                                            }
                                        }
                                    }
                                }
                                if !marked { self.dynamic_impl_functions.insert(func_ptr); }
                            },
                            FunctionParent::Struct(struct_info, impl_index, _) => {
                                let parent_ptr = cast<usize>(struct_info);
                                let parent_usage = self.structs.find(&parent_ptr);
                                let marked = false;
                                if parent_usage != null {
                                    for *uc in parent_usage.usage_contexts {
                                        let usage_context_function = uc.impl_functions.get(impl_index);
                                        if usage_context_function == null { continue; }

                                        let impl_function = usage_context_function.find(&func_ptr);
                                        if impl_function != null {
                                            marked = true;
                                            if func_info.generics.array.length == 0 {
                                                impl_function.impl_dynamic_function = true;
                                            }
                                            for *func_uc in impl_function.usage_contexts {
                                                func_uc.impl_dynamic_function = true;
                                            }
                                        }
                                    }
                                }
                                if !marked { self.dynamic_impl_functions.insert(func_ptr); }
                            },
                            FunctionParent::Enum(enum_info, impl_index, _) => {
                                let parent_ptr = cast<usize>(enum_info);
                                let parent_usage = self.enums.find(&parent_ptr);
                                let marked = false;
                                if parent_usage != null {
                                    for *uc in parent_usage.usage_contexts {
                                        let usage_context_function = uc.impl_functions.get(impl_index);
                                        if usage_context_function == null { continue; }
                                        
                                        let impl_function = usage_context_function.find(&func_ptr);
                                        if impl_function != null {
                                            marked = true;
                                            if func_info.generics.array.length == 0 {
                                                impl_function.impl_dynamic_function = true;
                                            }
                                            for *func_uc in impl_function.usage_contexts {
                                                func_uc.impl_dynamic_function = true;
                                            }
                                        }
                                    }
                                }
                                if !marked { self.dynamic_impl_functions.insert(func_ptr); }
                            },
                            _ => {},
                        }
                    },
                    Type::Struct(struct_info, _) => {
                        match expression.return_type {
                            Type::Indirect(indirect) => {
                                match indirect.to {
                                    Type::Trait(trait_info, _) => {
                                        let name = trait_info.name;
                                        if name == null { return; }

                                        if name.value.eq("Struct") {
                                            let ptr = cast<usize>(struct_info);
                                            let usage = self.structs.find(&ptr);
                                            if usage == null { return; }
                                            usage.impl_dynamic_usage = true;
                                        }
                                    },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    },
                    Type::Enum(enum_info, _) => {
                        match expression.return_type {
                            Type::Indirect(indirect) => {
                                match indirect.to {
                                    Type::Trait(trait_info, _) => {
                                        let name = trait_info.name;
                                        if name == null { return; }

                                        if name.value.eq("Enum") {
                                            let ptr = cast<usize>(enum_info);
                                            let usage = self.enums.find(&ptr);
                                            if usage == null { return; }
                                            usage.impl_dynamic_usage = true;
                                        }
                                    },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            },
        }
    }

    fn normalize(&self) {
    }
}
