#include "stdio.h"

use std

struct DisplayI32 {
    value: i32,
}

fn append_i32(out: &dyn Writer, value: i32, info: str) {
    let allocator = GeneralPurposeAllocator::default();
    let buffer = String::new(allocator);
    let array: &Array<char> = &buffer.array;

    buffer.ensure_can_hold(20);
    if info.eq("x") || info.eq("hex") {
        array.length += snprintf(array.data + array.length, 20, "%x", value);
    } else {
        array.length += snprintf(array.data + array.length, 20, "%d", value);
    }
    array.data[array.length] = 0;

    out.write(buffer.as_str());
    buffer.release();
}

impl Format for DisplayI32 {
    fn format(&self, out: &dyn Writer, info: str) {
        append_i32(out, self.value, info);
    }
}

impl Format for str {
    fn format(&self, out: &dyn Writer, info: str) {
        out.write(*self);
    }
}

fn main(argc: i32, argv: **const char) -> i32 {
    let allocator = GeneralPurposeAllocator::default();
    let message = String::new(allocator);

    format(&message, "blah: {}", DisplayI32 { value: 1 });
    printf("%.*s\n", message.len_i32(), message.c_str());
    message.clear();

    format(&message, "{} + {} = {hex}", DisplayI32 { value: 1 }, DisplayI32 { value: 2 }, DisplayI32 { value: 3 });
    printf("%.*s\n", message.len_i32(), message.c_str());
    message.clear();

    let escaped: str = "escaped";
    format(&message, "{{ {} }}", escaped);
    printf("%.*s\n", message.len_i32(), message.c_str());
    message.release();

    return 0;
}
