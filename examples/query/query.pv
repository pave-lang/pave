#include "assert.h"
#include "stdio.h"

use std

struct Position {}
struct Velocity {}

struct Query {
    flags: u32,
}

impl Query {
    fn add_flag<T>(self) -> Query<T> {
        return Query<T> { flags: self.flags | 1 };
    }

    co run(&self) -> u32 {
        yield self.flags;
    }
}

struct Query<T> {
    flags: u32,
}

impl<T> Query<T> {
    co run(&self) -> (u32, *T) {
        yield (self.flags, null);
    }
}

fn main(argc: i32, argv: **const char) -> i32 {
    let base = Query { flags: 0 };
    let positions = base.add_flag<Position>();

    for (flags, pos) in positions.run() {
            printf("flags: %u\n", flags);
    }

    assert(positions.flags == 1);

    printf("query flags: %u\n", positions.flags);

    let velocities = base.add_flag<Velocity>();

    for (flags, vel) in velocities.run() {
        printf("flags: %u\n", flags);
    }

    assert(velocities.flags == 1);

    printf("query flags: %u\n", velocities.flags);

    return 0;
}
