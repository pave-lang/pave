#include "assert.h"
#include "stdio.h"

use std

struct Position {
    value: i32,
}

struct Velocity {
    value: i32,
}

struct Query<T> {
    value: i32,
}

fn make_ref_query() -> Query<&Position> {
    return Query<&Position> { value: 42 };
}

fn make_ptr_query() -> Query<*Position> {
    return Query<*Position> { value: 84 };
}

struct Wrapper<T> {
    value: T,
}

fn wrap_ref<T>(value: &T) -> Wrapper<&T> {
    return Wrapper<&T> { value };
}

struct Pair<T1, T2> {
    a: T1,
    b: T2,
}

fn add_ref<T1>(a: T1, v: &Velocity) -> Pair<T1, &Velocity> {
    return Pair<T1, &Velocity> { a, b: v };
}

fn main(argc: i32, argv: **const char) -> i32 {
    let refs = make_ref_query();
    let ptrs = make_ptr_query();

    assert(refs.value == 42);
    assert(ptrs.value == 84);

    printf("refs: %d\n", refs.value);
    printf("ptrs: %d\n", ptrs.value);

    let pos = Position { value: 7 };
    let wrapped = wrap_ref<Position>(&pos);
    assert(wrapped.value.value == 7);
    printf("wrapped: %d\n", wrapped.value.value);

    let vel = Velocity { value: 5 };
    let pair = add_ref<i32>(9, &vel);
    assert(pair.a == 9);
    assert(pair.b.value == 5);
    printf("pair: %d\n", pair.a);

    return 0;
}
